/*
 * Cancellable timer: public API on TimerController; delay runs on TimerHelper so
 * cancelTimer can killSessionPeer(TimerHelper) without blocking the controller.
 */
proc TimerController {
    const LARGE_WRAP_AROUND : Int
    var currentId : Int
    var timing : Boolean
    var start : Boolean
    var timeDuration : Int
    var ringTimeout : Boolean

    session constructor createTimer() {
        transit:
            LARGE_WRAP_AROUND := 999999
            currentId := 0
            timing := false
            start := false
            timeDuration := 0
            ringTimeout := false
    }

    session transition startTimer(time : Int) {
        guard:
            ~timing
        transit:
            start := true
            timeDuration := time
    }

    session transition timeout() {
        guard:
            ringTimeout
        transit:
            timing := false
            start := false
            timeDuration := 0
            ringTimeout := false
    }

    session transition cancelTimer() {
        guard:
            timing
        transit:
            currentId := (currentId + 1) % LARGE_WRAP_AROUND
            timing := false
            start := false
            timeDuration := 0
            ringTimeout := false
        effect:
            killSessionPeer(TimerHelper)
    }

    session transition timerHelperStart(id : Int, time : Int) {
        guard:
            & ~timing
            & start
            & id = currentId
            & time = timeDuration
        transit:
            timing := true
            start := false
    }

    session transition timerHelperEnd(id : Int) {
        guard:
            timing
        transit:
            ringTimeout := (id = currentId)
        effect:
            exitSession(TimerHelper)
    }
}

proc TimerHelper {
    var timerId : Int
    var done : Boolean

    session constructor timerHelperStart(id : Int, time : Int) {
        transit:
            timerId := id
            done := false
        effect:
            delaySeconds(time)
    }

    session transition timerHelperEnd(id : Int) {
        guard:
            & ~done
            & id = timerId
        transit:
            done := true
    }
}

proc Timer := TimerController || TimerHelper

sort Ctrl := {"c1", "c2", "c3"}
sort Help := {"h1", "h2", "h3"}
spec TimerSpec := TimerController[c : Ctrl] || TimerHelper[h : Help]
