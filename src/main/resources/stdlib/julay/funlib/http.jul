import julay.funlib.doHttpRequest

/*
 * Outbound HTTP as a child: nest under the parent with `Parent || HttpRequest`
 * (parenthood inferred from httpRequest ctor / httpResponse return sync).
 */
export proc HttpRequest {
    var request : HttpClientRequest
    var response : HttpClientResponse
    var done : Boolean

    constructor httpRequest(req : HttpClientRequest) {
        transit:
            request := req
            response := HttpClientResponse { code := 0, body := "" }
            done := false
    }

    internal transition perform() {
        guard: ~done
        transit:
            response := doHttpRequest(request)
            done := true
    }

    return httpResponse(resp : HttpClientResponse) {
        guard: done & resp = response
    }
}
