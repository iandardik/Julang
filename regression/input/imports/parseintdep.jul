import julay.funlib.parseInt
import julay.funlib.exitProcess
import julay.funlib.println

proc ParseIntDep {
    var n : Int
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            n := if (true) {
                parseInt(args[0])
            } else {
                0
            }
            print := true
    }

    internal transition println(msg : String) {
        guard:
            print & (msg = n + "")
        transit:
            print := false
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            ~print & n = 7
        after:
            exitProcess()
    }
}

export proc ParseIntDepProc := ParseIntDep
