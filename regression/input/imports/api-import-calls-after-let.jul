import julay.funlib.exitProgram
import julay.funlib.println
import api_calls_provider.HelperApi

proc Main {
    var out : Int
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            // Prior transit let forces substituteExpr on later RHSs — must preserve
            // Api.fn resolution on MethodCallExprNode copies.
            let flag : Boolean := true
            out := if (flag) HelperApi.helper(1) else 0
            done := false
    }

    internal transition finish() {
        guard: ~done
        transit: done := true
        after:
            println(out + "")
            exitProgram(0)
    }
}

proc System := Main || HelperApi

compile System
