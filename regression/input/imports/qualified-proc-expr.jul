import julay.funlib.setTimer
import julay.funlib.exitProgram
import julay.funlib.println

/*
 * Former Timer proclib composition test — rewritten for timer builtins.
 */
static proc Driver {
    var step : String

    constructor initially(args : List<String>) {
        transit: step := "wait"
        after:
            setTimer("timeout", 50)
    }

    timer transition timeout() {
        guard: step = "wait"
        transit: step := "print"
    }

    internal transition println(msg : String) {
        guard: step = "print" & msg = "ok"
        transit: step := "done"
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard: step = "done"
        after:
            exitProgram(0)
    }
}

proc QualifiedProcExprTest := Driver

compile QualifiedProcExprTest
