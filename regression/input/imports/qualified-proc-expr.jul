proc S {
    var x : Int

    constructor initially(args : List<String>) {
        transit: x := 0
    }

    transition println(msg : String) {
        guard:
            x < 2 & msg = x + ""
        transit:
            x := x + 1
    }

    transition exitSystem() {
        guard: x >= 2
    }
}

proc QualifiedProcExprTest := S || julaylib.pclass.Println || julaylib.pclass.ExitSystem

compile QualifiedProcExprTest
