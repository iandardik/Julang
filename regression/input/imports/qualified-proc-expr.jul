import julay.funlib.exitProcess
import julay.funlib.println

proc Driver {
    var step : String

    constructor initially(args : List<String>) {
        transit: step := "create"
    }

    session transition createTimer() {
        guard: step = "create"
        transit: step := "start"
    }

    session transition startTimer(time : Int) {
        guard: step = "start" & time = 1
        transit: step := "wait"
    }

    session transition timeout() {
        guard: step = "wait"
        transit: step := "print"
    }

    session transition cancelTimer() {
        guard: false
    }

    internal transition println(msg : String) {
        guard: step = "print" & msg = "ok"
        transit: step := "done"
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard: step = "done"
        after:
            exitProcess()
    }
}

proc QualifiedProcExprTest := Driver || julay.proclib.Timer

compile QualifiedProcExprTest
