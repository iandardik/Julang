import julay.funlib.println
import julay.funlib.exitProcess

proc S {
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            done := false
    }

    internal transition go() {
        guard: ~done
        after:
            println("ok")
        transit:
            done := true
    }

    internal transition exitSystem() {
        guard: done
        after:
            exitProcess()
    }
}

proc P := S

compile P
