import julaylib.pclass.Println
import julaylib.pclass.Println

proc S {
    var x : Int

    constructor initially(args : List<String>) {
        transit: x := 0
    }

    transition println(msg : String) {
        guard: msg = x + ""
    }
}

proc ImportDuplicateTest := S || Println

compile ImportDuplicateTest
