import julay.proclib.ExitSystem
import julay.funlib.length

proc SetEmptyDemo {
    var s : Set<Int>
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            s := {}
            done := false
    }

    internal transition check() {
        guard:
            ~done
        transit:
            done := length(s) = 0
    }

    transition exitSystem() {
        guard:
            done
    }
}

proc SetEmptyTest := SetEmptyDemo || ExitSystem

compile SetEmptyTest
