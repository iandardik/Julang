import julaylib.pclass.ExitSystem
import julaylib.fun.length

p-class SetEmptyDemo {
    var s : Set<Int>
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            s := {}
            done := false
    }

    internal transition check() {
        guard:
            ~done
        transit:
            done := length(s) = 0
    }

    transition exitSystem() {
        guard:
            done
    }
}

program SetEmptyTest := SetEmptyDemo || ExitSystem
