import julay.funlib.length
import julay.funlib.exitProcess

proc SetEmptyDemo {
    var s : Set<Int>
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            s := {}
            done := false
    }

    internal transition check() {
        guard:
            ~done
        transit:
            done := length(s) = 0
    }

    internal transition exitSystem() {
        guard:
            done
        after:
            exitProcess()
    }
}

proc SetEmptyTest := SetEmptyDemo

compile SetEmptyTest
