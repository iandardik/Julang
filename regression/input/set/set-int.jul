import julay.proclib.Println
import julay.proclib.ExitSystem
import julay.funlib.length

proc SetIntDemo {
    var s : Set<Int>
    var n : Int
    var print : Boolean
    var gotCli : Boolean

    constructor initially(args : List<String>) {
        transit:
            s := {1, 2}
            n := 0
            print := false
            gotCli := length(args) = 1
        after:
            println(args[0])
    }

    internal transition step() {
        guard:
            ~print & length(s) = 2 & gotCli & 1 in s & ~(3 in s)
        transit:
            s := s + {3}
            n := length(s) + 1
            print := true
    }

    internal transition step2() {
        guard:
            print & n = 3 & 3 in s
        transit:
            s := s - {1}
            n := length(s) - 1
            print := false
    }

    transition println(msg : String) {
        guard:
            ~print & (msg = n + "")
        transit:
            print := true
    }

    transition exitSystem() {
        guard:
            print & n = 2 & s = {2, 3}
    }
}

proc SetIntTest := SetIntDemo || Println || ExitSystem

compile SetIntTest
