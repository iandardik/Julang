import julay.funlib.length
import julay.funlib.println
import julay.funlib.exitProcess
import julay.funlib.setOf

proc SetIntDemo {
    var s : Set<Int>
    var n : Int
    var print : Boolean
    var gotCli : Boolean

    constructor initially(args : List<String>) {
        transit:
            s := setOf(1, 2)
            n := 0
            print := false
            gotCli := length(args) = 1
        after:
            println(args[0])
    }

    internal transition step() {
        guard:
            ~print & length(s) = 2 & gotCli & 1 in s & ~(3 in s)
        transit:
            s := s + setOf(3)
            n := length(s) + 1
            print := true
    }

    internal transition step2() {
        guard:
            print & n = 3 & 3 in s
        transit:
            s := s - setOf(1)
            n := length(s) - 1
            print := false
    }

    internal transition println(msg : String) {
        guard:
            ~print & n = 2 & (msg = n + "")
        transit:
            print := true
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            print & n = 2 & s = setOf(2, 3)
        after:
            exitProcess()
    }
}

proc SetIntTest := SetIntDemo

compile SetIntTest
