import julay.proclib.HttpServer
import julay.funlib.delaySeconds
import julay.funlib.println

proc Counter {
    var counter : Int
    
    constructor initially(args : List<String>) {
        transit: counter := 0
    }

    provider transition increment() {
        transit: counter := counter + 1
    }

    provider transition getCounter(counterVal : Int) {
        guard: counterVal = counter
    }
}

/* prints the current value of the counter every 5 seconds
*/
proc PeriodicPrint {
    var localCounter : Int
    var step : String

    constructor initially(args : List<String>) {
        transit:
            localCounter := -1
            step := "A"
    }

    client transition getCounter(counterVal : Int) {
        guard:
            step = "A"
        transit:
            localCounter := counterVal
            step := "B"
    }

    internal transition println(msg : String) {
        guard:   step = "B" & (msg = localCounter + "")
        transit: step := "C"
        after:
            println(msg)
    }

    internal transition wait() {
        guard:   step = "C"
        transit: step := "A"
        after:  delaySeconds(5)
    }
}

proc ServerStarter {
    var started : Boolean

    constructor initially(args : List<String>) {
        transit:
            started := false
    }

    session transition listen(
        port : Int,
        handler : HttpServerRequest ~> HttpServerResponse
    ) {
        guard: ~started & port = 8000 & handler = incHandler
        transit: started := true
    }

    session transition close() {
        guard: false
    }
}

procfun incHandler(req : HttpServerRequest) : HttpServerResponse {
    var localCounter : Int := -1
    var step : String := "A"
    var exit : Boolean := (req.body = "exit")

    client transition increment() {
        guard:   step = "A"
        transit: step := "B"
    }

    client transition getCounter(counterVal : Int) {
        guard: step = "B"
        transit:
            localCounter := counterVal
            step := "C"
    }

    internal transition respond() {
        guard: step = "C" & ~exit
        return: HttpServerResponse {
            body := localCounter + "",
            code := 200
        }
    }

    internal transition respondAndExit() {
        guard: step = "C" & exit
        return: HttpServerResponse {
            body := localCounter + "",
            code := 200
        }
    }
}

proc Printer := PeriodicPrint
proc ServerLogic := ServerStarter || HttpServer
proc CounterServerTest := Counter || Printer || ServerLogic

compile CounterServerTest
