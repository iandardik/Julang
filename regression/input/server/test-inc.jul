import julay.proclib.Println
import julay.proclib.HttpServer
import julay.proclib.ExitSystem
import julay.funlib.delaySeconds

proc Counter {
    var counter : Int
    
    constructor initially(args : List<String>) {
        transit: counter := 0
    }

    service transition increment() {
        transit: counter := counter + 1
    }

    service transition getCounter(counterVal : Int) {
        guard: counterVal = counter
    }
}

/* prints the current value of the counter every 5 seconds
*/
proc PeriodicPrint {
    var localCounter : Int
    var step : String

    constructor initially(args : List<String>) {
        transit:
            localCounter := -1
            step := "A"
    }

    transition getCounter(counterVal : Int) {
        guard:
            step = "A"
        transit:
            localCounter := counterVal
            step := "B"
    }

    transition println(msg : String) {
        guard:   step = "B" & (msg = localCounter + "")
        transit: step := "C"
    }

    internal transition wait() {
        guard:   step = "C"
        transit: step := "A"
        after:  delaySeconds(5)
    }
}

proc ServerStarter {
    var started : Boolean

    constructor initially(args : List<String>) {
        transit:
            started := false
    }

    session transition createHttpServer(port : Int) {
        guard: ~started & port = 8000
        transit: started := true
    }

    session transition closeHttpServer() {
        guard: false
    }
}

proc IncReqHandler {
    var httpReq : HttpServerRequest
    var localCounter : Int
    var step : String
    var exit : Boolean

    session constructor receiveRequest(req : HttpServerRequest) {
        transit:
            httpReq := req
            localCounter := -1 // TODO the reverse order causes a compiler bug
            step := "A"
            exit := (req.body = "exit")
    }

    transition increment() {
        guard:   step = "A"
        transit: step := "B"
    }

    transition getCounter(counterVal : Int) {
        guard: step = "B"
        transit:
            localCounter := counterVal
            step := "C"
    }

    session transition sendResponse(resp : HttpServerResponse) {
        guard:
            & step = "C"
            & resp = HttpServerResponse {
                body := localCounter + "",
                code := 200
            }
        transit:
            step := "D"
    }

    transition exitSystem() {
        guard: exit & (step = "D")
    }
}

proc Printer := PeriodicPrint || Println
proc ServerLogic := ServerStarter || IncReqHandler || HttpServer || ExitSystem
proc CounterServerTest := Counter || Printer || ServerLogic

compile CounterServerTest
