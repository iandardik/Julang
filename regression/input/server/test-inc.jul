import julay.proclib.HttpServer
import julay.funlib.delaySeconds
import julay.funlib.exitProcess
import julay.funlib.println

proc Counter {
    var counter : Int
    
    constructor initially(args : List<String>) {
        transit: counter := 0
    }

    provider transition increment() {
        transit: counter := counter + 1
    }

    provider transition getCounter(counterVal : Int) {
        guard: counterVal = counter
    }
}

/* prints the current value of the counter every 5 seconds
*/
proc PeriodicPrint {
    var localCounter : Int
    var step : String

    constructor initially(args : List<String>) {
        transit:
            localCounter := -1
            step := "A"
    }

    client transition getCounter(counterVal : Int) {
        guard:
            step = "A"
        transit:
            localCounter := counterVal
            step := "B"
    }

    internal transition println(msg : String) {
        guard:   step = "B" & (msg = localCounter + "")
        transit: step := "C"
        after:
            println(msg)
    }

    internal transition wait() {
        guard:   step = "C"
        transit: step := "A"
        after:  delaySeconds(5)
    }
}

proc ServerStarter {
    var started : Boolean

    constructor initially(args : List<String>) {
        transit:
            started := false
    }

    session transition createHttpServer(port : Int) {
        guard: ~started & port = 8000
        transit: started := true
    }

    session transition closeHttpServer() {
        guard: false
    }
}

proc IncReqHandler {
    var httpReq : HttpServerRequest
    var localCounter : Int
    var step : String
    var exit : Boolean

    session constructor receiveRequest(req : HttpServerRequest) {
        transit:
            httpReq := req
            localCounter := -1 // TODO the reverse order causes a compiler bug
            step := "A"
            exit := (req.body = "exit")
    }

    client transition increment() {
        guard:   step = "A"
        transit: step := "B"
    }

    client transition getCounter(counterVal : Int) {
        guard: step = "B"
        transit:
            localCounter := counterVal
            step := "C"
    }

    session transition sendResponse(resp : HttpServerResponse) {
        guard:
            & step = "C"
            & resp = HttpServerResponse {
                body := localCounter + "",
                code := 200
            }
        transit:
            step := "D"
    }

    internal transition exitSystem() {
        guard: exit & (step = "D")
        after:
            exitProcess()
    }
}

proc Printer := PeriodicPrint
proc ServerLogic := ServerStarter || IncReqHandler || HttpServer
proc CounterServerTest := Counter || Printer || ServerLogic

compile CounterServerTest
