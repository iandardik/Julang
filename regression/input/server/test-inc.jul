import julaylib.pclass.Println
import julaylib.pclass.Timer
import julaylib.pclass.HttpServer
import julaylib.pclass.ExitSystem

p-class Counter {
    var counter : Int
    
    constructor initially(args : List String) {
        transit: counter := 0
    }

    p2p-service transition increment() {
        transit: counter := counter + 1
    }

    p2p-service transition getCounter(counterVal : Int) {
        guard: counterVal = counter
    }

    p2p-consumer transition close() {
        guard: false // never close the server
    }
}

/* prints the current value of the counter every 5 seconds
*/
p-class PeriodicPrint {
    var localCounter : Int
    var step : String

    constructor initially(args : List String) {
        transit:
            localCounter := -1
            step := "A"
    }

    constructor timeout() {
        transit:
            localCounter := -1
            step := "A"
    }

    p2p-consumer transition getCounter(counterVal : Int) {
        guard:
            step = "A"
        transit:
            localCounter := counterVal
            step := "B"
    }

    p2p-consumer transition println(msg : String) {
        guard:   step = "B" & (msg = localCounter + "")
        transit: step := "C"
    }

    transition timer(time : Int) {
        guard:   step = "C" & time = 5 // seconds
        transit: step := "D"
    }
}

p-class ServerStarter {
    var started : Boolean

    constructor initially(args : List String) {
        transit: started := false
    }

    transition startServer(port : Int) {
        guard: ~started & port = 8000
        transit: started := true
    }
}

p-class IncReqHandler {
    var localCounter : Int
    var step : String
    var exit : Boolean

    constructor receiveRequest(req : HttpServerRequest) {
        transit:
            localCounter := -1 // TODO the reverse order causes a compiler bug
            step := "A"
            exit := (req.body = "exit")
    }

    p2p-consumer transition increment() {
        guard:   step = "A"
        transit: step := "B"
    }

    p2p-consumer transition getCounter(counterVal : Int) {
        guard: step = "B"
        transit:
            localCounter := counterVal
            step := "C"
    }

    transition sendResponse(resp : HttpServerResponse) {
        guard:
            step = "C" & resp = HttpServerResponse {
                body := localCounter + "",
                code := 200
            }
        transit:
            step := "D"
    }

    p2p-consumer transition exitSystem() {
        guard: exit & (step = "D")
    }
}

proc Printer := PeriodicPrint || Println || Timer
proc ServerLogic := ServerStarter || IncReqHandler || HttpServer || ExitSystem
program CounterServerTest := Counter || Printer || ServerLogic
