import julaylib.pclass.Println
import julaylib.pclass.Timer
import julaylib.pclass.HttpServer
import julaylib.pclass.ExitSystem
import julaylib.fun.createEmptyChannel
import julaylib.fun.createChannel

p-class Counter {
    var counter : Int
    
    constructor initially(args : List<String>) {
        transit: counter := 0
    }

    service transition increment() {
        transit: counter := counter + 1
    }

    service transition getCounter(counterVal : Int) {
        guard: counterVal = counter
    }
}

/* prints the current value of the counter every 5 seconds
*/
p-class PeriodicPrint {
    var localCounter : Int
    var step : String

    constructor initially(args : List<String>) {
        transit:
            localCounter := -1
            step := "A"
    }

    constructor timeout() {
        transit:
            localCounter := -1
            step := "A"
    }

    transition getCounter(counterVal : Int) {
        guard:
            step = "A"
        transit:
            localCounter := counterVal
            step := "B"
    }

    transition println(msg : String) {
        guard:   step = "B" & (msg = localCounter + "")
        transit: step := "C"
    }

    transition timer(time : Int) {
        guard:   step = "C" & time = 5 // seconds
        transit: step := "D"
    }
}

p-class ServerStarter {
    var started : Boolean
    var myCloseChan : Channel<closeHttpServer>

    constructor initially(args : List<String>) {
        transit:
            started := false
            myCloseChan := createEmptyChannel<closeHttpServer>()
    }

    internal transition allocCloseChan() {
        guard: ~started & myCloseChan = createEmptyChannel<closeHttpServer>()
        transit: myCloseChan := createChannel<closeHttpServer>()
    }

    transition createHttpServer(port : Int, closeChan : Channel<closeHttpServer>) {
        guard: ~started & port = 8000 & closeChan = myCloseChan
            & myCloseChan ~= createEmptyChannel<closeHttpServer>()
        transit: started := true
    }

    transition closeHttpServer<myCloseChan>() {
        guard: false
    }
}

p-class IncReqHandler {
    var httpReq : HttpServerRequest
    var httpChan : Channel<sendResponse>
    var localCounter : Int
    var step : String
    var exit : Boolean

    constructor receiveRequest(req : HttpServerRequest, httpChan : Channel<sendResponse>) {
        transit:
            httpReq := req
            httpChan := httpChan
            localCounter := -1 // TODO the reverse order causes a compiler bug
            step := "A"
            exit := (req.body = "exit")
    }

    transition increment() {
        guard:   step = "A"
        transit: step := "B"
    }

    transition getCounter(counterVal : Int) {
        guard: step = "B"
        transit:
            localCounter := counterVal
            step := "C"
    }

    transition sendResponse<httpChan>(resp : HttpServerResponse) {
        guard:
            & step = "C"
            & resp = HttpServerResponse {
                body := localCounter + "",
                code := 200
            }
        transit:
            step := "D"
    }

    transition exitSystem() {
        guard: exit & (step = "D")
    }
}

proc Printer := PeriodicPrint || Println || Timer
proc ServerLogic := ServerStarter || IncReqHandler || HttpServer || ExitSystem
program CounterServerTest := Counter || Printer || ServerLogic
