import julay.funlib.exitProgram
import julay.funlib.println

procfun countUp(n : Int) : Int {
    var i : Int := 0
    var result : Int := 0

    internal transition step() {
        guard: i < n
        transit:
            result := i + 1
            i := i + 1
    }

    internal transition done() {
        guard: i = n
        return: result
    }
}

proc Main {
    var out : Int
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            out := countUp(3)
            done := false
    }

    internal transition finish() {
        guard: ~done
        transit: done := true
        after:
            println(out + "")
            exitProgram(0)
    }
}

compile Main
