import julay.funlib.exitProgram

obj Box<T> {
    value : T
}

obj Pair<A, B> {
    left : A
    right : B
}

proc Worker {
    var box : Box<Int>
    var nested : Box<Box<Int>>
    var pair : Pair<Int, Boolean>
    var steps : Int

    constructor initially(args : List<String>) {
        transit:
            steps := 0
            box := Box<Int> { value := 7 }
            nested := Box<Box<Int>> { value := Box<Int> { value := 3 } }
            pair := Pair<Int, Boolean> { left := 1, right := true }
    }

    internal transition checkBox() {
        guard:
            steps = 0 & box.value = 7
        transit:
            steps := 1
    }

    internal transition checkNested() {
        guard:
            steps = 1 & nested.value.value = 3
        transit:
            steps := 2
    }

    internal transition checkPair() {
        guard:
            steps = 2 & pair.left = 1 & pair.right
        transit:
            steps := 3
    }

    internal transition exitSystem() {
        guard:
            steps = 3
        after:
            exitProgram(0)
    }
}

proc PolyBoxPairTest := Worker

compile PolyBoxPairTest
