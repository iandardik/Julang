import julaylib.ExitSystem

o-class Box<T> {
    value : T
}

o-class Pair<A, B> {
    left : A
    right : B
}

p-class Worker {
    var box : Box Int
    var nested : Box (Box Int)
    var pair : Pair Int Boolean
    var steps : Int

    constructor initially() {
        transit:
            steps := 0
            box := Box Int { value := 7 }
            nested := Box (Box Int) { value := Box Int { value := 3 } }
            pair := Pair Int Boolean { left := 1, right := true }
    }

    transition checkBox() {
        guard:
            steps = 0 & box.value = 7
        transit:
            steps := 1
    }

    transition checkNested() {
        guard:
            steps = 1 & nested.value.value = 3
        transit:
            steps := 2
    }

    transition checkPair() {
        guard:
            steps = 2 & pair.left = 1 & pair.right
        transit:
            steps := 3
    }

    p2p-consumer transition exitSystem() {
        guard:
            steps = 3
    }
}

program PolyBoxPairTest := Worker || ExitSystem
