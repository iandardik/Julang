type Ids

static proc Cluster {
    const cluster : Set<Int>

    constructor initially(cluster : Set<Int>) {
        transit:
            cluster := cluster
    }
}

static proc Box {
    var nextIndex : Map<Int, Int>
    var n : Int

    constructor start(cluster : Set<Int>) {
        transit:
            nextIndex := cluster.associateWith(x -> 1)
            n := 0
    }

    transition bump() {
        guard: 1 in nextIndex & nextIndex[1] = 1
        transit: n := n + 1
    }
}

spec AssocMap := (Box[i : Ids] || Cluster) {
    Ids := { "a", "b" }
    init: Cluster.cluster.length = Ids.length
    init: forall i : Int, (i >= 1 & i <= Cluster.cluster.length) => i in Cluster.cluster
    unsynced bump, start
}

compile AssocMap
