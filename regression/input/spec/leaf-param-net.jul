type Node

spec Net[n : Node] {
    Node := { "n1", "n2" }
    var lastDest : String := ""

    constructor initially(args : List<String>) {}

    transition send() {
        guard: lastDest ~= "unused"
        transit:
            lastDest := n
    }
}

proc Peer {
    var ack : Boolean := false

    constructor initially(args : List<String>) {
        transit: ack := false
    }

    transition send() {
        transit: ack := true
    }
}

spec LeafParamNet := <true> Net || Peer <true>

compile LeafParamNet
