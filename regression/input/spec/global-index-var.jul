type Node

proc Peer {
    const cluster : List<String>
    var extra : Int
    var state : String

    constructor start(me : String, cluster : List<String>) {
        transit:
            cluster := cluster
            extra := 0
            state := "idle"
        error:
            (me ~in cluster) -> "not in cluster"
    }

    internal transition bump() {
        guard:
            extra < 3 & cluster.length >= 0 & state ~= ""
        transit:
            extra := extra + 1
            state := "busy"
    }
}

invariant All := forall i : Node,
    Peer[i].extra >= 0 & (Peer[i].state = "busy" | Peer[i].state = "idle") & Peer[i].cluster = Peer[i].cluster

spec Indexed := Peer[n : Node] {
    Node := {"n1", "n2"}
  const global cluster
  global extra
} |= All

compile Indexed
