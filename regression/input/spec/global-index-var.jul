type Node

static proc Cluster {
    const cluster : List<String>

    constructor initially(cluster : List<String>) {
        transit:
            cluster := cluster
    }
}

static proc Peer {
    var extra : Int
    var state : String

    constructor start(me : String) {
        transit:
            extra := 0
            state := "idle"
    }

    internal transition bump() {
        guard:
            extra < 3 & state ~= ""
        transit:
            extra := extra + 1
            state := "busy"
    }
}

invariant All := forall i : Node,
    Peer[i].extra >= 0 & (Peer[i].state = "busy" | Peer[i].state = "idle") &
    Cluster.cluster = Cluster.cluster

spec Indexed := (Peer[n : Node] || Cluster) |= All {
    Node := {"n1", "n2"}
    init: Cluster.cluster.length = Node.length
    unsynced start
}

compile Indexed
