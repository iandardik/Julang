import julay.funlib.listOf

type Node

proc Peer {
    const cluster : List<String>
    var state : String

    constructor start(me : String) {
        transit:
            cluster := listOf("a")
            state := "idle"
        error:
            (me ~in cluster) -> "not in cluster"
    }
}

spec ConstCheck := Peer[n : Node] {
    Node := {"n1"}
  const global cluster
}

compile ConstCheck
