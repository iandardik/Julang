import julay.funlib.listOf

type Node

static proc Cluster {
    const cluster : List<String>

    constructor initially(me : String) {
        transit:
            cluster := listOf("a")
        error:
            (me ~in cluster) -> "not in cluster"
    }
}

static proc Peer {
    var state : String

    constructor start(me : String) {
        transit:
            state := "idle"
    }
}

spec ConstCheck := (Peer[n : Node] || Cluster) {
    Node := {"n1"}
    init: Cluster.cluster.length = Node.length
    unsynced start
}

compile ConstCheck
