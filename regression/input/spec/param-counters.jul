proc Counter {
    var n : Int

    constructor initially(args : List<String>) {
        transit: n := 0
    }

    transition bump() {
        guard: n < 3
        transit: n := n + 1
    }
}

invariant G := all i : String, Counter[i].n <= 3

spec ParamCounters := <true> Counter[i : String] <G>

compile ParamCounters
