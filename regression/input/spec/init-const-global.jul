type Node

static proc Cluster {
    const cluster : List<String>

    constructor initially(cluster : List<String>) {
        transit:
            cluster := cluster
    }
}

static proc Peer {
    var state : String

    constructor start(me : String) {
        transit:
            state := "idle"
    }
}

spec Indexed := (Peer[n : Node] || Cluster) {
    Node := {"n1", "n2"}
    init: Cluster.cluster.length = Node.length
    unsynced start
}

compile Indexed
