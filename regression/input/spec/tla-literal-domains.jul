proc Modes {
    var payload : String
    var step : Int

    constructor initially(args : List<String>) {
        transit:
            payload := "seed"
            step := 0
    }

    transition go(mode : String, note : String) {
        guard: mode = "a" | mode = "b"
        transit:
            payload := note
            step := step + 1
    }
}

invariant Keep := Modes.step >= 0 & Modes.payload ~= ""

spec LiteralDomains := Modes |= Keep

compile LiteralDomains
