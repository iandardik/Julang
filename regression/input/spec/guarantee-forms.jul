proc Counter {
    var n : Int

    constructor initially(args : List<String>) {
        transit: n := 0
    }

    transition bump() {
        guard: n < 3
        transit: n := n + 1
    }
}

invariant Bound := Counter.n >= 0

spec PlainCounter := Counter
spec ModelsBound := Counter |= Bound
spec TrueGuarantee := <true> Counter <true>
spec InlineGuarantee := Counter |= Counter.n >= 0

compile PlainCounter, ModelsBound, TrueGuarantee, InlineGuarantee
