sort NodeSet := {"a", "b"}

proc Worker {
    var log : List<String>
    constructor initially(args : List<String>) { transit: log := args }
}

invariant SameLog := forall n1 : NodeSet, forall n2 : NodeSet, forall i : Int,
    (i >= 1 & i <= Worker[n1].log.length & i <= Worker[n2].log.length) => (Worker[n1].log[i] = Worker[n2].log[i])

spec ListIndexInv := Worker[n : NodeSet] |= SameLog

compile ListIndexInv
