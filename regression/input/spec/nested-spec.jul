p-class Counter {
    var n : Int

    constructor initially(args : List<String>) {
        transit: n := 0
    }

    transition bump() {
        guard: n < 3
        transit: n := n + 1
    }
}

p-class Handler {
    var step : String

    constructor initially(args : List<String>) {
        transit: step := "A"
    }

    transition work() {
        guard: step = "A"
        transit: step := "B"
    }
}

invariant Bound := Counter.n >= 0

spec HandlerSpec := Handler[t : Int]
spec NestedSpec := <true> Counter || HandlerSpec <Bound>
