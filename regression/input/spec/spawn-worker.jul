type DynProc

static proc Server {
    var ready : Boolean

    constructor initially(args : List<String>) {
        transit: ready := false
    }

    transition spawnWorker(id : Int) {
        guard: ready
        transit: ready := true
    }
}

proc Worker {
    var id : Int

    constructor spawnWorker(id : Int) {
        transit: id := id
    }

    internal return work() {
        guard: id >= 0
    }
}

invariant G := forall i : DynProc, Worker[i].id >= 0

spec SpawnWorker := <true> Server || Worker <G>

compile SpawnWorker
