/*
 * Unguarded map read compiles; backends use hard lookup (no soft-default).
 */
import julay.funlib.mapOf

type Key := String

static proc Store {
    var owners : Map<Key, String> := mapOf()

    constructor initially(args : List<String>) {}

    internal transition claim(key : Key) {
        guard:
            owners[key] = ""
        transit:
            owners[key] := "taken"
    }
}

invariant Inv := true

spec SoftDefaultMapIndex := Store |= Inv {
    Key := {"k1"}
}

compile SoftDefaultMapIndex
