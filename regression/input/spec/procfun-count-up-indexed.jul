type Idx

procfun countUp(n : Int) : Int {
    var steps : Int := 0
    var result : Int := 0

    internal transition step() {
        guard: steps < n
        transit:
            result := steps + 1
            steps := steps + 1
    }

    internal transition done() {
        guard: steps = n
        return: result
    }
}

proc Main {
    var out : Int

    constructor initially(args : List<String>) {
        transit:
            out := CountUpApi.countUp(1)
    }
}

api CountUpApi {
    proc: Main
    calls: countUp
}

spec CountUpIndexed := CountUpApi[k : Idx] {
    Idx := {"a", "b"}
}

compile CountUpIndexed
