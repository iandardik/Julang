p-class Alice {
    var done : Boolean

    constructor initially() {
        transit: done := false
    }

    session transition meet() {
        guard: ~done
        transit: done := true
    }
}

p-class Bob {
    var done : Boolean

    constructor initially() {
        transit: done := false
    }

    session transition meet() {
        guard: ~done
        transit: done := true
    }
}

invariant Inv := true

spec SessionPairParam := <true> Alice[a : Int] || Bob[b : Int] <Inv>
spec SessionAliceOnlyParam := <true> Alice[a : Int] <Inv>
