type Node
Node := { "n1" }

proc Peer {
    var self : String := ""

    constructor initially(args : List<String>) {
        transit: self := "n1"
    }

    transition ping() {
        transit: self := self
    }
}

spec Net[n : Node] {
    constructor initially(args : List<String>) {}

    transition observe(target : String) also (m : Node) {
        guard: Peer[m].self = target
        transit:
    }
}

// Peer is not create-indexed — indexed peer read must fail at compile.
spec BadPeerIdx := Net || Peer

compile BadPeerIdx
