type Node

static proc Peer {
    var self : String := ""

    constructor initially(args : List<String>) {
        transit: self := "n1"
    }

    transition ping() {
        transit: self := self
    }
}

static spec Net[n : Node] {
    Node := { "n1" }
    constructor initially(args : List<String>) {}

    transition observe(target : String) also (m : Node) {
        guard: Peer[m].self = target
        transit:
    }
}

// Peer is not create-indexed — indexed peer read must fail at compile.
spec BadPeerIdx := Net || Peer {
    unsynced observe, ping
}

compile BadPeerIdx
