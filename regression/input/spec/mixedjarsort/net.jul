export sort NodeSet := { "n1", "n2" }

obj VoteRequestMsg {
    dest : NodeSet
    msg : String
}

export spec Net {
    var msgs : Set<VoteRequestMsg> := {}

    constructor initially(args : List<String>) {}

    transition send() {
        transit:
            msgs := msgs + { VoteRequestMsg { dest := "n1", msg := "hi" } }
    }
}
