import julay.funlib.setOf
export sort NodeSet := { "n1", "n2" }

obj VoteRequestMsg {
    dest : NodeSet
    msg : String
}

export spec Net {
    var msgs : Set<VoteRequestMsg> := setOf()

    constructor initially(args : List<String>) {}

    transition send() {
        transit:
            msgs := msgs + setOf(VoteRequestMsg { dest := "n1", msg := "hi" })
    }
}
