import julay.funlib.exitProgram
import julay.funlib.println
import protocol.Sys

proc Peer {
    var done : Boolean

    constructor initially(args : List<String>) {
        transit: done := false
    }

    internal transition ping() {
        guard: ~done
        before: println("ok")
        transit: done := true
    }

    internal transition exitSystem() {
        guard: done
        after: exitProgram(0)
    }
}

proc PeerApp := Peer

compile PeerApp, Sys
