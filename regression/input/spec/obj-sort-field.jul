import julay.funlib.setOf
type NodeSet

type VoteRequestMsg {
    dest : NodeSet
    msg : String
}

spec Env {
    NodeSet := { "n1", "n2" }
    var dest : NodeSet := "n1"
    var msgs : Set<VoteRequestMsg> := setOf()
    constructor initially(args : List<String>) {
        transit: dest := "n1"
        transit: msgs := setOf()
    }
    transition send() {
        guard: dest = "n1"
        transit: msgs := msgs + setOf(VoteRequestMsg { dest := dest, msg := "hi" })
    }
}

compile Env
