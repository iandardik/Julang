import julay.funlib.setOf
obj Msg {
    src : Int
    dest : Int
}

proc Mail {
    var msgs : Set<Msg>
    var last : Msg
    var longishStateVar : Int

    constructor initially(args : List<String>) {
        transit:
            msgs := setOf()
            last := Msg { src := 0, dest := 0 }
            longishStateVar := 0
    }

    transition send(n : Int, m : Int) {
        guard: last.src >= 0 & last.dest >= 0
        transit:
            msgs := msgs + setOf(Msg {
                src := n,
                dest := m
            })
            longishStateVar := if (longishStateVar < 1) {
                if (n > 0) {
                    n
                } else {
                    0
                }
            } else {
                longishStateVar
            }
    }
}

spec OpenColumnIndent := <true> Mail <true>

compile OpenColumnIndent
