type NodeSet

type NodeInfo {
    id : Int
    url : String
}

static proc Cluster {
    const cluster : List<NodeInfo>

    constructor initially(cluster : List<NodeInfo>) {
        transit:
            cluster := cluster
    }
}

static proc Peer {
    var n : Int
    var lastUrl : String

    constructor initially(args : List<String>) {
        transit:
            n := 0
            lastUrl := ""
    }

    transition bump() {
        transit:
            n := n + 1
    }
}

spec SingletonNodeInfoList := (Peer[i : NodeSet] || Cluster) {
    NodeSet := { "n1", "n2" }
    init: Cluster.cluster.length = NodeSet.length
    init: forall i : Int, (i >= 1 & i <= Cluster.cluster.length) => Cluster.cluster[i].id = i
    unsynced bump
}

compile SingletonNodeInfoList
