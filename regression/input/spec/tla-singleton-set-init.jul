type Ids

static proc Box {
    const xs : Set<Int>
    var n : Int

    constructor initially(args : List<String>) {
        transit:
            n := 0
    }

    transition bump() {
        transit: n := n + 1
    }
}

spec SingletonSetInit := Box[i : Ids] {
    Ids := { "a", "b" }
    global Box.xs
    init: xs.length = Ids.length
    init: forall i : Int, (i >= 1 & i <= xs.length) => i in xs
} {
    unsynced bump
}

compile SingletonSetInit
