type Ids

static proc XsHolder {
    const xs : Set<Int>

    constructor initially(xs : Set<Int>) {
        transit:
            xs := xs
    }
}

static proc Box {
    var n : Int

    constructor initially(args : List<String>) {
        transit:
            n := 0
    }

    transition bump() {
        transit: n := n + 1
    }
}

spec SingletonSetInit := (Box[i : Ids] || XsHolder) {
    Ids := { "a", "b" }
    init: XsHolder.xs.length = Ids.length
    init: forall i : Int, (i >= 1 & i <= XsHolder.xs.length) => i in XsHolder.xs
    unsynced bump
}

compile SingletonSetInit
