import julay.funlib.setOf

type Msg {
    dest : Int
    value : Int
}

proc Net {
    var msgs : Set<Msg>
    var got : Int

    constructor initially(args : List<String>) {
        transit:
            msgs := setOf()
            got := 0
    }

    transition recv(x : Int) {
        guard: got >= 0 & Msg { dest := 0, value := x } in msgs
        transit: got := x
    }
}

spec FromCollectionStruct := <true> Net <true>

compile FromCollectionStruct
