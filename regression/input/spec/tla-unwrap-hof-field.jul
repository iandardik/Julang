type Ids

type Node {
    id : Int
    url : String
}

fun lookup(cluster : Set<Node>, id : Int) : Node =
    cluster.filter(x -> x.id = id).toList()[1]

static proc Cluster {
    const cluster : Set<Node>

    constructor initially(cluster : Set<Node>) {
        transit:
            cluster := cluster
        error:
            cluster.map(x -> x.id).length ~= cluster.length -> "dup ids"
    }
}

static proc Box {
    var n : Int

    constructor start() {
        transit:
            n := 0
    }

    transition pick(id : Int, cluster : Set<Node>) {
        guard: lookup(cluster, id) in cluster
        transit: n := n + 1
    }
}

spec UnwrapHofField := (Box[i : Ids] || Cluster) {
    Ids := { "a", "b", "c" }
    init: Cluster.cluster.length = Ids.length
    init: forall i : Int, (i >= 1 & i <= Cluster.cluster.length) => (exists node : Node, node in Cluster.cluster & node.id = i)
    unsynced pick, start
}

compile UnwrapHofField
