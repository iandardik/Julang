import julay.funlib.mapOf

/* Carrier literal assigned to a typedef var must widen the delayed model (TypeOK). */
type N
type Key := String
type Value := String

static proc Box {
    var table : Map<Key, Value>
    var pending : Value

    constructor initially(args : List<String>) {
        transit:
            table := mapOf()
            pending := ""
    }

    internal transition put(k : Key, v : Value) {
        transit:
            table[k] := v
            pending := v
    }
}

invariant PendingOk := forall i : N, Box[i].pending = Box[i].pending

spec TypedefWidenSpec := Box[i : N] {
    N := {"a"}
    Key := {"k1", "k2"}
    Value := {"v1", "v2"}
} |= PendingOk

compile TypedefWidenSpec
