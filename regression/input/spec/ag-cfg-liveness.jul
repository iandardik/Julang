/*
 * Explicit <A> Sys <G> omits cfg liveness; Sys |= G keeps PROPERTY *Terminates
 * (including with unsynced open-env arms).
 */
static proc Boss {
    var spawned : Boolean

    constructor initially(args : List<String>) {
        transit: spawned := false
    }

    transition start() {
        guard: ~spawned
        transit: spawned := true
    }
}

proc Leaf {
    var phase : String

    constructor start() {
        transit: phase := "live"
    }

    internal transition step() {
        guard: phase = "live"
        transit: phase := "done"
    }

    internal return die() {
        guard: phase = "done"
    }
}

invariant Inv := true

spec ModelsSpec := Boss || Leaf |= Inv {
    unsynced start
}

spec ExplicitAgSpec := <true> Boss || Leaf <Inv> {
    unsynced start
}

compile ModelsSpec
compile ExplicitAgSpec
