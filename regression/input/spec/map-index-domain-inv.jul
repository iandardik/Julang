import julay.funlib.mapOf

type N

static proc Box {
    var store : Map<String, String>

    constructor initially(args : List<String>) {
        transit:
            store := mapOf()
    }

    internal transition put(k : String, v : String) {
        guard:
            true
        transit:
            store[k] := v
    }
}

/*
 * Soft-read: absent keys equal "" so uniqueness of present bindings must
 * require membership explicitly (same meaning as the old DOMAIN desugar).
 */
invariant Unique := forall n1, n2 : N, forall k : String, forall v1, v2 : String,
    (k in Box[n1].store & Box[n1].store[k] = v1 &
     k in Box[n2].store & Box[n2].store[k] = v2) => (n1 = n2 & v1 = v2)

spec MapIndexDomainInv := Box[n : N] {
    N := {"a", "b"}
} |= Unique

compile MapIndexDomainInv
