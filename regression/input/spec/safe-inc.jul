proc Env {
    var ready : Boolean

    constructor initially(args : List<String>) {
        transit: ready := false
    }

    transition arm() {
        guard: ~ready
        transit: ready := true
    }

    provider transition inc() {
        guard: ready
        transit: ready := false
    }
}

proc Counter {
    var n : Int

    constructor initially(args : List<String>) {
        transit: n := 0
    }

    client transition inc() {
        guard: n < 3
        transit: n := n + 1
    }
}

invariant Bound := forall k : Int, Counter.n <= 3

spec SafeInc := <Env> Counter <Bound>

compile SafeInc
