type Node
Node := {"n1", "n2", "n3"}

proc Counter {
    var n : Int

    constructor initially(args : List<String>) {
        transit: n := 0
    }

    transition bump() {
        guard: n < 3
        transit: n := n + 1
    }
}

invariant G := forall i : Node, Counter[i].n <= 3

spec SortIndex := <true> Counter[i : Node] <G>

compile SortIndex
