/*
 * After return, a DynProc slot is retired and cannot be reconstructed in TLA.
 */
static proc Boss {
    var spawned : Boolean

    constructor initially(args : List<String>) {
        transit: spawned := false
    }

    transition start() {
        guard: ~spawned
        transit: spawned := true
    }
}

proc Worker {
    var phase : String

    constructor start() {
        transit: phase := "live"
    }

    internal transition step() {
        guard: phase = "live"
        transit: phase := "done"
    }

    internal return die() {
        guard: phase = "done"
    }
}

invariant Inv := true

spec NoReconstruct := Boss || Worker |= Inv {
    DynProc := {"dp1"}
}

compile NoReconstruct
