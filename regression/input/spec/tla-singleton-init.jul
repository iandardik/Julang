type Ids

static proc XsHolder {
    const xs : List<Int>

    constructor initially(xs : List<Int>) {
        transit:
            xs := xs
    }
}

static proc Box {
    var n : Int

    constructor initially(args : List<String>) {
        transit:
            n := 0
    }

    transition bump() {
        transit: n := n + 1
    }
}

spec SingletonInit := (Box[i : Ids] || XsHolder) {
    Ids := { "a", "b" }
    init: XsHolder.xs.length = Ids.length
    init: forall i : Int, (i >= 1 & i <= XsHolder.xs.length) => XsHolder.xs[i] = i
    unsynced bump
}

compile SingletonInit
