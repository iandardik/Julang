type Ids
Ids := { "a", "b" }

proc Box {
    const xs : List<Int>
    var n : Int

    constructor initially(args : List<String>) {
        transit:
            n := 0
    }

    transition bump() {
        transit: n := n + 1
    }
}

spec SingletonInit := Box[i : Ids] {
    const global xs
    init: xs.length = Ids.length
    init: forall i : Int, (i >= 1 & i <= xs.length) => xs[i] = i
}

compile SingletonInit
