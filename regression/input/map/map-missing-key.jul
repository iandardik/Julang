import julaylib.pclass.ExitSystem

proc MapMissingKey {
    var mp : Map<String, Int>
    var n : Int

    constructor initially(args : List<String>) {
        transit:
            mp := ["a" -> 1]
            n := 0
    }

    internal transition bad() {
        guard:
            n = 0
        transit:
            n := mp["missing"]
    }

    transition exitSystem() {
        guard:
            false
    }
}

proc MapMissingKeyTest := MapMissingKey || ExitSystem

compile MapMissingKeyTest
