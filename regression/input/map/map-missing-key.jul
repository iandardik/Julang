import julay.funlib.exitProgram
import julay.funlib.mapOf

/*
 * Missing-key map read must panic at runtime (aligned with TLA domain error).
 */
static proc MapMissingKey {
    var mp : Map<String, Int>
    var n : Int

    constructor initially(args : List<String>) {
        transit:
            mp := mapOf("a" to 1)
            n := 0
    }

    internal transition bad() {
        guard:
            true
        transit:
            n := mp["missing"]
        after:
            exitProgram(0)
    }
}

proc MapMissingKeyTest := MapMissingKey

compile MapMissingKeyTest
