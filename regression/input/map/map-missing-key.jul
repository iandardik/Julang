import julay.funlib.exitProcess

proc MapMissingKey {
    var mp : Map<String, Int>
    var n : Int

    constructor initially(args : List<String>) {
        transit:
            mp := ["a" -> 1]
            n := 0
    }

    internal transition bad() {
        guard:
            n = 0
        transit:
            n := mp["missing"]
    }

    internal transition exitSystem() {
        guard:
            false
        after:
            exitProcess()
    }
}

proc MapMissingKeyTest := MapMissingKey

compile MapMissingKeyTest
