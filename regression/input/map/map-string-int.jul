import julay.funlib.length
import julay.funlib.println
import julay.funlib.exitProgram
import julay.funlib.mapOf

proc MapStringIntDemo {
    var mp : Map<String, Int>
    var n : Int
    var print : Boolean
    var gotCli : Boolean

    constructor initially(args : List<String>) {
        transit:
            mp := mapOf("a" to 1, "b" to 2)
            n := 0
            print := false
            gotCli := length(args) = 1
        after:
            println(args[0])
    }

    internal transition read() {
        guard:
            ~print & gotCli & length(mp) = 2 & "a" in mp & ~( "z" in mp )
        transit:
            n := mp["a"]
            print := true
    }

    internal transition update() {
        guard:
            print & n = 1
        transit:
            mp["c"] := 3
            n := length(mp) + 1
            print := false
    }

    internal transition println(msg : String) {
        guard:
            ~print & n = 3 & (msg = n + "")
        transit:
            print := true
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            print & n = 3 & mp["c"] = 3
        after:
            exitProgram(0)
    }
}

proc MapStringIntTest := MapStringIntDemo

compile MapStringIntTest
