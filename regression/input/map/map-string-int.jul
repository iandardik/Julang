import julaylib.pclass.Println
import julaylib.pclass.ExitSystem
import julaylib.fun.length

p-class MapStringIntDemo {
    var mp : Map<String, Int>
    var n : Int
    var print : Boolean
    var gotCli : Boolean

    constructor initially(args : List<String>) {
        transit:
            mp := ["a" -> 1, "b" -> 2]
            n := 0
            print := false
            gotCli := length(args) = 1
        effect:
            println(args[0])
    }

    transition read() {
        guard:
            ~print & gotCli & length(mp) = 2 & "a" in mp & ~( "z" in mp )
        transit:
            n := mp["a"]
            print := true
    }

    transition update() {
        guard:
            print & n = 1
        transit:
            mp["c"] := 3
            n := length(mp)
            print := false
    }

    p2p-consumer transition println(msg : String) {
        guard:
            ~print & (msg = n + "")
        transit:
            print := true
    }

    p2p-consumer transition exitSystem() {
        guard:
            print & n = 3 & mp["c"] = 3
    }
}

program MapStringIntTest := MapStringIntDemo || Println || ExitSystem
