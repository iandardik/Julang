import julay.funlib.mapOf
proc BadMapKey {
    var mp : Map<String, Int>
    var n : Int

    constructor initially(args : List<String>) {
        transit:
            mp := mapOf("a" to 1)
            n := 0
    }

    transition bad() {
        guard:
            n = 0
        transit:
            n := mp[1]
    }
}

proc P := BadMapKey

compile P
