proc BadMapTransit {
    var mp : Map<String, Int>

    constructor initially(args : List<String>) {
        transit:
            mp := ["a" -> 1]
    }

    internal transition bad() {
        guard:
            true
        transit:
            mp := ["b" -> 2]
            mp["c"] := 3
    }
}

proc P := BadMapTransit

compile P
