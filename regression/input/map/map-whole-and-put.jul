import julay.funlib.mapOf
proc BadMapTransit {
    var mp : Map<String, Int>

    constructor initially(args : List<String>) {
        transit:
            mp := mapOf("a" to 1)
    }

    internal transition bad() {
        guard:
            true
        transit:
            mp := mapOf("b" to 2)
            mp["c"] := 3
    }
}

proc P := BadMapTransit

compile P
