import julay.funlib.exitProcess
import julay.funlib.mapOf

proc BadMap {
    var mp : Map<String, Int>

    constructor initially(args : List<String>) {
        transit:
            mp := mapOf("a" to 1, "b" to true)
    }

    internal transition exitSystem() {
        guard: true
        after:
            exitProcess()
    }
}

proc BadMapTest := BadMap

compile BadMapTest
