import julay.funlib.exitProcess

proc BadMap {
    var mp : Map<String, Int>

    constructor initially(args : List<String>) {
        transit:
            mp := ["a" -> 1, "b" -> true]
    }

    internal transition exitSystem() {
        guard: true
        after:
            exitProcess()
    }
}

proc BadMapTest := BadMap

compile BadMapTest
