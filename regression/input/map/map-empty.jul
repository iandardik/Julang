import julay.funlib.length
import julay.funlib.exitProgram
import julay.funlib.mapOf

proc MapEmptyDemo {
    var mp : Map<String, Int>
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            mp := mapOf()
            done := false
    }

    internal transition check() {
        guard:
            ~done
        transit:
            done := length(mp) = 0
    }

    internal transition exitSystem() {
        guard:
            done
        after:
            exitProgram(0)
    }
}

proc MapEmptyTest := MapEmptyDemo

compile MapEmptyTest
