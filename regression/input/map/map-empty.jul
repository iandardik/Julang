import julay.proclib.ExitSystem
import julay.funlib.length

proc MapEmptyDemo {
    var mp : Map<String, Int>
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            mp := []
            done := false
    }

    internal transition check() {
        guard:
            ~done
        transit:
            done := length(mp) = 0
    }

    transition exitSystem() {
        guard:
            done
    }
}

proc MapEmptyTest := MapEmptyDemo || ExitSystem

compile MapEmptyTest
