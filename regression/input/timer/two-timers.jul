import julay.funlib.setTimer
import julay.funlib.cancelTimer
import julay.funlib.println

/*
 * Two independent drivers, each with its own timer table.
 * ClientA lets timeoutA fire; ClientB cancels timeoutB before it fires.
 */

static proc ClientA {
    var step : String

    constructor initially(args : List<String>) {
        transit: step := "wait"
        after:
            setTimer("timeoutA", 50)
    }

    timer transition timeoutA() {
        guard: step = "wait"
        transit: step := "done"
    }

    internal transition printADone() {
        guard: step = "done"
        transit: step := "idle"
        after:
            println("A-timeout")
    }
}

static proc ClientB {
    var step : String

    constructor initially(args : List<String>) {
        transit: step := "armed"
        after:
            setTimer("timeoutB", 5000)
    }

    internal transition cancelB() {
        guard: step = "armed"
        transit: step := "done"
        after:
            cancelTimer("timeoutB")
    }

    timer transition timeoutB() {
        guard: false
    }

    internal transition printBDone() {
        guard: step = "done"
        transit: step := "idle"
        after:
            println("B-cancelled")
    }
}

proc TwoTimers := ClientA || ClientB

compile TwoTimers
