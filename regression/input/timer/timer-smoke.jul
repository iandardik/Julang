import julay.funlib.setTimer
import julay.funlib.exitProgram
import julay.funlib.println

static proc Driver {
    var step : String

    constructor initially(args : List<String>) {
        transit: step := "wait"
        after:
            setTimer("timeout", 50)
    }

    timer transition timeout() {
        guard: step = "wait"
        transit: step := "print"
    }

    internal transition println(msg : String) {
        guard: step = "print" & msg = "ok"
        transit: step := "idle"
        after:
            println(msg)
            exitProgram(0)
    }
}

proc TimerSmoke := Driver

compile TimerSmoke
