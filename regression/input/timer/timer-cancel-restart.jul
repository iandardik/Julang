import julay.proclib.Timer
import julay.funlib.exitProgram
import julay.funlib.println

/*
 * Start a long timer, cancel it, then start a short one that should fire.
 * Long delay is only to prove cancel (we never wait it out); short delay is 1s.
 * Exits after print so the regression harness can wait for completion instead of
 * a fixed background sleep (which is capped by the case compile+run budget).
 */
proc Driver {
    var step : String

    constructor initially(args : List<String>) {
        transit: step := "create"
    }

    session transition createTimer() {
        guard: step = "create"
        transit: step := "startLong"
    }

    session transition startTimer(time : Int) {
        guard:
            (step = "startLong" & time = 5) | (step = "startShort" & time = 1)
        transit:
            step := when (step) {
                "startLong" -> "cancel"
                else -> "wait"
            }
    }

    session transition cancelTimer() {
        guard: step = "cancel"
        transit: step := "startShort"
    }

    session transition timeout() {
        guard: step = "wait"
        transit: step := "print"
    }

    internal transition println(msg : String) {
        guard: step = "print" & msg = "restarted"
        transit: step := "idle"
        after:
            println(msg)
            exitProgram(0)
    }
}

proc TimerCancelRestart := Driver || Timer

compile TimerCancelRestart
