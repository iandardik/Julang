import julay.funlib.setTimer
import julay.funlib.cancelTimer
import julay.funlib.exitProgram
import julay.funlib.println

/*
 * Start a long timer, cancel it, then start a short one that should fire.
 */
static proc Driver {
    var step : String

    constructor initially(args : List<String>) {
        transit: step := "startLong"
        after:
            setTimer("timeout", 5000)
    }

    internal transition cancelLong() {
        guard: step = "startLong"
        transit: step := "startShort"
        after:
            cancelTimer("timeout")
            setTimer("timeout", 50)
    }

    timer transition timeout() {
        guard: step = "startShort"
        transit: step := "print"
    }

    internal transition println(msg : String) {
        guard: step = "print" & msg = "restarted"
        transit: step := "idle"
        after:
            println(msg)
            exitProgram(0)
    }
}

proc TimerCancelRestart := Driver

compile TimerCancelRestart
