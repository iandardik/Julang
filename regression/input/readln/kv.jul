p-class FrontEnd {
    var state : String
    var keyReq : String
    var valReq : String

    constructor initially() {
        transit:
            state := "A"
            keyReq := ""
            valReq := ""
    }

    p2p-consumer transition prompt() {
        guard:
            state = "A"
        transit:
            state := "B"
    }
    
    p2p-consumer transition readln(msg : String) {
        guard:
            state = "B"
        transit:
            keyReq := msg
            state := "C"
    }

    transition readDB(key : String, val : String) {
        guard:
            (state = "C") & (key = keyReq) & (keyReq != "exit")
        transit:
            state := "D"
            valReq := "val:\n\t" + val // just to test string concatenation and escape characters
    }

    p2p-consumer transition println(msg : String) {
        guard:
            (state = "D") & ((msg + "") = valReq) // (msg + "") to test string concatenation with action args
        transit:
            state := "A"
    }

    p2p-consumer transition exitSystem() {
        guard:
            keyReq = "exit"
    }
}

p-class DB {
    constructor initially() {}

    transition readDB(key : String, val : String) {
        guard:
            if (~(key = "A" | key = "B" | key = "C")) {
                val = "N/A"
            } else {
                  (key = "A" & val = "apple")
                | (key = "B" & val = "banana")
                | (key = "C" & val = "cherry")
            }
    }
}

p-class DB2 {
    constructor initially() {}

    transition readDB(key : String, val : String) {
        guard:
              (key = "A" & val = "ants")
            | (key = "B" & val = "bats")
            | (key = "C" & val = "cows")
            | (~(key = "A" | key = "B" | key = "C") & val = "N/A")
    }
}

program KVOne := FrontEnd || DB || Println || Readln || ExitSystem
program KVTwo := FrontEnd || DB2 || Println || Readln || ExitSystem
