import julay.funlib.exitProcess
import julay.funlib.println
import julay.funlib.readln

proc FrontEnd {
    var state : String
    var keyReq : String
    var valReq : String

    constructor initially(args : List<String>) {
        transit:
            state := "A"
            keyReq := ""
            valReq := ""
    }

    transition prompt() {
        guard:
            state = "A"
        transit:
            state := "B"
    }
    
    transition readln(msg : String) {
        guard:
            state = "B"
        transit:
            keyReq := msg
            state := "C"
    }

    transition readDB(key : String, val : String) {
        guard:
            (state = "C") & (key = keyReq) & (keyReq ~= "exit")
        transit:
            state := "D"
            valReq := "val:\n\t" + val // just to test string concatenation and escape characters
    }

    internal transition println(msg : String) {
        guard:
            (state = "D") & ((msg + "") = valReq) // (msg + "") to test string concatenation with action args
        transit:
            state := "A"
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            keyReq = "exit"
        after:
            exitProcess()
    }
}

proc DB {
    constructor initially(args : List<String>) {}

    transition readDB(key : String, val : String) {
        guard:
            if (~(key = "A" | key = "B" | key = "C")) {
                val = "N/A"
            } else {
                | (key = "A" & val = "apple")
                | (key = "B" & val = "banana")
                | (key = "C" & val = "cherry")
            }
    }
}

proc DB2 {
    constructor initially(args : List<String>) {}

    transition readDB(key : String, val : String) {
        guard:
            | (key = "A" & val = "ants")
            | (key = "B" & val = "bats")
            | (key = "C" & val = "cows")
            | (~(key = "A" | key = "B" | key = "C") & val = "N/A")
    }
}

proc Readln {
    var prompt : Boolean
    var readMsg : String

    constructor initially(args : List<String>) {
        transit:
            prompt := true
            readMsg := ""
    }

    service transition prompt() {
        guard: prompt
        transit:
            prompt := false
            readMsg := readln()
    }

    service transition readln(msg : String) {
        guard: ~prompt & (readMsg = msg)
        transit:
            prompt := true
    }
}

proc KVOne := FrontEnd || DB || Readln
proc KVTwo := FrontEnd || DB2 || Readln

compile KVOne, KVTwo
