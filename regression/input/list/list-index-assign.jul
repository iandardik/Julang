import julay.funlib.length
import julay.funlib.println
import julay.funlib.exitProgram
import julay.funlib.listOf

proc ListIndexAssignDemo {
    var xs : List<Int>
    var n : Int
    var print : Boolean
    var gotCli : Boolean

    constructor initially(args : List<String>) {
        transit:
            xs := listOf(1, 2, 3)
            n := 0
            print := false
            gotCli := length(args) = 1
        after:
            println(args[0])
    }

    internal transition update() {
        guard:
            ~print & gotCli & length(xs) = 3 & xs[1] = 2
        transit:
            xs[1] := 9
            n := 9
            print := true
    }

    internal transition println(msg : String) {
        guard:
            print & n = 9 & (msg = n + "")
        transit:
            print := false
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            ~print & n = 9 & xs[0] = 1 & xs[1] = 9 & xs[2] = 3
        after:
            exitProgram(0)
    }
}

proc ListIndexAssignTest := ListIndexAssignDemo

compile ListIndexAssignTest
