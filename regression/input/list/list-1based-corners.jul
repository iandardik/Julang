import julay.funlib.length
import julay.funlib.exitProgram
import julay.funlib.println
import julay.funlib.listOf
import julay.funlib.splice

// Corner cases for 1-based indexing and inclusive splice.
proc ListOneBasedCorners {
    var xs : List<Int>
    var first : Int
    var last : Int
    var whole : List<Int>
    var single : List<Int>
    var prefix : List<Int>
    var emptyRev : List<Int>
    var emptyPast : List<Int>
    var emptySrc : List<Int>
    var emptyList : List<Int>
    var nested : Int
    var phase : Int

    constructor initially(args : List<String>) {
        transit:
            xs := listOf(10, 20, 30, 40)
            emptyList := listOf()
            first := 0
            last := 0
            whole := listOf()
            single := listOf()
            prefix := listOf()
            emptyRev := listOf(1)
            emptyPast := listOf(1)
            emptySrc := listOf(1)
            nested := 0
            phase := 0
    }

    internal transition readEnds() {
        guard:
            phase = 0
        transit:
            first := xs[1]
            last := xs[xs.length]
            phase := 1
    }

    internal transition assignEnds() {
        guard:
            phase = 1 & first = 10 & last = 40
        transit:
            xs[1] := 11
            xs[4] := 44
            phase := 2
    }

    internal transition spliceCases() {
        guard:
            phase = 2 & xs[1] = 11 & xs[4] = 44
        transit:
            whole := splice(xs, 1, xs.length)
            single := splice(xs, 2, 2)
            prefix := splice(xs, 1, 3)
            emptyRev := splice(xs, 3, 1)
            emptyPast := splice(xs, 5, 99)
            emptySrc := splice(emptyList, 1, 1)
            nested := splice(xs, 1, 3)[1]
            phase := 3
    }

    internal transition println(msg : String) {
        guard:
            phase = 3
            & whole = listOf(11, 20, 30, 44)
            & single = listOf(20)
            & prefix = listOf(11, 20, 30)
            & length(emptyRev) = 0
            & length(emptyPast) = 0
            & length(emptySrc) = 0
            & nested = 11
            & (msg = first + "," + last + "," + nested)
        transit:
            phase := 4
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            phase = 4
        after:
            exitProgram(0)
    }
}

proc ListOneBasedCornersTest := ListOneBasedCorners

compile ListOneBasedCornersTest
