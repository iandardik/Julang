import julay.funlib.length
import julay.funlib.exitProgram
import julay.funlib.println
import julay.funlib.listOf
import julay.funlib.splice

proc ListSliceDemo {
    var xs : List<Int>
    var mid : List<Int>
    var emptyEq : List<Int>
    var emptyRev : List<Int>
    var clamped : List<Int>
    var nested : Int
    var phase : Int

    constructor initially(args : List<String>) {
        transit:
            xs := listOf(10, 20, 30, 40)
            mid := listOf()
            emptyEq := listOf(1)
            emptyRev := listOf(1)
            clamped := listOf()
            nested := 0
            phase := 0
    }

    internal transition sliceMid() {
        guard:
            phase = 0
        transit:
            mid := splice(xs, 1, 3)
            phase := 1
    }

    internal transition sliceEmpty() {
        guard:
            phase = 1 & mid = listOf(20, 30) & length(mid) = 2
        transit:
            emptyEq := splice(xs, 2, 2)
            emptyRev := splice(xs, 3, 1)
            phase := 2
    }

    internal transition sliceClampAndNest() {
        guard:
            phase = 2 & length(emptyEq) = 0 & length(emptyRev) = 0
        transit:
            clamped := splice(xs, 2, 99)
            nested := splice(xs, 1, 3)[0]
            phase := 3
    }

    internal transition println(msg : String) {
        guard:
            phase = 3 & clamped = listOf(30, 40) & nested = 20 & (msg = mid + "")
        transit:
            phase := 4
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            phase = 4
        after:
            exitProgram(0)
    }
}

proc ListSliceTest := ListSliceDemo

compile ListSliceTest
