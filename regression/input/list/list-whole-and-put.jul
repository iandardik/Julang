import julay.funlib.listOf
proc BadListTransit {
    var xs : List<Int>

    constructor initially(args : List<String>) {
        transit:
            xs := listOf(1, 2)
    }

    internal transition bad() {
        guard:
            true
        transit:
            xs := listOf(3, 4)
            xs[0] := 5
    }
}

proc P := BadListTransit

compile P
