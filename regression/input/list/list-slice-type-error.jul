import julay.funlib.exitProcess

proc BadSlice {
    var xs : List<Int>
    var ys : List<Int>

    constructor initially(args : List<String>) {
        transit:
            xs := [1, 2, 3]
            ys := xs[true:2]
    }

    internal transition exitSystem() {
        guard: true
        after:
            exitProcess()
    }
}

proc BadSliceTest := BadSlice

compile BadSliceTest
