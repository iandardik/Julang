import julay.proclib.ExitSystem

proc BadSlice {
    var xs : List<Int>
    var ys : List<Int>

    constructor initially(args : List<String>) {
        transit:
            xs := [1, 2, 3]
            ys := xs[true:2]
    }

    transition exitSystem() {
        guard: true
    }
}

proc BadSliceTest := BadSlice || ExitSystem

compile BadSliceTest
