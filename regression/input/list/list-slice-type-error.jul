import julay.funlib.exitProcess
import julay.funlib.listOf
import julay.funlib.splice

proc BadSlice {
    var xs : List<Int>
    var ys : List<Int>

    constructor initially(args : List<String>) {
        transit:
            xs := listOf(1, 2, 3)
            ys := splice(xs, true, 2)
    }

    internal transition exitSystem() {
        guard: true
        after:
            exitProcess()
    }
}

proc BadSliceTest := BadSlice

compile BadSliceTest
