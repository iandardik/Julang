import julay.funlib.exitProcess

obj Point {
    x : Int
    y : Int
}

proc ListOClassDemo {
    var pts : List<Point>
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            pts := [Point { x := 1, y := 2 }, Point { x := 3, y := 4 }]
            done := false
    }

    internal transition check() {
        guard:
            ~done & pts[0] = Point { x := 1, y := 2 } & pts[1] = Point { x := 3, y := 4 }
        transit:
            done := true
    }

    internal transition exitSystem() {
        guard:
            done
        after:
            exitProcess()
    }
}

proc ListOClassTest := ListOClassDemo

compile ListOClassTest
