import julay.funlib.length
import julay.funlib.println
import julay.funlib.exitProgram
import julay.funlib.listOf

proc ListIntDemo {
    var xs : List<Int>
    var n : Int
    var print : Boolean
    const gotCli : Boolean

    constructor initially(args : List<String>) {
        transit:
            xs := listOf(1, 2)
            n := 0
            print := false
            gotCli := length(args) = 1
        after:
            println(args[0])
    }

    internal transition step() {
        guard:
            ~print & length(xs) = 2 & gotCli
        transit:
            xs := xs + listOf(3)
            n := xs[0]
            print := true
    }

    internal transition println(msg : String) {
        guard:
            print & (msg = n + "")
        transit:
            print := false
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            ~print & n = 1
        after:
            exitProgram(0)
    }
}

proc ListIntTest := ListIntDemo

compile ListIntTest
