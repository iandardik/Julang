import julay.proclib.Println
import julay.proclib.ExitSystem
import julay.funlib.length

proc ListIntDemo {
    var xs : List<Int>
    var n : Int
    var print : Boolean
    const gotCli : Boolean

    constructor initially(args : List<String>) {
        transit:
            xs := [1, 2]
            n := 0
            print := false
            gotCli := length(args) = 1
        after:
            println(args[0])
    }

    internal transition step() {
        guard:
            ~print & length(xs) = 2 & gotCli
        transit:
            xs := xs + [3]
            n := xs[0]
            print := true
    }

    transition println(msg : String) {
        guard:
            print & (msg = n + "")
        transit:
            print := false
    }

    transition exitSystem() {
        guard:
            ~print & n = 1
    }
}

proc ListIntTest := ListIntDemo || Println || ExitSystem

compile ListIntTest
