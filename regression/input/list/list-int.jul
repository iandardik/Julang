import julaylib.pclass.Println
import julaylib.pclass.ExitSystem
import julaylib.fun.length

p-class ListIntDemo {
    var xs : List Int
    var n : Int
    var print : Boolean

    constructor initially() {
        transit:
            xs := [1, 2]
            n := 0
            print := false
    }

    transition step() {
        guard:
            ~print & length(xs) = 2
        transit:
            xs := xs + [3]
            n := xs[0]
            print := true
    }

    p2p-consumer transition println(msg : String) {
        guard:
            print & (msg = n + "")
        transit:
            print := false
    }

    p2p-consumer transition exitSystem() {
        guard:
            ~print & n = 1
    }
}

program ListIntTest := ListIntDemo || Println || ExitSystem
