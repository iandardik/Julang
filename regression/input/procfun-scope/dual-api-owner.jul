api A {
    proc: Idle
    calls: helper
}

api B {
    proc: Idle
    calls: helper
}

static proc Idle {
    constructor initially(args : List<String>) {
        transit:
    }
}

procfun helper(x : Int) : Int {
    internal transition go() {
        return: x
    }
}

proc System := A || B

compile System
