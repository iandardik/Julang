import julaylib.pclass.Println
import julaylib.pclass.ExitSystem

proc S {
    var x : Int
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            x := 0
            print := true
    }
    
    transition increment(inc : Int) {
        guard:
            ~print & (x <= 10) & (inc > 0)
        transit:
            x := x + inc
            print := true
    }

    transition println(msg : String) {
        guard:
            print & (msg = x + "")
        transit:
            print := false
    }

    transition exitSystem() {
        guard: ~print & x > 10
    }
}

proc T {
    var x : Int

    constructor initially(args : List<String>) {
        transit:
            x := 0
    }

    transition increment(inc : Int) {
        guard:
            inc > 2 & x <= 10
        transit:
            x := x + inc
    }
}

proc TermTest2 := S || T || Println || ExitSystem

compile TermTest2
