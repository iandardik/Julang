import julaylib.pclass.Println
import julaylib.pclass.ExitSystem

p-class S {
    var x : Int
    var print : Boolean

    constructor initially() {
        transit:
            x := 0
            print := true
    }
    
    transition increment(inc : Int) {
        guard:
            ~print & (x <= 10) & (inc > 0)
        transit:
            x := x + inc
            print := true
    }

    p2p-consumer transition println(msg : String) {
        guard:
            print & (msg = x + "")
        transit:
            print := false
    }

    p2p-consumer transition exitSystem() {
        guard: ~print & x > 10
    }
}

p-class T {
    var x : Int

    constructor initially() {
        transit:
            x := 0
    }

    transition increment(inc : Int) {
        guard:
            inc > 2 & x <= 10
        transit:
            x := x + inc
    }
}

program TermTest2 := S || T || Println || ExitSystem
