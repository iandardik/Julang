o-class Point {
    x : Int
    y : Int
}

p-class S {
    var p : Point
    var x : Int

    constructor initially(args : List String) {
        transit:
            p := Point { x := 0, y := 0 }
            x := when (p) {
                Point { x := 0, y := 0 } -> 0
                Point { x := 0, y := 0 } -> 1
                else -> 2
            }
    }
}

program P := S
