import julay.funlib.println

/*
 * `x in Int` is an unbounded type domain — not a finite membership bind.
 */

proc Driver {
    var done : Boolean

    constructor initially(args : List<String>) {
        transit: done := false
    }

    internal transition pick(x : Int) {
        guard: ~done & x in Int
        transit: done := true
        after: println(x + "")
    }
}

proc XinInt := Driver

compile XinInt
