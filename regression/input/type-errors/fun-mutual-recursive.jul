fun even(n : Int) : Boolean = if (n = 0) { true } else { odd(n - 1) }

fun odd(n : Int) : Boolean = if (n = 0) { false } else { even(n - 1) }

p-class S {
    var x : Int

    constructor initially() {
        transit:
            x := 0
    }

    transition tick() {
        guard:
            even(x)
        transit:
            x := x + 1
    }
}

program P := S
