fun even(n : Int) : Boolean = if (n = 0) true else odd(n - 1)

fun odd(n : Int) : Boolean = if (n = 0) false else even(n - 1)

proc S {
    var x : Int

    constructor initially(args : List<String>) {
        transit:
            x := 0
    }

    transition tick() {
        guard:
            even(x)
        transit:
            x := x + 1
    }
}

proc P := S

compile P
