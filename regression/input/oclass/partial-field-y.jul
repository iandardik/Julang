import julaylib.pclass.ExitSystem

o-class Point {
    x : Int
    y : Int
}

p-class Worker {
    var pos : Point
    var steps : Int

    constructor initially(args : List<String>) {
        transit:
            steps := 0
            pos := Point { x := 10, y := 0 }
    }

    internal transition setY(newPos : Point) {
        guard:
            & newPos.y = 99
            & steps = 0
        transit:
            pos.y := newPos.y
            steps := 1
    }

    internal transition confirm() {
        guard:
            & pos.x = 10
            & pos.y = 99
            & steps = 1
        transit:
            steps := 2
    }

    transition exitSystem() {
        guard:
            steps = 2
    }
}

program PartialFieldYTest := Worker || ExitSystem
