import julay.funlib.exitProgram

obj Point {
    x : Int
    y : Int
}

proc Worker {
    var pos : Point
    var steps : Int

    constructor initially(args : List<String>) {
        transit:
            steps := 0
            pos := Point { x := 10, y := 0 }
    }

    internal transition setY(newPos : Point) {
        guard:
            & newPos.y = 99
            & steps = 0
        transit:
            pos.y := newPos.y
            steps := 1
    }

    internal transition confirm() {
        guard:
            & pos.x = 10
            & pos.y = 99
            & steps = 1
        transit:
            steps := 2
    }

    internal transition exitSystem() {
        guard:
            steps = 2
        after:
            exitProgram(0)
    }
}

proc PartialFieldYTest := Worker

compile PartialFieldYTest
