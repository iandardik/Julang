o-class Point {
    x : Int
    y : Int
}

p-class Worker {
    var pos : Point
    var ready : Boolean

    constructor initially(p : Point) {
        transit:
            pos := p
            ready := false
    }

    transition markReady() {
        guard:
              pos.x = 7
            & pos.y = 8
            & ~ready
        transit:
            ready := true
    }

    p2p-consumer transition exitSystem() {
        guard:
            ready
    }
}

program ConstructorArgTest := Worker || ExitSystem
