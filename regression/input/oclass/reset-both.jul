import julay.proclib.ExitSystem

obj Point {
    x : Int
    y : Int
}

obj Line {
    start : Point
    end : Point
}

proc Worker {
    var pos : Point
    var segment : Line
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            done := false
            pos := Point { x := 1, y := 1 }
            segment := Line {
                start := Point { x := 2, y := 2 },
                end := Point { x := 3, y := 3 }
            }
    }

    internal transition reset() {
        guard:
            ~done
        transit:
            pos := Point { x := 0, y := 0 }
            segment := Line {
                start := Point { x := 0, y := 0 },
                end := Point { x := 0, y := 0 }
            }
            done := true
    }

    transition exitSystem() {
        guard:
            & done
            & pos.x = 0
            & segment.end.y = 0
    }
}

proc ResetBothTest := Worker || ExitSystem

compile ResetBothTest
