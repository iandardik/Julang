import julay.funlib.exitProgram

obj Point {
    x : Int
    y : Int
}

proc Worker {
    var pos : Point
    var count : Int

    constructor initially(args : List<String>) {
        transit:
            count := 0
            pos := Point { x := 0, y := 0 }
    }

    internal transition moveSomewhere(newPos : Point) {
        guard:
            count < 5
        transit:
            pos := newPos
            count := count + 1
    }

    internal transition moveUp(newPos : Point) {
        guard:
            & newPos.y > 0
            & count < 5
        transit:
            pos.y := newPos.y
            count := count + 1
    }

    internal transition moveLeft(newPos : Point) {
        guard:
            & newPos.x < 0
            & count < 5
        transit:
            pos.x := newPos.x
            count := count + 1
    }

    internal transition exitSystem() {
        guard: count = 5
        after:
            exitProgram(0)
    }
}

proc FieldAccessTest2 := Worker

compile FieldAccessTest2
