type Point {
    x : Int
    y : Int
}

type Line {
    start : Point
    end : Point
}

type Mixed {
    label : String
    count : Int
}

proc Worker {
    var pos : Point
    var segment : Line
    var mixed : Mixed

    constructor initially(args : List<String>) {
        transit:
            pos := Point { x := 0, y := 0 }
            segment := Line {
                start := Point { x := 1, y := 2 },
                end := Point { x := 3, y := 4 }
            }
            // Fields written out of declaration order; codegen must still emit by name.
            mixed := Mixed {
                count := 7,
                label := "ok"
            }
    }

    internal transition reset() {
        guard:
            pos = Point { x := 0, y := 0 }
        transit:
            pos := Point { x := 0, y := 0 }
    }
}

proc ObjClassLiteralTest := Worker

compile ObjClassLiteralTest
