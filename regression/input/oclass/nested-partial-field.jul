import julaylib.pclass.ExitSystem

obj Point {
    x : Int
    y : Int
}

obj Line {
    start : Point
    end : Point
}

proc Worker {
    var segment : Line
    var steps : Int

    constructor initially(args : List<String>) {
        transit:
            steps := 0
            segment := Line {
                start := Point { x := 0, y := 0 },
                end := Point { x := 0, y := 0 }
            }
    }

    internal transition patchStart(newLine : Line) {
        guard:
            steps = 0
        transit:
            segment.start.x := newLine.start.x
            segment.start.y := newLine.start.y
            steps := 1
    }

    internal transition confirm(newLine : Line) {
        guard:
            & steps = 1
            & segment.start.x = newLine.start.x
            & segment.start.y = newLine.start.y
        transit:
            steps := 2
    }

    transition exitSystem() {
        guard:
            steps = 2
    }
}

proc NestedPartialFieldTest := Worker || ExitSystem

compile NestedPartialFieldTest
