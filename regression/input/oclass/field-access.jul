type Point {
    x : Int
    y : Int
    label : String
}

proc Worker {
    var pos : Point

    constructor initially(args : List<String>) {
        transit:
            pos := Point { x := 0, y := 0, label := "" }
    }

    internal transition move(newPos : Point) {
        guard:
            let (cur : Point := pos) {
                cur.x = newPos.x & cur.y = newPos.y
            }
        transit:
            pos := let (next : Point := newPos) next
    }

    internal transition reportX(expected : Int) {
        guard:
            pos.x = expected
        transit:
            pos := pos
    }

    // String field access in concatenation must type as Expr<SeqSort<CharSort>>
    // for ctx.mkConcat (otherwise Kotlin picks the BitVec overload).
    internal transition reportLabel(msg : String) {
        guard:
            msg = "label:" + pos.label
        transit:
            pos := pos
    }
}

proc FieldAccessTest := Worker

compile FieldAccessTest
