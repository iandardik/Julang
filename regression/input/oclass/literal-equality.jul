import julaylib.pclass.ExitSystem

o-class Point {
    x : Int
    y : Int
}

p-class Worker {
    var pos : Point
    var matched : Boolean

    constructor initially(args : List String) {
        transit:
            pos := Point { x := 5, y := 6 }
            matched := false
    }

    transition check() {
        guard:
            when (pos) {
                Point { x := 5, y := 6 } -> ~matched
                else -> false
            }
        transit:
            matched := true
    }

    p2p-consumer transition exitSystem() {
        guard:
            matched
    }
}

program LiteralEqualityTest := Worker || ExitSystem
