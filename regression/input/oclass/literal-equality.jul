import julaylib.pclass.ExitSystem

obj Point {
    x : Int
    y : Int
}

proc Worker {
    var pos : Point
    var matched : Boolean

    constructor initially(args : List<String>) {
        transit:
            pos := Point { x := 5, y := 6 }
            matched := false
    }

    internal transition check() {
        guard:
            when (pos) {
                Point { x := 5, y := 6 } -> ~matched
                else -> false
            }
        transit:
            matched := true
    }

    transition exitSystem() {
        guard:
            matched
    }
}

proc LiteralEqualityTest := Worker || ExitSystem

compile LiteralEqualityTest
