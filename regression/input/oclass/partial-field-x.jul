import julay.funlib.exitProgram

obj Point {
    x : Int
    y : Int
}

proc Worker {
    var pos : Point
    var steps : Int

    constructor initially(args : List<String>) {
        transit:
            steps := 0
            pos := Point { x := 0, y := 10 }
    }

    internal transition setX(newPos : Point) {
        guard:
            & newPos.x = 42
            & steps = 0
        transit:
            pos.x := newPos.x
            steps := 1
    }

    internal transition confirm() {
        guard:
            & pos.x = 42
            & pos.y = 10
            & steps = 1
        transit:
            steps := 2
    }

    internal transition exitSystem() {
        guard:
            steps = 2
        after:
            exitProgram(0)
    }
}

proc PartialFieldXTest := Worker

compile PartialFieldXTest
