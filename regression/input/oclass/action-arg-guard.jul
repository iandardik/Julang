import julay.funlib.exitProgram

obj Point {
    x : Int
    y : Int
}

proc Worker {
    var pos : Point
    var seen : Boolean

    constructor initially(args : List<String>) {
        transit:
            pos := Point { x := 0, y := 0 }
            seen := false
    }

    internal transition accept(target : Point) {
        guard:
            & target.x = 11
            & target.y = 22
            & ~seen
        transit:
            pos := target
            seen := true
    }

    internal transition exitSystem() {
        guard:
            & seen
            & pos.x = 11
            & pos.y = 22
        after:
            exitProgram(0)
    }
}

proc ActionArgGuardTest := Worker

compile ActionArgGuardTest
