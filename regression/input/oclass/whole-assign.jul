obj Point {
    x : Int
    y : Int
}

proc Worker {
    var pos : Point
    var steps : Int

    constructor initially(args : List<String>) {
        transit:
            steps := 0
            pos := Point { x := 0, y := 0 }
    }

    internal transition move(newPos : Point) {
        guard:
            steps < 2
        transit:
            pos := newPos
            steps := steps + 1
    }

    internal transition verify(newPos : Point) {
        guard:
            & steps = 2
            & pos.x = newPos.x
            & pos.y = newPos.y
        transit:
            steps := 3
    }

    internal transition exitSystem() {
        guard:
            steps = 3
        after:
            exitProcess()
    }
}

proc WholeAssignTest := Worker

compile WholeAssignTest
