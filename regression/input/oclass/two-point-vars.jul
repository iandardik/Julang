import julay.funlib.exitProgram

type Point {
    x : Int
    y : Int
}

proc Worker {
    var current : Point
    var backup : Point
    var steps : Int

    constructor initially(args : List<String>) {
        transit:
            steps := 0
            current := Point { x := 1, y := 2 }
            backup := Point { x := 9, y := 9 }
    }

    internal transition swap() {
        guard:
            steps = 0
        transit:
            backup := current
            current := Point { x := 9, y := 9 }
            steps := 1
    }

    internal transition restore() {
        guard:
            & steps = 1
            & current.x = 9
            & current.y = 9
        transit:
            current := backup
            steps := 2
    }

    internal transition exitSystem() {
        guard:
            & steps = 2
            & current.x = 1
            & current.y = 2
        after:
            exitProgram(0)
    }
}

proc TwoPointVarsTest := Worker

compile TwoPointVarsTest
