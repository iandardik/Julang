import julay.funlib.exitProgram
import julay.funlib.println

/*
 * Local ~done + arg equality — Context-free enablement + sync.
 */

static proc Sender {
    constructor initially(args : List<String>) {
        transit:
    }

    client transition handoff(x : Int) {
        guard: x = 9
    }
}

static proc Receiver {
    var k : Int
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            k := 9
            done := false
    }

    service transition handoff(x : Int) {
        guard:
            & x = k
            & ~done
        transit:
            done := true
        after:
            println("local-not got " + x)
    }

    internal transition exitSystem() {
        guard: done
        after:
            exitProgram(0)
    }
}

proc LocalNotAndEq := Sender || Receiver

compile LocalNotAndEq
