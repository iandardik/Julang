import julay.funlib.exitProgram
import julay.funlib.println

type Point {
    x : Int
    y : Int
}

proc Left {
    constructor initially(args : List<String>) {
        transit:
    }

    transition handoff(p : Point) {
        guard:
            & p.x = 1
            & p.y = 2
        // no print — keep stdout deterministic across schedules
    }
}

proc Right {
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            done := false
    }

    transition handoff(p : Point) {
        guard:
            & p.x = 1
            & p.y = 2
            & ~done
        transit:
            done := true
        after:
            println("R " + p.x + "," + p.y)
    }

    internal transition exitSystem() {
        guard: done
        after:
            exitProgram(0)
    }
}

proc EqOnlyStringOclass := Left || Right

compile EqOnlyStringOclass
