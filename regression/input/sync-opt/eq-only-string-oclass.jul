import julay.funlib.exitProgram
import julay.funlib.println

type Point {
    x : Int
    y : Int
}

static proc Left {
    constructor initially(args : List<String>) {
        transit:
    }

    client transition handoff(pt : Point) {
        guard:
            pt = Point { x := 1, y := 2 }
    }
}

static proc Right {
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            done := false
    }

    service transition handoff(pt : Point) {
        guard:
            & pt = Point { x := 1, y := 2 }
            & ~done
        transit:
            done := true
        after:
            println("R " + pt.x + "," + pt.y)
    }

    internal transition exitSystem() {
        guard: done
        after:
            exitProgram(0)
    }
}

proc EqOnlyStringOclass := Left || Right

compile EqOnlyStringOclass
