import julay.funlib.exitProgram
import julay.funlib.println

/*
 * Receiver filters on a sender-owned arg (n > 1 while sender binds n = 1) —
 * illegal direction under Go channel rules.
 */

proc A {
    constructor initially(args : List<String>) {
        transit:
    }

    client transition handoff(n : Int) {
        guard: n = 1
        after:
            println("A")
            exitProgram(0)
    }
}

static proc B {
    constructor initially(args : List<String>) {
        transit:
    }

    service transition handoff(n : Int) {
        guard: n > 1
        after:
            println("B")
            exitProgram(0)
    }
}

proc UnilateralMismatch := A || B

compile UnilateralMismatch
