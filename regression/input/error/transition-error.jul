import julay.funlib.exitProcess

proc S {
    var x : Int

    constructor initially(args : List<String>) {
        transit:
            x := 0
    }

    internal transition tick() {
        guard:
            true
        error:
            x = 0 -> "tick boom"
        transit:
            x := x + 1
        after:
            exitProcess()
    }
}

proc P := S

compile P
