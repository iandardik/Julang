import julaylib.pclass.Println

p-class Producer {
    var x : Int

    constructor initially() {
        transit:
            x := 0
    }

    p2p-consumer transition println(msg : String) {
        guard:
            true
        transit:
            x := x + 1
    }
}

p-class Other {
    var y : Int

    constructor initially() {
        transit:
            y := 0
    }

    p2p-consumer transition println(count : Int) {
        guard:
            true
        transit:
            y := y + 1
    }
}

program P := Producer || Other || Println
