import julaylib.pclass.Println

proc Producer {
    var x : Int

    constructor initially(args : List<String>) {
        transit:
            x := 0
    }

    transition println(msg : String) {
        guard:
            true
        transit:
            x := x + 1
    }
}

proc Other {
    var y : Int

    constructor initially(args : List<String>) {
        transit:
            y := 0
    }

    transition println(count : Int) {
        guard:
            true
        transit:
            y := y + 1
    }
}

proc P := Producer || Other || Println

compile P
