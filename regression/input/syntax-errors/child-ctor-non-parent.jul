static proc Boss {
    constructor initially(args : List<String>) {}
    transition done() {}
}

static proc Other {
    constructor initially(args : List<String>) {}
    transition start() {}
}

proc Worker {
    constructor start() {}
    return done() {}
}

/* Worker.start meets Other → parent Other; Worker.done meets Boss → conflicting parent. */
proc Sys := Boss || Other || Worker

compile Sys
