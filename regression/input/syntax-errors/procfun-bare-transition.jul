/*
 * Procfuns cannot declare `service` transitions (hubs stay outside procfuns).
 */
procfun bad(n : Int) : Int {
    var i : Int := 0

    service transition step() {
        transit: i := i + 1
    }

    transition done() {
        return: i
    }
}

proc Main {
    var x : Int
    constructor initially(args : List<String>) {
        transit: x := 0
    }
}

compile Main
