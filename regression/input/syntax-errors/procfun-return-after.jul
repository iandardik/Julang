procfun bad(n : Int) : Int {
    var i : Int := 0

    internal transition step() {
        transit: i := n
    }

    transition done() {
        return: i
        after:
            println("no")
    }
}

proc Main {
    var x : Int
    constructor initially(args : List<String>) {
        transit: x := 0
    }
}

compile Main
