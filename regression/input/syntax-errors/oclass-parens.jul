import julay.funlib.setOf
obj Message {
    msgType : String
}

proc Net {
    var messages : Set<Message> := setOf()

    constructor initially(args : List<String>) {}

    internal transition send() {
        transit:
            messages := messages + setOf(Message(
                msgType := "RequestVote"
            ))
    }
}

proc NetMain := Net

compile NetMain
