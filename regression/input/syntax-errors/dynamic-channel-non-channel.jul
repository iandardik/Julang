import julaylib.pclass.Println

p-class Bad {
    var n : Int
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            n := 0
            done := false
    }

    transition sendResponse<n>(resp : String) {
        guard: ~done & resp = "x"
        transit: done := true
    }

    transition println(msg : String) {
        guard: done & msg = "x"
    }
}

proc P := Bad || Println
program Main := P
