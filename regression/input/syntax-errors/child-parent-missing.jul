/*
 * Two dynamics offer the same non-ctor action with no orientation — illegal.
 * (Replaces the old "B<A> without A in composition" case.)
 */
proc Put {
    constructor put() {}
    transition broadcastClaim() {}
    return putDone() {}
}

proc ApplyMoveBatch {
    constructor moveBatch() {}
    transition broadcastClaim() {}
    return moveApplied() {}
}

proc Sys := Put || ApplyMoveBatch

compile Sys
