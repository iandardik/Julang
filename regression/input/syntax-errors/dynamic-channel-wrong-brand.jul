import julaylib.pclass.Println
import julaylib.fun.createEmptyChannel

p-class Bad {
    var httpChan : Channel<receiveResponse>
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            httpChan := createEmptyChannel<receiveResponse>()
            done := false
    }

    transition sendResponse<httpChan>(resp : String) {
        guard: ~done & resp = "x"
        transit: done := true
    }

    transition println(msg : String) {
        guard: done & msg = "x"
    }
}

proc P := Bad || Println
program Main := P
