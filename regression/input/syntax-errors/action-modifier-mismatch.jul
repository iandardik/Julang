p-class A {
    var x : Int

    constructor initially(args : List<String>) {
        transit:
            x := 0
    }

    internal transition tick() {
        transit:
            x := x + 1
    }
}

p-class B {
    var y : Int

    constructor initially(args : List<String>) {
        transit:
            y := 0
    }

    transition tick() {
        transit:
            y := y + 1
    }
}

program P := A || B
