proc A {
    var x : Int

    constructor initially(args : List<String>) {
        transit:
            x := 0
    }

    internal transition tick() {
        transit:
            x := x + 1
    }
}

proc B {
    var y : Int

    constructor initially(args : List<String>) {
        transit:
            y := 0
    }

    transition tick() {
        transit:
            y := y + 1
    }
}

proc P := A || B

compile P
