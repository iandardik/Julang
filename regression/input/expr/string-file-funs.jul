import julay.funlib.readFile
import julay.funlib.split
import julay.funlib.trim
import julay.funlib.portFromUrl
import julay.funlib.startsWith
import julay.funlib.length
import julay.funlib.exitProgram
import julay.funlib.println

proc StringFileDemo {
    var phase : Int
    var url : String
    var port : Int
    var line : String
    var path : String
    var n : Int

    constructor initially(args : List<String>) {
        transit:
            phase := 0
            url := "http://127.0.0.1:5001"
            port := 0
            line := "  # comment  "
            path := args[0]
            n := 0
    }

    internal transition checkPort() {
        guard:
            phase = 0
        transit:
            port := portFromUrl(url)
            phase := 1
    }

    internal transition checkTrim() {
        guard:
            phase = 1 & port = 5001
        transit:
            line := trim(line)
            phase := 2
    }

    internal transition checkStartsWith() {
        guard:
            phase = 2 & startsWith(line, "#")
        transit:
            phase := 3
    }

    internal transition checkSplit() {
        guard:
            phase = 3
        transit:
            n := length(split("a,b,c", ","))
            phase := 4
    }

    internal transition checkFile() {
        guard:
            phase = 4 & n = 3
        transit:
            line := trim(split(readFile(path), "\n")[0])
            phase := 5
    }

    internal transition done() {
        guard:
            phase = 5 & line = "hello-config"
        after:
            println(line + ":" + port)
            exitProgram(0)
    }
}

proc StringFileFunsTest := StringFileDemo

compile StringFileFunsTest
