import julay.funlib.exitProcess
import julay.funlib.println

proc S {
    var x : Int
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            x := 0
            print := true
    }

    internal transition bump() {
        guard:
            print & x = 0
        transit:
            x := let (x : Int := x + 1) x
            print := false
    }

    internal transition println(msg : String) {
        guard:
            ~print & (msg = x + "")
        transit:
            print := true
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            print & x > 0
        after:
            exitProcess()
    }
}

proc P := S

compile P
