import julay.funlib.exitProgram
import julay.funlib.println

static proc S {
    var x : Int
    var y : Int
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            x := 0
            y := 7
            print := true
    }

    internal transition branch() {
        guard:
            print & x = 0
        transit:
            if (x = 0) {
                x := 10
            } else {
                x := 20
            }
            if (x = 1) {
                y := 99
            }
            print := false
    }

    internal transition println(msg : String) {
        guard:
            ~print & (msg = x + "," + y)
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            ~print
        after:
            exitProgram(0)
    }
}

proc P := S

compile P
