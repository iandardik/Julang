import julaylib.pclass.Println
import julaylib.pclass.ExitSystem

fun double(n : Real) : Real = n + n

fun id<T>(x : T) : T = x

p-class S {
    var x : Real
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            x := 0.0
            print := false
    }

    transition increment(inc : Real) {
        guard:
            ~print & double(id(inc)) > 0.0 & (1 + 1.5 = 2.5)
        transit:
            x := 2.0
            print := true
    }

    p2p-consumer transition println(msg : String) {
        guard:
            print & (msg = x + "")
        transit:
            print := false
    }

    p2p-consumer transition exitSystem() {
        guard:
            ~print & x > 0.0
    }
}

p-class T {
    var x : Real

    constructor initially(args : List<String>) {
        transit:
            x := 0.0
    }

    transition increment(inc : Real) {
        guard:
            inc > 0.0 & x <= 10.0
        transit:
            x := x + inc
    }
}

program FunBasicTest := S || T || Println || ExitSystem
