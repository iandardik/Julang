p-class S {
    var step : String
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            step := "A"
            print := true
    }

    transition step() {
        guard:
            step = "A" | step = "B"
        transit:
            step := when {
                step = "A" -> "B"
                step = "B" -> "C"
                else -> "oops!"
            }
        effect:
            println(step)
    }

    transition exitSystem() {
        guard:
            step = "C"
        effect:
            exitProcess()
    }
}

program P := S
