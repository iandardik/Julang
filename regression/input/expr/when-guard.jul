import julay.funlib.exitProgram
import julay.funlib.println

proc S {
    var step : String
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            step := "A"
            print := true
    }

    internal transition step() {
        guard:
            step = "A" | step = "B"
        transit:
            step := when {
                step = "A" -> "B"
                step = "B" -> "C"
                else -> "oops!"
            }
        after:
            println(step)
    }

    internal transition exitSystem() {
        guard:
            step = "C"
        after:
            exitProgram(0)
    }
}

proc P := S

compile P
