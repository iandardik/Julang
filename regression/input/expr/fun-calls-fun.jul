import julaylib.pclass.Println
import julaylib.pclass.ExitSystem

fun add(x : Int, y : Int) : Int = x + y

fun double(n : Int) : Int = add(n, n)

proc S {
    var x : Int
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            x := 0
            print := false
    }

    transition increment(inc : Int) {
        guard:
            ~print & double(inc) > 0
        transit:
            x := double(inc)
            print := true
    }

    transition println(msg : String) {
        guard:
            print & (msg = x + "")
        transit:
            print := false
    }

    transition exitSystem() {
        guard:
            ~print & x > 0
    }
}

proc T {
    var x : Int

    constructor initially(args : List<String>) {
        transit:
            x := 0
    }

    transition increment(inc : Int) {
        guard:
            inc > 0 & x <= 10
        transit:
            x := x + inc
    }
}

proc FunCallsFunTest := S || T || Println || ExitSystem

compile FunCallsFunTest
