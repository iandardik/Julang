import julay.funlib.exitProgram
import julay.funlib.println

fun add(x : Int, y : Int) : Int = x + y

fun double(n : Int) : Int = add(n, n)

proc S {
    var x : Int
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            x := 0
            print := false
    }

    transition increment(inc : Int) {
        guard:
            ~print & double(inc) > 0
        transit:
            x := double(inc)
            print := true
    }

    internal transition println(msg : String) {
        guard:
            print & (msg = x + "")
        transit:
            print := false
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            ~print & x > 0
        after:
            exitProgram(0)
    }
}

proc T {
    var x : Int
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            x := 0
            done := false
    }

    transition increment(inc : Int) {
        guard:
            ~done & inc > 0 & x <= 10
        transit:
            x := x + inc
            done := true
    }
}

proc FunCallsFunTest := S || T

compile FunCallsFunTest
