import julay.funlib.parseInt
import julay.funlib.exitProgram
import julay.funlib.println

proc ParseIntDemo {
    const n : Int
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            n := parseInt(args[0])
            print := true
    }

    internal transition println(msg : String) {
        guard:
            print & (msg = n + "")
        transit:
            print := false
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            ~print & n = 42
        after:
            exitProgram(0)
    }
}

proc ParseIntTest := ParseIntDemo

compile ParseIntTest
