import julay.proclib.Println
import julay.proclib.ExitSystem
import julay.funlib.parseInt

proc ParseIntDemo {
    const n : Int
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            n := parseInt(args[0])
            print := true
    }

    transition println(msg : String) {
        guard:
            print & (msg = n + "")
        transit:
            print := false
    }

    transition exitSystem() {
        guard:
            ~print & n = 42
    }
}

proc ParseIntTest := ParseIntDemo || Println || ExitSystem

compile ParseIntTest
