import julaylib.pclass.Println
import julaylib.pclass.ExitSystem

p-class S {
    var key : String
    var x : Int
    var print : Boolean
    var numAssign : Int

    constructor initially(args : List<String>) {
        transit:
            key := "B"
            x := 0
            print := true
            numAssign := 0
    }

    transition assign() {
        guard:
            print & numAssign < 10
        transit:
            x := when (key) {
                "A" -> 1
                "B" -> 2
                else -> 0
            }
            print := false
            numAssign := numAssign + 1
    }

    p2p-consumer transition println(msg : String) {
        guard:
            ~print & (msg = x + "")
        transit:
            print := true
    }

    p2p-consumer transition exitSystem() {
        guard:
            print
    }
}

program P := S || Println || ExitSystem
