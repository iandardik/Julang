import julay.funlib.exitProgram
import julay.funlib.println

proc S {
    var key : String
    var x : Int
    var print : Boolean
    var numAssign : Int

    constructor initially(args : List<String>) {
        transit:
            key := "B"
            x := 0
            print := true
            numAssign := 0
    }

    internal transition assign() {
        guard:
            print & numAssign = 0
        transit:
            x := when (key) {
                "A" -> 1
                "B" -> 2
                else -> 0
            }
            print := false
            numAssign := numAssign + 1
    }

    internal transition println(msg : String) {
        guard:
            ~print & (msg = x + "")
        transit:
            print := true
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            print & numAssign > 0
        after:
            exitProgram(0)
    }
}

proc P := S

compile P
