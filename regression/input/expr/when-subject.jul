import julaylib.Println
import julaylib.ExitSystem

p-class S {
    var key : String
    var x : Int
    var print : Boolean

    constructor initially() {
        transit:
            key := "B"
            x := 0
            print := true
    }

    transition assign() {
        guard:
            print
        transit:
            x := when (key) {
                "A" -> 1
                "B" -> 2
                else -> 0
            }
            print := false
    }

    p2p-consumer transition println(msg : String) {
        guard:
            ~print & (msg = x + "")
        transit:
            print := true
    }

    p2p-consumer transition exitSystem() {
        guard:
            print
    }
}

program P := S || Println || ExitSystem
