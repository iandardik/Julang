import julay.funlib.exitProgram
import julay.funlib.println

proc S {
    var x : Int
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            x := 0
            print := false
    }

    transition increment(inc : Int) {
        guard:
            ~print & let (step : Int := inc + 1) step = 2 & x = 0
        transit:
            x := let (delta : Int := inc) x + delta
            print := true
    }

    internal transition println(msg : String) {
        guard:
            print & (msg = x + "")
        transit:
            print := false
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            ~print & x > 0
        after:
            exitProgram(0)
    }
}

proc T {
    var x : Int
    var done : Boolean

    constructor initially(args : List<String>) {
        transit:
            x := 0
            done := false
    }

    transition increment(inc : Int) {
        guard:
            ~done & inc > 0 & x <= 10
        transit:
            x := x + inc
            done := true
    }
}

proc P := S || T

compile P
