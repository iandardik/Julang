import julay.funlib.exitProgram
import julay.funlib.println
import julay.funlib.listOf

proc S {
    var x : Int
    var nested : List<List<Int>>
    var print : Boolean

    constructor initially(args : List<String>) {
        transit:
            x := let (inc : Int := 2) inc + 3
            nested := let (ys : List<List<Int>> := listOf(listOf(1), listOf(2, 3))) ys
            print := true
    }

    internal transition println(msg : String) {
        guard:
            print & (msg = x + "") & nested[1][0] = 2
        transit:
            print := false
        after:
            println(msg)
    }

    internal transition exitSystem() {
        guard:
            ~print
        after:
            exitProgram(0)
    }
}

proc P := S

compile P
