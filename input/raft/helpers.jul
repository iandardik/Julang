import julaylib.fun.length
import julaylib.fun.split
import julaylib.fun.startsWith
import types.Entry

fun isQuorum(n : Int, granted : Set<Int>) : Boolean =
    length(granted) * 2 > n

fun fieldValue(line : String) : String =
    split(line, "=")[1]

fun encodeRequestVote(term : Int, candidateId : Int, lastLogIndex : Int, lastLogTerm : Int) : String =
    "term=" + term + "|candidateId=" + candidateId + "|lastLogIndex=" + lastLogIndex + "|lastLogTerm=" + lastLogTerm

fun encodeRequestVoteResp(term : Int, voteGranted : Boolean) : String =
    "term=" + term + "|voteGranted=" + if (voteGranted) { "true" } else { "false" }

fun encodeAppendEntries(
    term : Int,
    leaderId : Int,
    prevLogIndex : Int,
    prevLogTerm : Int,
    entryTerm : Int,
    entryValue : String,
    entriesLen : Int,
    leaderCommit : Int
) : String =
    "term=" + term
        + "|leaderId=" + leaderId
        + "|prevLogIndex=" + prevLogIndex
        + "|prevLogTerm=" + prevLogTerm
        + "|entriesLen=" + entriesLen
        + "|entryTerm=" + entryTerm
        + "|entryValue=" + entryValue
        + "|leaderCommit=" + leaderCommit

fun encodeAppendEntriesResp(term : Int, success : Boolean, matchIndex : Int) : String =
    "term=" + term
        + "|success=" + if (success) { "true" } else { "false" }
        + "|matchIndex=" + matchIndex

fun isBlankOrComment(line : String) : Boolean =
    line = "" | startsWith(line, "#")

fun entryValueAt(log : List<Entry>, idx : Int) : String =
    let (e : Entry := log[idx]) { e.value }

fun parseBool(s : String) : Boolean =
    s = "true"
