import node.lib.Node
import julay.proclib.Timer
import julay.funlib.setOf

export api ElectionTimeout {
    proc: ElectionTimeoutImpl || Timer || AsyncStartElectionTimeout
    calls: gotHeartbeat, startElectionTimeout, stopElectionTimeout
}

/*
 * Starts ElectionTimeout for the given node and term.
 * Returns without blocking on the election timeout: a short-lived worker
 * completes the start asynchronously.
 * Safe to call from inside electionTimeout / updateTerm.
 */
procfun startElectionTimeout(self : Node, leaderTerm : Int) : Boolean {
    transition asyncStartElectionTimeout(me : Node, term : Int) {
        guard:
            & me = self
            & term = leaderTerm
        return: true
    }
}

procfun gotHeartbeat() : Boolean {
    transition resetElectionTimeout() {
        return: true
    }
}

procfun stopElectionTimeout(term : Int) : Boolean {
    transition stopElectionTimeout(t : Int) {
        guard:
            & t = term
        return: true
    }
}

/*
 * Short-lived worker spawned by startElectionTimeout. Syncs startElectionTimeout with
 * the single long-running ElectionTimeoutImpl (same pattern as AeSendWorker).
 */
proc AsyncStartElectionTimeout {
    const me : Node
    const term : Int
    var done : Boolean

    constructor asyncStartElectionTimeout(me : Node, term : Int) {
        transit:
            me := me
            term := term
            done := false
    }

    transition startElectionTimeout(me : Node, term : Int) {
        guard:
            & ~done
            & me = this.me
            & term = this.term
        transit:
            done := true
    }
}

proc ElectionTimeoutImpl {
    var selfNode : Node
    var leaderTerm : Int
    var electTimeout : Int
    var step : String

    /*
     * Idle init for the single long-running ElectionTimeoutImpl. Create the Timer
     * session once; later starts only call startTimer (session createTimer cannot
     * rebind on the same peer).
     */
    constructor startElectionTimeoutDriver() {
        transit:
            selfNode := Node { id := 0, url := "" }
            leaderTerm := 0
            electTimeout := 0
            step := "createTimer"
    }

    transition startElectionTimeout(me : Node, term : Int) {
        guard:
            // Include createTimer: startRaftCore may start before the driver session finishes.
            & step in setOf("done", "wait", "startTimer", "createTimer", "createThenStart")
        transit:
            selfNode := me
            leaderTerm := term
            // Paper recommends 150–300ms; Julay HTTP+sync RPCs need a larger window
            // so elections can finish before the next timeout. Stagger by node id.
            electTimeout := 1000 + 500 * (me.id - 1)
            // Re-start from wait cancels the live delay first; never re-createTimer.
            step := if (step = "wait") {
                "cancel"
            } else if (step in setOf("createTimer", "createThenStart")) {
                "createThenStart"
            } else {
                "startTimer"
            }
    }

    session transition createTimer() {
        guard:
            step in setOf("createTimer", "createThenStart")
        transit:
            // Session established once; start immediately if start raced the driver.
            step := if (step = "createThenStart") "startTimer" else "done"
    }

    session transition startTimer(time : Int) {
        guard:
            & step = "startTimer"
            & time = electTimeout
        transit:
            step := "wait"
    }

    session transition timeout() {
        guard:
            step = "wait"
        transit:
            step := "doTimeout"
    }

    transition resetElectionTimeout() {
        transit:
            step := if (step = "wait") "cancel" else step
    }

    transition stopElectionTimeout(t : Int) {
        guard:
            // Allow stop when already stopped (any term) so becomeLeader cannot
            // wait on a stale leaderTerm while an async start is still in flight.
            (step = "done") | (t = leaderTerm)
        transit:
            // Cancel a live wait so the Timer delay is torn down; otherwise stop.
            step := if (step = "wait") "cancelStop" else "done"
    }

    session transition cancelTimer() {
        guard:
            step in setOf("cancel", "cancelStop")
        transit:
            step := if (step = "cancelStop") "done" else "startTimer"
    }

    // Fire once, then stop (RaftProtocol re-starts via startElectionTimeout after term bump).
    transition electionTimeout() {
        guard:
            step = "doTimeout"
        transit:
            step := "done"
    }

    // Backstop: terminate enablement when RaftProtocol's term has moved on.
    client transition staleTerm(term : Int) {
        guard:
            & term = leaderTerm
            & step ~= "done"
        transit:
            step := if (step = "wait") "cancelStop" else "done"
    }
}
