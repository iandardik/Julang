import node.lib.Node
import julay.proclib.Timer

export api ElectionTimeout {
    proc: ElectionTimeoutImpl || Timer
    calls: gotHeartbeat, startElectionTimeout, stopElectionTimeout
}

procfun startElectionTimeout(self : Node, leaderTerm : Int) : Boolean {
    transition startElectionTimeout(me : Node, term : Int) {
        guard:
            & me = self
            & term = leaderTerm
        return: true
    }
}

procfun gotHeartbeat() : Boolean {
    transition resetElectionTimer() {
        return: true
    }
}

procfun stopElectionTimeout(term : Int) : Boolean {
    transition stopElectionTimeout(t : Int) {
        guard:
            & t = term
        return: true
    }
}

proc ElectionTimeoutImpl {
    const selfNode : Node
    const leaderTerm : Int
    const electTimeout : Int
    var step : String

    constructor startElectionTimeout(me : Node, term : Int) {
        transit:
            selfNode := me
            leaderTerm := term
            // Paper recommends 150–300ms; Julay HTTP+sync RPCs need a larger window
            // so elections can finish before the next timeout. Stagger by node id.
            electTimeout := 1000 + 500 * (me.id - 1)
            step := "createTimer"
    }

    session transition createTimer() {
        guard:
            step = "createTimer"
        transit:
            step := "startTimer"
    }

    session transition startTimer(time : Int) {
        guard:
            & step = "startTimer"
            & time = electTimeout
        transit:
            step := "wait"
    }

    session transition timeout() {
        guard:
            step = "wait"
        transit:
            step := "doTimeout"
    }

    transition resetElectionTimer() {
        guard:
            step ~= "done"
        transit:
            step := if (step = "wait") "cancel" else step
    }

    transition stopElectionTimeout(t : Int) {
        guard:
            & t = leaderTerm
            & step ~= "done"
        transit:
            step := "done"
    }

    session transition cancelTimer() {
        guard:
            step = "cancel"
        transit:
            step := "startTimer"
    }

    transition electionTimeout() {
        guard:
            step = "doTimeout"
        transit:
            step := "startTimer"
    }

    // terminate this proc once we detect a stale term
    client transition staleTerm(term : Int) {
        guard:
            & term = leaderTerm
            & step ~= "done"
        transit:
            step := "done"
    }
}