import julaylib.fun.length
import julaylib.fun.readFile
import julaylib.fun.split
import julaylib.fun.trim
import julaylib.fun.parseInt
import node.lib.isBlankOrComment
import node.lib.Node

/*
 * Static cluster config loading, HTTP listen-port startup, and outbound HttpClient startup.
 */

proc RaftInitializer {
    const path : String
    const selfId : Int
    var rawLines : List<String>
    var idx : Int
    var acc : List<String>
    var step : String

    constructor initially(args : List<String>) {
        transit:
            path := args[0]
            selfId := parseInt(args[1])
            rawLines := []
            idx := 0
            acc := []
            step := "load"
    }

    internal transition readConfig() {
        guard: step = "load"
        transit:
            rawLines := split(readFile(path), "\n")
            idx := 0
            acc := []
            step := "scan"
    }

    internal transition skipOrTake() {
        guard: step = "scan" & idx < length(rawLines)
        transit:
            acc := let (line : String := trim(rawLines[idx])) {
                if (isBlankOrComment(line)) { acc } else { acc + [line] }
            }
            idx := idx + 1
    }

    transition startClusterInfo(peerUrls : List<String>, id : Int) {
        guard:
            step = "scan" & idx = length(rawLines) & length(acc) > 0
            & peerUrls = acc & id = selfId
        transit: step := "startCore"
    }

    transition startRaftCore(id : Int, n : Int, url : String) {
        guard:
            & step = "startCore"
            & id = selfId
            & n = length(acc)
            & url = acc[selfId]
        transit: step := "done"
    }
}

proc ServerInitializer {
    var started : Boolean
    var myPort : Int

    constructor initially(args : List<String>) {
        transit:
            started := false
            myPort := 0
    }

    transition getListenPort(port : Int) {
        guard:
            & ~started
            & myPort = 0
        transit:
            myPort := port
        error:
            (port <= 0) -> "Invalid port passed to the server"
    }

    session transition createHttpServer(port : Int) {
        guard:
            & ~started
            & myPort > 0
            & port = myPort
        transit:
            started := true
    }

    session transition closeHttpServer() {
        guard: false
    }
}

proc ClientInitializer {
    var step : String

    constructor initially(args : List<String>) {
        transit:
            step := "createHttp"
    }

    session transition createHttpClient() {
        guard: step = "createHttp"
        transit: step := "startRpc"
    }

    session transition closeHttpClient() {
        guard: false
    }

    transition startClient() {
        guard: step = "startRpc"
        transit: step := "done"
    }
}

proc Initializers := RaftInitializer || ServerInitializer || ClientInitializer
