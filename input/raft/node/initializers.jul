import julaylib.fun.length
import julaylib.fun.readFile
import julaylib.fun.split
import julaylib.fun.trim
import julaylib.fun.parseInt
import julaylib.fun.createEmptyChannel
import julaylib.fun.createChannel
import node.lib.isBlankOrComment

/*
 * Static cluster config loading, HTTP listen-port startup, and outbound HttpClient startup.
 */

p-class RaftInitializer {
    const path : String
    const selfId : Int
    var rawLines : List<String>
    var idx : Int
    var acc : List<String>
    var step : String

    constructor initially(args : List<String>) {
        transit:
            path := args[0]
            selfId := parseInt(args[1])
            rawLines := []
            idx := 0
            acc := []
            step := "load"
    }

    internal transition readConfig() {
        guard: step = "load"
        transit:
            rawLines := split(readFile(path), "\n")
            idx := 0
            acc := []
            step := "scan"
    }

    internal transition skipOrTake() {
        guard: step = "scan" & idx < length(rawLines)
        transit:
            acc := let (line : String := trim(rawLines[idx])) {
                if (isBlankOrComment(line)) { acc } else { acc + [line] }
            }
            idx := idx + 1
    }

    transition startClusterInfo(peerUrls : List<String>, id : Int) {
        guard:
            step = "scan" & idx = length(rawLines) & length(acc) > 0
            & peerUrls = acc & id = selfId
        transit: step := "startCore"
    }

    transition startRaftCore(id : Int, n : Int) {
        guard:
            step = "startCore" & id = selfId & n = length(acc)
        transit: step := "startElection"
    }

    transition startElectionDriver(urls : List<String>, id : Int) {
        guard:
            step = "startElection" & urls = acc & id = selfId
        transit: step := "done"
    }
}

p-class ServerInitializer {
    var started : Boolean
    var myPort : Int
    var myCloseChan : Channel<closeHttpServer>

    constructor initially(args : List<String>) {
        transit:
            started := false
            myPort := 0
            myCloseChan := createEmptyChannel<closeHttpServer>()
    }

    transition getListenPort(port : Int) {
        guard: ~started
        transit: myPort := port
    }

    internal transition allocServerCloseChan() {
        guard: ~started & myPort > 0 & myCloseChan = createEmptyChannel<closeHttpServer>()
        transit: myCloseChan := createChannel<closeHttpServer>()
    }

    transition createHttpServer(port : Int, closeChan : Channel<closeHttpServer>) {
        guard: ~started & port = myPort & myPort > 0 & closeChan = myCloseChan
            & myCloseChan ~= createEmptyChannel<closeHttpServer>()
        transit: started := true
    }

    transition closeHttpServer<myCloseChan>() {
        guard: false
    }
}

p-class ClientInitializer {
    var step : String
    var myCloseChan : Channel<closeHttpClient>

    constructor initially(args : List<String>) {
        transit:
            step := "allocClose"
            myCloseChan := createEmptyChannel<closeHttpClient>()
    }

    internal transition allocClientCloseChan() {
        guard: step = "allocClose"
        transit:
            myCloseChan := createChannel<closeHttpClient>()
            step := "createHttp"
    }

    transition createHttpClient(closeChan : Channel<closeHttpClient>) {
        guard: step = "createHttp" & closeChan = myCloseChan
        transit: step := "startRpc"
    }

    transition closeHttpClient<myCloseChan>() {
        guard: false
    }

    transition startClient() {
        guard: step = "startRpc"
        transit: step := "done"
    }
}

proc Initializers := RaftInitializer || ServerInitializer || ClientInitializer
