import julay.funlib.split
import julay.funlib.parseInt
import node.lib.fieldValue
import node.lib.Node
import node.lib.encodeRequestVote
import node.lib.encodeRequestVoteResp
import node.lib.parseBool

/*
 * Incoming RequestVote RPC handler.
 */
export proc InRequestVoteRPC {
    var rvTerm : Int
    var rvCand : Int
    var rvLastIdx : Int
    var rvLastTerm : Int
    var respBody : String
    var step : String

    constructor startInRequestVoteRpc(req : HttpServerRequest) {
        transit:
            rvTerm := parseInt(fieldValue(split(req.body, "|")[0]))
            rvCand := parseInt(fieldValue(split(req.body, "|")[1]))
            rvLastIdx := parseInt(fieldValue(split(req.body, "|")[2]))
            rvLastTerm := parseInt(fieldValue(split(req.body, "|")[3]))
            respBody := ""
            step := "handle"
    }

    // TODO rename to: handleRequestVoteRequest
    transition receiveVoteRequest(
        inTerm : Int,
        candidateId : Int,
        lastLogIndex : Int,
        lastLogTerm : Int,
        outTerm : Int,
        voteGranted : Boolean
    ) {
        guard:
            & step = "handle"
            & inTerm = rvTerm
            & candidateId = rvCand
            & lastLogIndex = rvLastIdx
            & lastLogTerm = rvLastTerm
        transit:
            respBody := encodeRequestVoteResp(outTerm, voteGranted)
            step := "resp"
    }

    transition endIncomingRequestVote(resp : HttpServerResponse) {
        guard:
            & step = "resp"
            & resp = HttpServerResponse {
                body := respBody,
                code := 200
            }
        transit:
            step := "done"
    }
}
