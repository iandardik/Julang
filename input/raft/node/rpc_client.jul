import node.lib.Node

/* This RPC handles incoming client requests (append / get), not peer Raft RPCs. */
/*
 * Client command RPCs (append / get).
 *
 * One pclass for both commands so redirect stays coordinated with RaftCore + ClusterInfo.
 * Constructors keep the beginIncomingClientAppendRequest / beginIncomingClientGetRequest names.
 */

p-class IncomingClientRPC {
    const httpReq : HttpServerRequest
    const reqBody : String
    const kind : String
    var step : String
    var appendIdx : Int
    var respBody : String
    var respCode : Int
    var redirLeaderId : Int

    constructor beginIncomingClientAppendRequest(req : HttpServerRequest) {
        transit:
            httpReq := req
            reqBody := req.body
            kind := "append"
            appendIdx := 0
            respBody := ""
            respCode := 500
            redirLeaderId := -1
            step := "clientAppendRequest"
    }

    constructor beginIncomingClientGetRequest(req : HttpServerRequest) {
        transit:
            httpReq := req
            reqBody := req.body
            kind := "get"
            appendIdx := 0
            respBody := ""
            respCode := 500
            redirLeaderId := -1
            step := "clientGetRequest"
    }

    transition clientAppendRequest(value : String, ok : Boolean, idx : Int) {
        guard: step = "clientAppendRequest" & value = reqBody
        transit:
            appendIdx := idx
            step := if (ok) { "clientAppendRequestOk" } else { "redir" }
    }

    internal transition finishAppendOk() {
        guard: step = "clientAppendRequestOk"
        transit:
            respBody := "OK " + appendIdx
            respCode := 200
            step := "finishClientAppendRequest"
    }

    transition getSerializedStateMachine(serializedSM : String, isLeader : Boolean) {
        guard: step = "clientGetRequest"
        transit:
            respBody := serializedSM
            step := if (isLeader) { "clientGetRequestOk" } else { "redir" }
    }

    internal transition finishGetOk() {
        guard: step = "clientGetRequestOk"
        transit:
            respCode := 200
            step := "finishClientGetRequest"
    }

    transition getRedirectLeader(leaderIdOut : Int, hasLeader : Boolean) {
        guard: step = "redir"
        transit:
            redirLeaderId := leaderIdOut
            step := if (hasLeader) { "redirUrl" } else { "redirNone" }
    }

    transition lookupNodeById(id : Int, node : Node) {
        guard: step = "redirUrl" & id = redirLeaderId
        transit:
            respBody := "LEADER " + node.url
            respCode := 303
            step := if (kind = "append") { "finishClientAppendRequest" } else { "finishClientGetRequest" }
    }

    internal transition redirectNoLeader() {
        guard: step = "redirNone"
        transit:
            respBody := "NO_LEADER"
            respCode := 503
            step := if (kind = "append") { "finishClientAppendRequest" } else { "finishClientGetRequest" }
    }

    transition endIncomingClientAppendRequest(body : String, code : Int) {
        guard: step = "finishClientAppendRequest" & body = respBody & code = respCode
        transit: step := "done"
    }

    transition endIncomingClientGetRequest(body : String, code : Int) {
        guard: step = "finishClientGetRequest" & body = respBody & code = respCode
        transit: step := "done"
    }
}
