import julay.proclib.HttpClient

/*
 * Exactly one RpcClientHandler handles all outgoing RPCs.
*/
proc RpcClientHandler {
    var step : String
    var httpReq : HttpClientRequest
    var httpResp : HttpClientResponse

    constructor startRpcClient() {
        transit:
            step := "idle"
            url := ""
            body := ""
            respBody := ""
    }

    transition beginHttpRequestVote(peerUrl : String, reqBody : String) {
        guard: step = "idle"
        transit:
            url := peerUrl
            body := reqBody
            step := "sendRequestVote"
    }

    transition endHttpRequestVote(respOut : String) {
        guard: step = "endRequestVote" & respOut = respBody
        transit: step := "idle"
    }

    transition beginHttpAppendEntries(peerUrl : String, reqBody : String) {
        guard: step = "idle"
        transit:
            url := peerUrl
            body := reqBody
            step := "sendAppendEntries"
    }

    transition endHttpAppendEntries(respOut : String) {
        guard: step = "endAppendEntries" & respOut = respBody
        transit: step := "idle"
    }

    session transition sendRequest(req : HttpClientRequest) {
        guard:
            | (step = "sendRequestVote" & req = HttpClientRequest {
                url := url + "/raft/requestVote", method := "POST", body := body
            })
            | (step = "sendAppendEntries" & req = HttpClientRequest {
                url := url + "/raft/appendEntries", method := "POST", body := body
            })
        transit:
            step := if (step = "sendRequestVote") { "recvRequestVote" } else { "recvAppendEntries" }
    }

    session transition receiveResponse(resp : HttpClientResponse) {
        guard: step = "recvRequestVote" | step = "recvAppendEntries"
        transit:
            respBody := resp.body
            step := if (step = "recvRequestVote") { "endRequestVote" } else { "endAppendEntries" }
    }
}

export proc RpcClient := RpcClientHandler || HttpClient
