import node.lib.Node

/* This RPC handles incoming client requests (append / get), not peer Raft RPCs. */
/*
 * Client command RPCs (append / get).
 *
 * One pclass for both commands so redirect stays coordinated with RaftCore + ClusterInfo.
 * Constructors keep the startIncomingClientAppend / startIncomingClientGet names.
 */

p-class IncomingClientRPC {
    const httpReq : HttpServerRequest
    const reqBody : String
    const kind : String
    var step : String
    var appendIdx : Int
    var respBody : String
    var respCode : Int
    var redirLeaderId : Int

    constructor startIncomingClientAppend(req : HttpServerRequest) {
        transit:
            httpReq := req
            reqBody := req.body
            kind := "append"
            appendIdx := 0
            respBody := ""
            respCode := 500
            redirLeaderId := -1
            step := "ca"
    }

    constructor startIncomingClientGet(req : HttpServerRequest) {
        transit:
            httpReq := req
            reqBody := req.body
            kind := "get"
            appendIdx := 0
            respBody := ""
            respCode := 500
            redirLeaderId := -1
            step := "cg"
    }

    transition clientAppend(value : String, ok : Boolean, idx : Int) {
        guard: step = "ca" & value = reqBody
        transit:
            appendIdx := idx
            step := if (ok) { "caOk" } else { "redir" }
    }

    internal transition finishAppendOk() {
        guard: step = "caOk"
        transit:
            respBody := "OK " + appendIdx
            respCode := 200
            step := "finishCA"
    }

    transition getSerializedStateMachine(serializedSM : String, isLeader : Boolean) {
        guard: step = "cg"
        transit:
            respBody := serializedSM
            step := if (isLeader) { "cgOk" } else { "redir" }
    }

    internal transition finishGetOk() {
        guard: step = "cgOk"
        transit:
            respCode := 200
            step := "finishCG"
    }

    transition getRedirectLeader(leaderIdOut : Int, hasLeader : Boolean) {
        guard: step = "redir"
        transit:
            redirLeaderId := leaderIdOut
            step := if (hasLeader) { "redirUrl" } else { "redirNone" }
    }

    transition lookupNodeById(id : Int, node : Node) {
        guard: step = "redirUrl" & id = redirLeaderId
        transit:
            respBody := "LEADER " + node.url
            respCode := 303
            step := if (kind = "append") { "finishCA" } else { "finishCG" }
    }

    internal transition redirectNoLeader() {
        guard: step = "redirNone"
        transit:
            respBody := "NO_LEADER"
            respCode := 503
            step := if (kind = "append") { "finishCA" } else { "finishCG" }
    }

    transition finishIncomingClientAppend(body : String, code : Int) {
        guard: step = "finishCA" & body = respBody & code = respCode
        transit: step := "done"
    }

    transition finishIncomingClientGet(body : String, code : Int) {
        guard: step = "finishCG" & body = respBody & code = respCode
        transit: step := "done"
    }
}
