/* This RPC handles incoming client requests (append / get), not peer Raft RPCs. */
/*
 * Client command RPCs (append / get).
 *
 * One pclass for both commands so getRedirectBody stays CSP size 2 with RaftCore
 * (two separate pclasses sharing getRedirectBody would require a 3-way sync and deadlock).
 * Constructors keep the startIncomingClientAppend / startIncomingClientGet names.
 */

p-class IncomingClientRPC {
    const httpReq : HttpServerRequest
    const reqBody : String
    const kind : String
    var step : String
    var appendIdx : Int
    var respBody : String
    var respCode : Int

    constructor startIncomingClientAppend(req : HttpServerRequest) {
        transit:
            httpReq := req
            reqBody := req.body
            kind := "append"
            appendIdx := 0
            respBody := ""
            respCode := 500
            step := "ca"
    }

    constructor startIncomingClientGet(req : HttpServerRequest) {
        transit:
            httpReq := req
            reqBody := req.body
            kind := "get"
            appendIdx := 0
            respBody := ""
            respCode := 500
            step := "cg"
    }

    transition clientAppend(value : String, ok : Boolean, idx : Int) {
        guard: step = "ca" & value = reqBody
        transit:
            appendIdx := idx
            step := if (ok) { "caOk" } else { "redir" }
    }

    transition finishAppendOk() {
        guard: step = "caOk"
        transit:
            respBody := "OK " + appendIdx
            respCode := 200
            step := "finishCA"
    }

    p2p-consumer transition getSerializedStateMachine(serializedSM : String, isLeader : Boolean) {
        guard: step = "cg"
        transit:
            respBody := serializedSM
            step := if (isLeader) { "cgOk" } else { "redir" }
    }

    transition finishGetOk() {
        guard: step = "cgOk"
        transit:
            respCode := 200
            step := "finishCG"
    }

    p2p-consumer transition getRedirectBody(body : String, code : Int) {
        guard: step = "redir"
        transit:
            respBody := body
            respCode := code
            step := if (kind = "append") { "finishCA" } else { "finishCG" }
    }

    transition finishIncomingClientAppend(body : String, code : Int) {
        guard: step = "finishCA" & body = respBody & code = respCode
        transit: step := "done"
    }

    transition finishIncomingClientGet(body : String, code : Int) {
        guard: step = "finishCG" & body = respBody & code = respCode
        transit: step := "done"
    }
}
