import node.lib.Node
import julay.funlib.delaySeconds

/*
 * Follower-side election timeout. Records an "election epoch" from RaftCore, sleeps for the
 * timeout period, then checks whether the epoch is still fresh; if so it asks RaftCore to start
 * an election (RaftCore then spawns CandidateElection), otherwise it restarts and sleeps again.
 */
proc FollowerHeartbeat {
    const selfNode : Node
    const clusterSize : Int
    const electTimeout : Int
    var step : String
    var currentEpoch : Int

    constructor startFollowerHeartbeat(me : Node, n : Int) {
        transit:
            selfNode := me
            clusterSize := n
            electTimeout := 2 + me.id
            step := "start"
            currentEpoch := 0
    }

    transition getElectionSnapshot(
        epoch : Int,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastT : Int,
        role : String
    ) {
        guard:
            | step = "start"
            | step = "checkForHeartbeat"
        transit:
            currentEpoch := if (step = "start") { epoch } else { currentEpoch }
            step := when {
                // sleep for a "random" amount of time before checking for a leader heartbeat
                (step = "start") -> "sleep"

                // if the epoch hasn't changed then no leader heartbeat has been seen: start the election
                (epoch = currentEpoch) -> "doElect"

                // if the epoch has changed then we received a leader heartbeat
                else -> "start"
            }
    }

    // TODO add a Timer pclass so this pclass doesn't have to block while waiting
    /* Wait for a leader to send a heartbeat */
    internal transition waitForHeartbeat() {
        guard:
            step = "sleep"
        transit:
            step := "checkForHeartbeat"
        after:
            delaySeconds(electTimeout)
    }

    /* Pairwise with RaftCore: become candidate; this instance ends (Core spawns CandidateElection). */
    transition becomeCandidate(
        epoch : Int,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastT : Int
    ) {
        guard:
            & step = "doElect"
            & epoch = currentEpoch
        transit:
            step := "done"
    }
}
