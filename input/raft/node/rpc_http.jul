/*
 * HTTP endpoints for Raft node RPCs: inbound listener (RpcServer) and
 * outbound client bridge (RpcClient). Typed RPC pclasses live in
 * rpc_vote / rpc_append_entries / rpc_client.
 *
 * Incoming RPCs are not globally mutexed: each request gets its own
 * RpcServer, so concurrent inbound handlers may overlap. Outgoing RPCs
 * are serialized through RpcClient (at most one outbound send/recv in
 * flight). An inbound and an outbound RPC may run at the same time (this
 * just happens to be the case — it is not required for correctness).
 */

proc RpcServer {
    const httpReq : HttpServerRequest
    const path : String
    const reqBody : String
    var step : String
    var respBody : String
    var respCode : Int

    session constructor receiveRequest(req : HttpServerRequest) {
        transit:
            httpReq := req
            path := req.path
            reqBody := req.body
            respBody := ""
            respCode := 500
            step := when (req.path) {
                "raft/requestVote" -> "beginRequestVote"
                "raft/appendEntries" -> "beginAppendEntries"
                "client/append" -> "beginClientAppendRequest"
                "client/get" -> "beginClientGetRequest"
                else -> "bad"
            }
    }

    session transition sendResponse(resp : HttpServerResponse) {
        guard: step = "resp" & resp = HttpServerResponse { body := respBody, code := respCode }
        transit: step := "done"
    }

    transition beginIncomingRequestVote(req : HttpServerRequest) {
        guard: step = "beginRequestVote" & req = httpReq
        transit: step := "awaitRequestVote"
    }

    transition endIncomingRequestVote(body : String, code : Int) {
        guard: step = "awaitRequestVote"
        transit:
            respBody := body
            respCode := code
            step := "resp"
    }

    transition beginIncomingAppendEntries(req : HttpServerRequest) {
        guard: step = "beginAppendEntries" & req = httpReq
        transit: step := "awaitAppendEntries"
    }

    transition endIncomingAppendEntries(body : String, code : Int) {
        guard: step = "awaitAppendEntries"
        transit:
            respBody := body
            respCode := code
            step := "resp"
    }

    transition beginIncomingClientAppendRequest(req : HttpServerRequest) {
        guard: step = "beginClientAppendRequest" & req = httpReq
        transit: step := "awaitClientAppendRequest"
    }

    transition endIncomingClientAppendRequest(body : String, code : Int) {
        guard: step = "awaitClientAppendRequest"
        transit:
            respBody := body
            respCode := code
            step := "resp"
    }

    transition beginIncomingClientGetRequest(req : HttpServerRequest) {
        guard: step = "beginClientGetRequest" & req = httpReq
        transit: step := "awaitClientGetRequest"
    }

    transition endIncomingClientGetRequest(body : String, code : Int) {
        guard: step = "awaitClientGetRequest"
        transit:
            respBody := body
            respCode := code
            step := "resp"
    }

    internal transition badPath() {
        guard: step = "bad"
        transit:
            respBody := "NOT_FOUND"
            respCode := 404
            step := "resp"
    }
}

proc RpcClient {
    var step : String
    var url : String
    var body : String
    var respBody : String

    constructor startClient() {
        transit:
            step := "idle"
            url := ""
            body := ""
            respBody := ""
    }

    transition beginHttpRequestVote(peerUrl : String, reqBody : String) {
        guard: step = "idle"
        transit:
            url := peerUrl
            body := reqBody
            step := "sendRequestVote"
    }

    transition endHttpRequestVote(respOut : String) {
        guard: step = "endRequestVote" & respOut = respBody
        transit: step := "idle"
    }

    transition beginHttpAppendEntries(peerUrl : String, reqBody : String) {
        guard: step = "idle"
        transit:
            url := peerUrl
            body := reqBody
            step := "sendAppendEntries"
    }

    transition endHttpAppendEntries(respOut : String) {
        guard: step = "endAppendEntries" & respOut = respBody
        transit: step := "idle"
    }

    session transition sendRequest(req : HttpClientRequest) {
        guard:
            | (step = "sendRequestVote" & req = HttpClientRequest {
                url := url + "/raft/requestVote", method := "POST", body := body
            })
            | (step = "sendAppendEntries" & req = HttpClientRequest {
                url := url + "/raft/appendEntries", method := "POST", body := body
            })
        transit:
            step := if (step = "sendRequestVote") { "recvRequestVote" } else { "recvAppendEntries" }
    }

    session transition receiveResponse(resp : HttpClientResponse) {
        guard: step = "recvRequestVote" | step = "recvAppendEntries"
        transit:
            respBody := resp.body
            step := if (step = "recvRequestVote") { "endRequestVote" } else { "endAppendEntries" }
    }
}
