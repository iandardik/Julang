import julay.funlib.length
import julay.funlib.delaySeconds
import node.lib.Node
import node.lib.AppendEntriesData
import node.rpc_out.RpcOut

procfun startLeaderHeartbeat(self : Node, leaderTerm : Int, theCluster : List<Node>) : Boolean {
    transition startLeaderHeartbeat(me : Node, term : Int, cluster : List<Node>) {
        guard:
            & me = self
            & term = leaderTerm
            & cluster = theCluster
        return: true
    }
}

proc LeaderHeartbeatImpl {
    const me : Node
    const leaderTerm : Int
    const cluster : List<Node>
    var step : String
    var sentThisRound : Set<Node>

    constructor startLeaderHeartbeat(me : Node, term : Int, cluster : List<Node>) {
        transit:
            me := me
            leaderTerm := term
            cluster := cluster
            step := "sleep"
            sentThisRound := {me}
    }

    internal transition sleep() {
        guard: step = "sleep"
        transit: step := "pickTarget"
        after: delaySeconds(1)
    }

    transition appendEntries(target : Node, payload : AppendEntriesData) {
        guard:
            & step = "pickTarget"
            & ~(target in sentThisRound)
        transit:
            // TODO this should probably be asynchronous
            let _ : Boolean := RpcOut.outAppendEntriesRPC(target, payload)
            let newSentThisRound : Set<Node> := sentThisRound + {target}
            sentThisRound := if (length(newSentThisRound) = length(cluster)) { {me} } else { newSentThisRound }
            step := "sleep"
    }

    // terminate this proc once we detect a stale term
    client transition staleTerm(term : Int) {
        guard:
            term = leaderTerm
        transit:
            step := "done"
    }
}

export api LeaderHeartbeat {
    proc: LeaderHeartbeatImpl
    calls: startLeaderHeartbeat
}
