import julay.funlib.length
import node.lib.Node
import node.lib.AppendEntriesData
import node.lib.Entry
import node.rpc_out.RpcOut
import julay.funlib.setOf
import julay.proclib.Timer

export api LeaderHeartbeat {
    proc: LeaderHeartbeatImpl || AeSendWorker || Timer
    calls: startLeaderHeartbeat, eagerReplication, stopLeaderHeartbeat
}

procfun startLeaderHeartbeat(self : Node, leaderTerm : Int, theCluster : Set<Node>) : Boolean {
    transition startHeartbeat(me : Node, term : Int, cluster : Set<Node>) {
        guard:
            & me = self
            & term = leaderTerm
            & cluster = theCluster
        return: true
    }
}

/*
 * Cancel an idle heartbeat wait so a new client append is replicated immediately.
 * No-op when not waiting on the timer (mid-round / checking log).
 */
procfun eagerReplication() : Boolean {
    transition wakeForReplication() {
        return: true
    }
}

procfun stopLeaderHeartbeat() : Boolean {
    transition stopHeartbeat() {
        return: true
    }
}

/*
 * Short-lived per-peer sender: awaits RpcOut (pool slot) while LeaderHeartbeatImpl
 * continues dispatching other followers.
 */
proc AeSendWorker {
    const peer : Node
    const data : AppendEntriesData
    var done : Boolean

    constructor startAeSend(peer : Node, data : AppendEntriesData) {
        transit:
            peer := peer
            data := data
            done := false
    }

    internal transition send() {
        guard: ~done
        transit:
            let _ : Boolean := RpcOut.outAppendEntriesRPC(peer, data)
            done := true
    }
}

proc LeaderHeartbeatImpl {
    var me : Node
    var leaderTerm : Int
    var cluster : Set<Node>
    var heartbeatMs : Int
    var step : String
    var sentThisRound : Set<Node>
    var pendingPeer : Node
    var pendingData : AppendEntriesData

    /*
     * Idle init for the single long-running LeaderHeartbeatImpl. Create the Timer
     * session once; startHeartbeat never re-invokes createTimer (session
     * constructors cannot rebind).
     */
    constructor startLeaderHeartbeatDriver() {
        transit:
            me := Node { id := 0, url := "" }
            leaderTerm := 0
            cluster := setOf()
            heartbeatMs := 200
            step := "createTimer"
            sentThisRound := setOf()
            pendingPeer := Node { id := 0, url := "" }
            pendingData := AppendEntriesData {
                term := 0,
                leaderId := 0,
                prevLogIndex := 0,
                prevLogTerm := 0,
                entry := Entry { term := 0, value := "" },
                entriesLen := 0,
                leaderCommit := 0
            }
    }

    transition startHeartbeat(me : Node, term : Int, cluster : Set<Node>) {
        guard:
            // Include createTimer: becomeLeader may race the driver session.
            step in setOf("done", "wait", "createTimer", "createThenStart")
        transit:
            me := me
            leaderTerm := term
            cluster := cluster
            heartbeatMs := 200
            sentThisRound := setOf(me)
            pendingPeer := me
            pendingData := AppendEntriesData {
                term := 0,
                leaderId := 0,
                prevLogIndex := 0,
                prevLogTerm := 0,
                entry := Entry { term := 0, value := "" },
                entriesLen := 0,
                leaderCommit := 0
            }
            // Re-start from wait cancels the delay first; never re-createTimer.
            step := if (step = "wait") {
                "cancelRestart"
            } else if (step in setOf("createTimer", "createThenStart")) {
                "createThenStart"
            } else {
                "pickTarget"
            }
    }

    transition stopHeartbeat() {
        transit:
            step := if (step = "wait") "cancelStop" else "done"
    }

    session transition createTimer() {
        guard:
            step in setOf("createTimer", "createThenStart")
        transit:
            // Session established once; start immediately if becomeLeader raced the driver.
            step := if (step = "createThenStart") "pickTarget" else "done"
    }

    session transition startTimer(time : Int) {
        guard:
            & step = "startTimer"
            & time = heartbeatMs
        transit:
            step := "wait"
    }

    session transition timeout() {
        guard:
            step = "wait"
        transit:
            step := "pickTarget"
    }

    transition wakeForReplication() {
        transit:
            step := if (step = "wait") "cancel" else step
    }

    session transition cancelTimer() {
        guard:
            step in setOf("cancel", "cancelStop", "cancelRestart")
        transit:
            step := if (step = "cancelStop") {
                "done"
            } else if (step = "cancelRestart") {
                "pickTarget"
            } else {
                "pickTarget"
            }
    }

    // Sync with RaftProtocol only — do not await HTTP here.
    transition appendEntries(target : Node, payload : AppendEntriesData) {
        guard:
            & step = "pickTarget"
            & ~(target in sentThisRound)
        transit:
            pendingPeer := target
            pendingData := payload
            step := "dispatch"
    }

    // Self-sync + spawn AeSendWorker; mark peer contacted for this round.
    transition startAeSend(peer : Node, data : AppendEntriesData) {
        guard:
            & step = "dispatch"
            & peer = pendingPeer
            & data = pendingData
        transit:
            let newSentThisRound : Set<Node> := sentThisRound + setOf(peer)
            sentThisRound := if (length(newSentThisRound) = length(cluster)) setOf(me) else newSentThisRound
            step := if (length(newSentThisRound) = length(cluster)) "checkLogOutdated" else "pickTarget"
    }

    // Ask RaftProtocol whether any follower is still behind the log.
    transition logOutdated(outdated : Boolean) {
        guard:
            step = "checkLogOutdated"
        transit:
            step := if (outdated) "pickTarget" else "startTimer"
    }

    // Backstop when RaftProtocol's term has moved on.
    client transition staleTerm(term : Int) {
        guard:
            & term = leaderTerm
            & step ~= "done"
        transit:
            step := if (step = "wait") "cancelStop" else "done"
    }
}
