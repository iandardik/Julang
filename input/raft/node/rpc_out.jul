import julay.funlib.split
import julay.funlib.parseInt
import node.lib.Node
import node.lib.AppendEntriesData
import node.lib.fieldValue
import node.lib.encodeRequestVote
import node.lib.encodeAppendEntries
import node.lib.parseBool
import julay.funlib.httpRequest

export api RpcOut {
    proc: RpcOutCaller
    calls: outRequestVoteRPC, outAppendEntriesRPC
}

procfun outRequestVoteRPC(
    peer : Node,
    payload : VoteRequestData
) : Boolean {
    var step : String
    var responseTerm : Int
    var grantedFlag : Boolean

    constructor sendRpc() {
        transit:
            let resp : HttpClientResponse := RpcOutCaller.rpcOutClientCaller(HttpClientRequest {
                url := peer.url + "/raft/requestVote",
                method := "POST",
                body := encodeRequestVote(payload)
            })
            step := if (resp.code = 200) "updateTerm" else "rpcFailed"
            responseTerm := if (resp.code = 200) parseInt(fieldValue(split(resp.body, "|")[1])) else 0
            grantedFlag := if (resp.code = 200) parseBool(fieldValue(split(resp.body, "|")[2])) else false
    }

    internal transition rpcFailed() {
        guard: step = "rpcFailed"
        return: false
    }

    client transition updateTerm(inTerm : Int) {
        guard:
            & step = "updateTerm"
            & inTerm = responseTerm
        transit:
            step := "handleResponse"
    }

    client transition handleRequestVoteResponse(peer : Node, term : Int, granted : Boolean) {
        guard:
            & step = "handleResponse"
            & peer = this.peer
            & term = responseTerm
            & granted = grantedFlag
        return:
            grantedFlag
    }

    client transition dropStaleResponse(respTerm : Int, drop : Boolean) {
        guard:
            & step = "handleResponse"
            & respTerm = responseTerm
            & drop
        return:
            false
    }
}

procfun outAppendEntriesRPC(peer : Node, data : AppendEntriesData) : Boolean {
    var step : String
    var responseTerm : Int
    var successFlag : Boolean
    var matchIdxVal : Int
    var conflictTermVal : Int

    constructor sendRpc() {
        transit:
            let resp : HttpClientResponse := RpcOutCaller.rpcOutClientCaller(HttpClientRequest {
                url := peer.url + "/raft/appendEntries",
                method := "POST",
                body := encodeAppendEntries(data)
            })
            step := if (resp.code = 200) "updateTerm" else "rpcFailed"
            responseTerm := if (resp.code = 200) parseInt(fieldValue(split(resp.body, "|")[1])) else 0
            successFlag := if (resp.code = 200) parseBool(fieldValue(split(resp.body, "|")[2])) else false
            matchIdxVal := if (resp.code = 200) parseInt(fieldValue(split(resp.body, "|")[3])) else 0
            conflictTermVal := if (resp.code = 200) parseInt(fieldValue(split(resp.body, "|")[4])) else 0
    }

    internal transition rpcFailed() {
        guard: step = "rpcFailed"
        return: false
    }

    client transition updateTerm(inTerm : Int) {
        guard:
            & step = "updateTerm"
            & inTerm = responseTerm
        transit:
            step := "handleResponse"
    }

    client transition handleAppendEntriesResponse(
        peer : Node,
        inTerm : Int,
        success : Boolean,
        matchIdx : Int,
        conflictTerm : Int
    ) {
        guard:
            & step = "handleResponse"
            & peer = this.peer
            & inTerm = responseTerm
            & success = successFlag
            & matchIdx = matchIdxVal
            & conflictTerm = conflictTermVal
        return:
            successFlag
    }

    client transition dropStaleResponse(respTerm : Int, drop : Boolean) {
        guard:
            & step = "handleResponse"
            & respTerm = responseTerm
            & drop
        return:
            false
    }
}


/*
 * Outbound HTTP pool: N RpcOutWorkers share sendRpcOut / responseRpcOut.
 * rpcOutClientCaller borrows any idle worker.
 */

api RpcOutCaller {
    proc: RpcOutPool || RpcOutWorker
    calls: rpcOutClientCaller
}

procfun rpcOutClientCaller(rpcReq : HttpClientRequest) : HttpClientResponse {
    var step : String := "send"

    transition sendRpcOut(req : HttpClientRequest) {
        guard:
            & step = "send"
            & req = rpcReq
        transit:
            step := "recv"
    }

    transition responseRpcOut(resp : HttpClientResponse) {
        guard:
            step = "recv"
        return:
            resp
    }
}

proc RpcOutPool {
    var remaining : Int
    var step : String

    constructor startRpcOut(poolSize : Int) {
        transit:
            remaining := poolSize
            step := "spawn"
        error:
            (poolSize < 1) -> "RpcOut poolSize must be >= 1"
    }

    // Self-sync + spawn one RpcOutWorker per firing while remaining > 0.
    transition startRpcOutWorker() {
        guard:
            & step = "spawn"
            & remaining > 0
        transit:
            remaining := remaining - 1
            step := if (remaining = 0) "done" else "spawn"
    }
}

proc RpcOutWorker {
    var step : String
    var httpResp : HttpClientResponse

    constructor startRpcOutWorker() {
        transit:
            step := "idle"
            httpResp := HttpClientResponse {
                code := 0,
                body := ""
            }
    }

    transition sendRpcOut(req : HttpClientRequest) {
        guard:
            step = "idle"
        transit:
            httpResp := httpRequest(req)
            step := "recv"
    }

    transition responseRpcOut(resp : HttpClientResponse) {
        guard:
            & step = "recv"
            & resp = httpResp
        transit:
            step := "idle"
    }
}
