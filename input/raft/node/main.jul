import julay.funlib.length
import julay.funlib.max
import julay.funlib.portFromUrl
import julay.funlib.readFile
import julay.funlib.split
import julay.funlib.trim
import julay.funlib.parseInt
import node.core.RaftCore
import node.lib.isBlankOrComment
import node.lib.Node
import node.rpc_in.RpcIn
import node.rpc_out.RpcOut
import julay.proclib.Timer
import node.election_timeout.ElectionTimeout
import node.leader_heartbeat.LeaderHeartbeat
import node.vote_requester.VoteRequester
import julay.funlib.listOf

export proc Raft := RaftNodeMain || RaftCore
export proc NodeLogic := Raft

type CfgPair {
    me : Node
    cluster : Set<Node>
}

procfun parseCfg(cfg : String, myIdx : Int) : CfgPair {
    var rawLines : List<String> := split(readFile(cfg), "\n")
    var idx : Int := 1
    var entryIdx : Int := 1
    var meBuilder : Node := Node { id := 0, url := "" }
    var clusterBuilder : List<Node> := listOf()

    internal transition parseAndBuildCluster() {
        guard:
            idx <= length(rawLines)
        transit:
            let line : String := trim(rawLines[idx])
            let isEntry : Boolean := ~isBlankOrComment(line)
            let isMyNode : Boolean := isEntry & entryIdx = myIdx
            let nextNode : Node := Node { id := entryIdx, url := line }
            meBuilder := if (isMyNode) {
                nextNode
            } else {
                meBuilder
            }
            clusterBuilder := if (isEntry) {
                clusterBuilder + listOf(nextNode)
            } else {
                clusterBuilder
            }
            entryIdx := if (isEntry) entryIdx + 1 else entryIdx
            idx := idx + 1
    }

    internal transition endParse() {
        guard:
            idx = length(rawLines) + 1
        return:
            CfgPair { me := meBuilder, cluster := clusterBuilder.toSet() }
    }
}

proc RaftNodeMain {
    const me : Node
    const cluster : Set<Node>
    const port : Int
    var step : String := "startRpcIn"

    constructor initially(args : List<String>) {
        transit:
            let id : Int := parseInt(args[2])
            let cfg : CfgPair := parseCfg(args[1], id)
            me := cfg.me
            cluster := cfg.cluster
            port := portFromUrl(cfg.me.url)
        error:
            (length(args) ~= 2) -> "usage: RaftNode.jar <config_file> <node_id>"
    }

    transition startRpcIn(port : Int) {
        guard:
            & step = "startRpcIn"
            & port = this.port
        transit:
            step := "startRpcOut"
    }

    transition startRpcOut(poolSize : Int) {
        guard:
            & step = "startRpcOut"
            & poolSize = max(2, length(cluster) - 1)
        transit:
            step := "startElectionTimeoutDriver"
    }

    // Construct the long-running ElectionTimeoutImpl (idle); started later via startElectionTimeout.
    transition startElectionTimeoutDriver() {
        guard:
            step = "startElectionTimeoutDriver"
        transit:
            step := "startLeaderHeartbeatDriver"
    }

    // Construct the long-running LeaderHeartbeatImpl (idle); started on becomeLeader.
    transition startLeaderHeartbeatDriver() {
        guard:
            step = "startLeaderHeartbeatDriver"
        transit:
            step := "startCore"
    }

    transition startRaftCore(me : Node, cluster : Set<Node>) {
        guard:
            & step = "startCore"
            & me = this.me
            & cluster = this.cluster
        transit:
            step := "startVoteRequester"
    }

    transition startVoteRequester() {
        guard:
            step = "startVoteRequester"
        transit:
            step := "done"
    }
}