import julay.funlib.length
import julay.funlib.portFromUrl
import julay.funlib.readFile
import julay.funlib.split
import julay.funlib.trim
import julay.funlib.parseInt
import node.core.RaftCore
import node.lib.isBlankOrComment
import node.lib.Node
import node.rpc_in.RpcIn
import node.rpc_out.RpcOut
import julay.proclib.Timer
import node.election_timeout.ElectionTimeout
import node.leader_heartbeat.LeaderHeartbeat
import node.vote_requester.VoteRequester

obj CfgPair {
    me : Node
    cluster : List<Node>
}

procfun parseCfg(cfg : String, myIdx : Int) : CfgPair {
    var rawLines : List<String> := split(readFile(cfg), "\n")
    var idx : Int := 0
    var entryIdx : Int := 0
    var meBuilder : Node := Node { id := 0, url := "" }
    var clusterBuilder : List<Node> := []

    internal transition parseAndBuildCluster() {
        guard:
            idx < length(rawLines)
        transit:
            let line : String := trim(rawLines[idx])
            let isEntry : Boolean := ~isBlankOrComment(line)
            let isMyNode : Boolean := isEntry & entryIdx = myIdx
            let nextNode : Node := Node { id := entryIdx, url := line }
            meBuilder := if (isMyNode) {
                nextNode
            } else {
                meBuilder
            }
            clusterBuilder := if (isEntry) {
                clusterBuilder + [nextNode]
            } else {
                clusterBuilder
            }
            entryIdx := if (isEntry) { entryIdx + 1 } else { entryIdx }
            idx := idx + 1
    }

    internal transition endParse() {
        guard:
            idx = length(rawLines)
        return:
            CfgPair { me := meBuilder, cluster := clusterBuilder }
    }
}

proc RaftNodeMain {
    const self : Node
    const theCluster : List<Node>
    const listenPort : Int
    var step : String := "startRpcIn"

    constructor initially(args : List<String>) {
        transit:
            let id : Int := parseInt(args[1])
            let cfg : CfgPair := parseCfg(args[0], id)
            self := cfg.me
            theCluster := cfg.cluster
            listenPort := portFromUrl(cfg.me.url)
        error:
            (length(args) ~= 2) -> "usage: RaftNode.jar <config_file> <node_id>"
    }

    transition startRpcIn(port : Int) {
        guard:
            & step = "startRpcIn"
            & port = listenPort
        transit:
            step := "startRpcOut"
    }

    transition startRpcOut() {
        guard:
            step = "startRpcOut"
        transit:
            step := "startCore"
    }

    transition startRaftCore(me : Node, cluster : List<Node>) {
        guard:
            & step = "startCore"
            & me = self
            & cluster = theCluster
        transit:
            step := "startVoteRequester"
    }

    transition startVoteRequester() {
        guard:
            step = "startVoteRequester"
        transit:
            step := "done"
    }
}

export proc Raft := RaftNodeMain || RaftCore

export proc NodeLogic := Raft
