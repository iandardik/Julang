import julaylib.fun.length

/*
 * Election timeout, RequestVote to peers, leadership, and heartbeats.
 * HTTP/wire encoding lives in the rpc_* modules; this driver only orchestrates.
 */

p-class ElectionDriver {
    var step : String
    var myId : Int
    var curPeer : Int
    var peer : String
    var snapTerm : Int
    var snapCand : Int
    var snapLastIdx : Int
    var snapLastTerm : Int
    var aeTerm : Int
    var aeLeaderId : Int
    var aePrevIdx : Int
    var aePrevTerm : Int
    var aeEntryTerm : Int
    var aeEntryValue : String
    var aeEntriesLen : Int
    var aeLeaderCommit : Int
    var clusterN : Int
    var electTimeout : Int
    var armedEpoch : Int

    constructor startRaft(urls : List<String>, id : Int) {
        transit:
            step := "arm"
            myId := id
            curPeer := 0
            peer := ""
            snapTerm := 0
            snapCand := 0
            snapLastIdx := 0
            snapLastTerm := 0
            aeTerm := 0
            aeLeaderId := 0
            aePrevIdx := 0
            aePrevTerm := 0
            aeEntryTerm := 0
            aeEntryValue := ""
            aeEntriesLen := 0
            aeLeaderCommit := 0
            clusterN := length(urls)
            electTimeout := 2 + id
            armedEpoch := 0
    }

    p2p-consumer transition getSelfId(id : Int) {
        guard: step = "hbSelf"
        transit:
            myId := id
            electTimeout := 2 + id
            step := "hbNeedN"
    }

    p2p-consumer transition getElectionSnapshot(
        epoch : Int, term : Int, candId : Int, lastIdx : Int, lastT : Int, role : String
    ) {
        guard: step = "arm" | step = "checkEpoch" | step = "snap"
        transit:
            armedEpoch := if (step = "arm") { epoch } else { armedEpoch }
            myId := if (step = "snap") { candId } else { myId }
            electTimeout := if (step = "snap") { 2 + candId } else { electTimeout }
            curPeer := if (step = "snap") { 0 } else { curPeer }
            snapTerm := if (step = "snap") { term } else { snapTerm }
            snapCand := if (step = "snap") { candId } else { snapCand }
            snapLastIdx := if (step = "snap") { lastIdx } else { snapLastIdx }
            snapLastTerm := if (step = "snap") { lastT } else { snapLastTerm }
            step := if (step = "arm") {
                "waitTimer"
            } else {
                if (step = "checkEpoch") {
                    if (epoch = armedEpoch) { "doElect" } else { "arm" }
                } else {
                    "needN"
                }
            }
    }

    transition timer(time : Int) {
        guard: (step = "waitTimer" & time = electTimeout) | (step = "hbWait" & time = 1)
        transit: step := "armed"
    }

    transition timeout() {
        guard: step = "armed"
        transit: step := "dispatch"
    }

    p2p-consumer transition isLeader(flag : Boolean) {
        guard: step = "dispatch"
        transit: step := if (flag) { "hbSelf" } else { "checkEpoch" }
    }

    transition startElection(epoch : Int) {
        guard: step = "doElect" & epoch = armedEpoch
        transit: step := "snap"
    }

    p2p-consumer transition getClusterSize(size : Int) {
        guard: step = "needN" | step = "hbNeedN"
        transit:
            clusterN := size
            curPeer := 0
            step := if (step = "hbNeedN") { "hbPeers" } else { "peers" }
    }

    transition skipSelf() {
        guard: step = "peers" & curPeer = myId & curPeer < clusterN
        transit: curPeer := curPeer + 1
    }

    transition peersDone() {
        guard: step = "peers" & curPeer >= clusterN
        transit: step := "checkQ"
    }

    p2p-consumer transition getPeerUrl(peerId : Int, url : String) {
        guard: step = "peers" & peerId = curPeer & curPeer ~= myId & curPeer < clusterN
        transit:
            peer := url
            step := "sendRV"
    }

    transition startOutgoingRequestVote(
        peerId : Int, peerUrl : String,
        term : Int, candId : Int, lastIdx : Int, lastTerm : Int
    ) {
        guard:
            & step = "sendRV"
            & peerId = curPeer
            & peerUrl = peer
            & term = snapTerm
            & candId = snapCand
            & lastIdx = snapLastIdx
            & lastTerm = snapLastTerm
        transit: step := "awaitRV"
    }

    transition recordVote(peerId : Int, term : Int, granted : Boolean) {
        guard: step = "awaitRV" & peerId = curPeer
        transit:
            curPeer := curPeer + 1
            step := "peers"
    }

    p2p-consumer transition hasQuorum(flag : Boolean) {
        guard: step = "checkQ"
        transit: step := if (flag) { "doLeader" } else { "arm" }
    }

    transition becomeLeader() {
        guard: step = "doLeader"
        transit: step := "hbWait"
    }

    transition hbSkipSelf() {
        guard: step = "hbPeers" & curPeer = myId & curPeer < clusterN
        transit: curPeer := curPeer + 1
    }

    transition hbPeersDone() {
        guard: step = "hbPeers" & curPeer >= clusterN
        transit: step := "hbWait"
    }

    p2p-consumer transition getLogMetadata(
        peerId : Int, term : Int, leaderId : Int, prevLogIndex : Int, prevLogTerm : Int,
        entryTerm : Int, entryValue : String, entriesLen : Int, leaderCommit : Int, peerUrlOut : String
    ) {
        guard: step = "hbPeers" & peerId = curPeer & curPeer ~= myId & curPeer < clusterN
        transit:
            peer := peerUrlOut
            aeTerm := term
            aeLeaderId := leaderId
            aePrevIdx := prevLogIndex
            aePrevTerm := prevLogTerm
            aeEntryTerm := entryTerm
            aeEntryValue := entryValue
            aeEntriesLen := entriesLen
            aeLeaderCommit := leaderCommit
            step := "sendAE"
    }

    transition startOutgoingAppendEntries(
        peerId : Int, peerUrl : String,
        term : Int, leaderId : Int, prevLogIndex : Int, prevLogTerm : Int,
        entryTerm : Int, entryValue : String, entriesLen : Int, leaderCommit : Int
    ) {
        guard:
            & step = "sendAE"
            & peerId = curPeer
            & peerUrl = peer
            & term = aeTerm
            & leaderId = aeLeaderId
            & prevLogIndex = aePrevIdx
            & prevLogTerm = aePrevTerm
            & entryTerm = aeEntryTerm
            & entryValue = aeEntryValue
            & entriesLen = aeEntriesLen
            & leaderCommit = aeLeaderCommit
        transit: step := "awaitAE"
    }

    transition handleAppendEntriesResp(
        peerId : Int, inTerm : Int, success : Boolean, matchIdx : Int
    ) {
        guard: step = "awaitAE" & peerId = curPeer
        transit:
            curPeer := curPeer + 1
            step := "hbPeers"
    }
}
