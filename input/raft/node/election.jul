import julaylib.fun.length
import julaylib.fun.split
import julaylib.fun.parseInt
import node.lib.fieldValue
import node.lib.encodeRequestVote
import node.lib.parseBool

/*
 * Election timeout → Candidate → RequestVote → quorum → becomeLeader.
 */

p-class ElectionDriver {
    var step : String
    var myId : Int
    var curPeer : Int
    var peer : String
    var reqBody : String
    var respBody : String
    var voteTerm : Int
    var voteGrantedFlag : Boolean
    var clusterN : Int
    var electTimeout : Int
    var armedEpoch : Int
    var lastRespCode : Int

    constructor startRaft(urls : List<String>, id : Int) {
        transit:
            step := "arm"
            myId := id
            curPeer := 0
            peer := ""
            reqBody := ""
            respBody := ""
            voteTerm := 0
            voteGrantedFlag := false
            clusterN := length(urls)
            electTimeout := 2 + id
            armedEpoch := 0
            lastRespCode := 0
    }

    p2p-consumer transition getElectionSnapshot(
        epoch : Int, term : Int, candId : Int, lastIdx : Int, lastT : Int, role : String
    ) {
        guard: step = "arm" | step = "checkEpoch" | step = "snap"
        transit:
            armedEpoch := if (step = "arm") { epoch } else { armedEpoch }
            myId := if (step = "snap") { candId } else { myId }
            electTimeout := if (step = "snap") { 2 + candId } else { electTimeout }
            curPeer := if (step = "snap") { 0 } else { curPeer }
            reqBody := if (step = "snap") {
                encodeRequestVote(term, candId, lastIdx, lastT)
            } else {
                reqBody
            }
            step := if (step = "arm") {
                "waitTimer"
            } else {
                if (step = "checkEpoch") {
                    if (epoch = armedEpoch) { "doElect" } else { "arm" }
                } else {
                    "needN"
                }
            }
    }

    transition waitElectionTimeout() {
        guard: step = "waitTimer"
        transit: step := "dispatch"
        effect: delaySeconds(electTimeout)
    }

    p2p-consumer transition isLeader(currentlyLeader : Boolean) {
        guard: step = "dispatch"
        transit: step := if (currentlyLeader) { "arm" } else { "checkEpoch" }
    }

    transition startElection(epoch : Int) {
        guard: step = "doElect" & epoch = armedEpoch
        transit: step := "snap"
    }

    p2p-consumer transition getClusterSize(size : Int) {
        guard: step = "needN"
        transit:
            clusterN := size
            curPeer := 0
            step := "peers"
    }

    transition skipSelf() {
        guard: step = "peers" & curPeer = myId & curPeer < clusterN
        transit: curPeer := curPeer + 1
    }

    transition peersDone() {
        guard: step = "peers" & curPeer >= clusterN
        transit: step := "checkQ"
    }

    p2p-consumer transition getPeerUrl(peerId : Int, url : String) {
        guard: step = "peers" & peerId = curPeer & curPeer ~= myId & curPeer < clusterN
        transit:
            peer := url
            step := "sendRV"
    }

    p2p-consumer transition sendRequest(req : HttpClientRequest) {
        guard:
            step = "sendRV" & req = HttpClientRequest {
                url := peer + "/raft/requestVote", method := "POST", body := reqBody
            }
        transit: step := "recvRV"
    }

    p2p-consumer transition receiveResponse(resp : HttpClientResponse) {
        guard: step = "recvRV"
        transit:
            respBody := resp.body
            lastRespCode := resp.code
            step := if (resp.code = 200) { "parseVote" } else { "skipPeer" }
    }

    transition skipFailedPeer() {
        guard: step = "skipPeer"
        transit:
            curPeer := curPeer + 1
            step := "peers"
    }

    transition parseVote() {
        guard: step = "parseVote"
        transit:
            voteTerm := parseInt(fieldValue(split(respBody, "|")[0]))
            voteGrantedFlag := parseBool(fieldValue(split(respBody, "|")[1]))
            step := "tally"
    }

    transition recordVote(peerId : Int, term : Int, granted : Boolean) {
        guard: step = "tally" & peerId = curPeer & term = voteTerm & granted = voteGrantedFlag
        transit:
            curPeer := curPeer + 1
            step := "peers"
    }

    p2p-consumer transition hasQuorum(flag : Boolean) {
        guard: step = "checkQ"
        transit: step := if (flag) { "doLeader" } else { "arm" }
    }

    transition becomeLeader() {
        guard: step = "doLeader"
        transit: step := "arm"
    }
}
