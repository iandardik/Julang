import julaylib.fun.length
import node.lib.Node

/*
 * Election timeout, RequestVote to peers, and leadership handoff.
 * On becomeLeader, spawns HeartbeatDriver and ends; Heartbeat respawns this via resumeElectionDriver.
 */

p-class ElectionDriver {
    var step : String
    var myId : Int
    var curPeer : Int
    var target : Node
    var selfNode : Node
    var snapTerm : Int
    var snapCand : Int
    var snapLastIdx : Int
    var snapLastTerm : Int
    var clusterN : Int
    var electTimeout : Int
    var armedEpoch : Int

    constructor startElectionDriver(urls : List<String>, id : Int) {
        transit:
            step := "arm"
            myId := id
            curPeer := 0
            target := Node { id := 0, url := "" }
            selfNode := Node { id := id, url := "" }
            snapTerm := 0
            snapCand := 0
            snapLastIdx := 0
            snapLastTerm := 0
            clusterN := length(urls)
            electTimeout := 2 + id
            armedEpoch := 0
    }

    /* Demotion restart from HeartbeatDriver (Initializer is already done). */
    constructor resumeElectionDriver(id : Int, n : Int) {
        transit:
            step := "arm"
            myId := id
            curPeer := 0
            target := Node { id := 0, url := "" }
            selfNode := Node { id := id, url := "" }
            snapTerm := 0
            snapCand := 0
            snapLastIdx := 0
            snapLastTerm := 0
            clusterN := n
            electTimeout := 2 + id
            armedEpoch := 0
    }

    transition getElectionSnapshot(
        epoch : Int, term : Int, candId : Int, lastIdx : Int, lastT : Int, role : String
    ) {
        guard: step = "arm" | step = "checkEpoch" | step = "snap"
        transit:
            armedEpoch := if (step = "arm") { epoch } else { armedEpoch }
            myId := if (step = "snap") { candId } else { myId }
            electTimeout := if (step = "snap") { 2 + candId } else { electTimeout }
            curPeer := if (step = "snap") { 0 } else { curPeer }
            snapTerm := if (step = "snap") { term } else { snapTerm }
            snapCand := if (step = "snap") { candId } else { snapCand }
            snapLastIdx := if (step = "snap") { lastIdx } else { snapLastIdx }
            snapLastTerm := if (step = "snap") { lastT } else { snapLastTerm }
            step := if (step = "arm") {
                "waitTimer"
            } else {
                if (step = "checkEpoch") {
                    if (epoch = armedEpoch) { "doElect" } else { "arm" }
                } else {
                    "needN"
                }
            }
    }

    internal transition waitElect() {
        guard: step = "waitTimer"
        transit: step := "checkEpoch"
        effect: delaySeconds(electTimeout)
    }

    transition startElection(epoch : Int) {
        guard: step = "doElect" & epoch = armedEpoch
        transit: step := "snap"
    }

    transition getClusterSize(size : Int) {
        guard: step = "needN"
        transit:
            clusterN := size
            curPeer := 0
            step := "peers"
    }

    internal transition skipSelf() {
        guard: step = "peers" & curPeer = myId & curPeer < clusterN
        transit: curPeer := curPeer + 1
    }

    internal transition peersDone() {
        guard: step = "peers" & curPeer >= clusterN
        transit: step := "checkQ"
    }

    transition lookupNodeById(id : Int, node : Node) {
        guard: step = "peers" & id = curPeer
        transit:
            target := node
            step := "sendRequestVote"
    }

    transition startOutgoingRequestVote(
        peer : Node,
        term : Int, candId : Int, lastIdx : Int, lastTerm : Int
    ) {
        guard:
            & step = "sendRequestVote"
            & peer = target
            & term = snapTerm
            & candId = snapCand
            & lastIdx = snapLastIdx
            & lastTerm = snapLastTerm
        transit: step := "awaitRequestVote"
    }

    /* Pairwise with OutgoingRequestVoteRPC after Core has recorded the vote. */
    transition finishRecordVote(peerId : Int) {
        guard: step = "awaitRequestVote" & peerId = curPeer
        transit:
            curPeer := curPeer + 1
            step := "peers"
    }

    transition hasQuorum(flag : Boolean) {
        guard: step = "checkQ"
        transit: step := if (flag) { "doLeader" } else { "arm" }
    }

    transition becomeLeader() {
        guard: step = "doLeader"
        transit: step := "needSelf"
    }

    transition getSelf(node : Node) {
        guard: step = "needSelf" & node.id = myId
        transit:
            selfNode := node
            step := "startHb"
    }

    /* Spawn HeartbeatDriver, then end this election instance. */
    transition startHeartbeatDriver(me : Node, n : Int) {
        guard: step = "startHb" & me = selfNode & n = clusterN
        transit: step := "done"
    }
}
