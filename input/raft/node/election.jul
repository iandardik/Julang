import node.lib.Node

/*
 * This file contains processes that handle an outgoing election, i.e. an election that is
 * started by this node.
 */

/*
 * Starts an election after a "random" timeout (it's currently not random). This process begins
 * by recording an "election epoch" from RaftCore that represents the current RaftCore state. Then,
 * the process sleeps for the timeout period. Upon waking up, the process checks whether the
 * election epoch is still 'fresh'; if so then it spawns an ElectionCampaign, if not it restarts
 * and sleeps again.
 *
 * Lifecycle invariant: at most one of {ElectionTimeout, ElectionCampaign, HeartbeatDriver}
 * is actively driving elections or leadership handoff.
 */
p-class ElectionTimeout {
    const selfNode : Node
    const clusterSize : Int
    const electTimeout : Int
    var step : String
    var currentEpoch : Int
    var snapTerm : Int
    var snapCand : Int
    var snapLastIdx : Int
    var snapLastTerm : Int

    constructor startElectionTimeout(me : Node, n : Int) {
        transit:
            selfNode := me
            clusterSize := n
            electTimeout := 2 + me.id
            step := "start"
            currentEpoch := 0
            snapTerm := 0
            snapCand := 0
            snapLastIdx := 0
            snapLastTerm := 0
    }

    /* Same as startElectionTimeout; distinct name so only HeartbeatDriver is the sync peer. */
    constructor resumeElectionTimeout(me : Node, n : Int) {
        transit:
            selfNode := me
            clusterSize := n
            electTimeout := 2 + me.id
            step := "start"
            currentEpoch := 0
            snapTerm := 0
            snapCand := 0
            snapLastIdx := 0
            snapLastTerm := 0
    }

    transition getElectionSnapshot(
        epoch : Int,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastT : Int,
        role : String
    ) {
        guard:
            | step = "start"
            | step = "checkEpoch"
        transit:
            currentEpoch := if (step = "start") { epoch } else { currentEpoch }
            step := when {
                // sleep for a "random" amount of time before attempting to start the election
                (step = "start") -> "sleep"

                // if the epoch hasn't changed since sleeping then start the election
                (epoch = currentEpoch) -> "doElect"

                // if the epoch has changed since sleeping then start all over again
                else -> "start"
            }
    }

    internal transition sleepBeforeElect() {
        guard:
            step = "sleep"
        transit:
            step := "checkEpoch"
        effect:
            delaySeconds(electTimeout)
    }

    /* Pairwise with RaftCore: become candidate and bind candidacy metadata for the campaign. */
    transition startElection(
        epoch : Int,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastT : Int
    ) {
        guard:
            & step = "doElect"
            & epoch = currentEpoch
        transit:
            snapTerm := term
            snapCand := candId
            snapLastIdx := lastIdx
            snapLastTerm := lastT
            step := "startCampaign"
    }

    transition startElectionCampaign(
        me : Node,
        n : Int,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastTerm : Int
    ) {
        guard:
            & step = "startCampaign"
            & me = selfNode
            & n = clusterSize
            & term = snapTerm
            & candId = snapCand
            & lastIdx = snapLastIdx
            & lastTerm = snapLastTerm
        transit:
            step := "awaitCampaign"
    }

    /* Campaign lost quorum: go back to the start and reset the election timer. */
    transition electionCampaignLost() {
        guard:
            step = "awaitCampaign"
        transit:
            step := "start"
    }

    /* Campaign won: this timeout instance ends; campaign will start HeartbeatDriver. */
    transition electionCampaignWon() {
        guard:
            step = "awaitCampaign"
        transit:
            step := "done"
    }
}

/*
 * The election campaign cycles through each of the peer nodes and sends a vote request RPC
 * to each one (called the target). The process notifies RaftCore of each decision. Then,
 * once the processes has finished requesting a vote from each node, it checks if it has a
 * quorum; if so then it tells RaftCore to become the leader, if not it simply terminates.
 */
p-class ElectionCampaign {
    const selfNode : Node
    const clusterSize : Int
    const snapTerm : Int
    const snapCand : Int
    const snapLastIdx : Int
    const snapLastTerm : Int
    var step : String
    var target : Node
    var targetId : Int
    var voteTerm : Int
    var voteGranted : Boolean

    constructor startElectionCampaign(
        me : Node,
        n : Int,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastTerm : Int
    ) {
        transit:
            selfNode := me
            clusterSize := n
            snapTerm := term
            snapCand := candId
            snapLastIdx := lastIdx
            snapLastTerm := lastTerm
            step := "lookUpTarget"
            target := Node { id := 0, url := "" }
            targetId := 0
            voteTerm := 0
            voteGranted := false
    }

    // if the current target is me then move to the next target
    internal transition skipMe() {
        guard:
            & step = "lookUpTarget"
            & targetId = selfNode.id
            & targetId < clusterSize
        transit:
            targetId := targetId + 1
    }

    internal transition allTargetsSent() {
        guard:
            & step = "lookUpTarget"
            & targetId >= clusterSize
        transit:
            step := "checkIfWon"

    }

    transition lookupNodeById(id : Int, node : Node) {
        guard:
            & step = "lookUpTarget"
            & id = targetId
            & id ~= selfNode.id // req votes from other nodes
        transit:
            target := node
            step := "sendRequestVote"
    }

    transition beginOutgoingRequestVote(
        peer : Node,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastTerm : Int
    ) {
        guard:
            & step = "sendRequestVote"
            & peer = target
            & term = snapTerm
            & candId = snapCand
            & lastIdx = snapLastIdx
            & lastTerm = snapLastTerm
        transit:
            step := "awaitRequestVote"
    }

    transition endOutgoingRequestVote(peerId : Int, term : Int, granted : Boolean) {
        guard:
            & step = "awaitRequestVote"
            & peerId = targetId
        transit:
            voteTerm := term
            voteGranted := granted
            step := "recordVote"
    }

    /* Pairwise with RaftCore: apply the vote result from the outbound RPC. */
    transition recordVote(peerId : Int, term : Int, granted : Boolean) {
        guard:
            & step = "recordVote"
            & peerId = targetId
            & term = voteTerm
            & granted = voteGranted
        transit:
            targetId := targetId + 1
            step := "lookUpTarget"
    }

    transition hasQuorum(flag : Boolean) {
        guard:
            step = "checkIfWon"
        transit:
            step := if (flag) { "doLeader" } else { "lost" }
    }

    transition electionCampaignLost() {
        guard:
            step = "lost"
        transit:
            step := "done"
    }

    transition becomeLeader() {
        guard:
            step = "doLeader"
        transit:
            step := "won"
    }

    transition electionCampaignWon() {
        guard:
            step = "won"
        transit:
            step := "startHeartbeat"
    }

    /* Spawn HeartbeatDriver, then end this campaign. */
    transition startHeartbeatDriver(me : Node, n : Int) {
        guard:
            & step = "startHeartbeat"
            & me = selfNode
            & n = clusterSize
        transit:
            step := "done"
    }
}
