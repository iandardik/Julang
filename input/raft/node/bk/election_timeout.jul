import node.lib.Node

/*
 * Follower/candidate election timeout. Owns a cancellable Timer (composed at Raft).
 * On timeout → RaftCore.Timeout (this instance ends; Core spawns CandidateElection).
 * On resetElectionTimer → cancel + restart (heartbeat / newer term).
 */

export proc ElectionTimeout {
    const selfNode : Node
    const electTimeout : Int
    var step : String

    constructor startElectionTimeout(me : Node) {
        transit:
            selfNode := me
            electTimeout := 2 + me.id
            step := "createTimer"
    }

    session transition createTimer() {
        guard: step = "createTimer"
        transit: step := "startTimer"
    }

    session transition startTimer(time : Int) {
        guard:
            & (step = "startTimer" | step = "restart")
            & time = electTimeout
        transit:
            step := "wait"
    }

    session transition timeout() {
        guard: step = "wait"
        transit: step := "doTimeout"
    }

    transition resetElectionTimer() {
        guard: step = "wait"
        transit: step := "cancel"
    }

    session transition cancelTimer() {
        guard: step = "cancel"
        transit: step := "restart"
    }

    transition Timeout() {
        guard: step = "doTimeout"
        transit: step := "done"
    }
}
