import julay.funlib.length
import node.lib.Entry
import node.lib.Node
import node.lib.AppendEntriesData
import node.lib.entryValueAt
import node.lib.entryTermAt

/*
 * Local Raft state for one node (Ongaro-shaped action surface).
 * RaftCore is a singleton per node and the sole constructor of
 * ElectionTimeout, CandidateElection, and LeaderHeartbeat — at most one
 * of those three drivers is alive at a time.
 */

export proc RaftCore {
    const self : Node
    const selfId : Int
    const cluster : List<Node>
    const clusterSize : Int
    var currentTerm : Int
    var state : String
    var votedFor : Int
    var log : List<Entry>
    var lastLogTermVar : Int
    var commitIndex : Int
    var lastApplied : Int
    var sm : List<String>
    var votesGranted : Set<Int>
    var voteCount : Int
    var knownLeaderId : Int
    var nextIndex : Map<Int, Int>
    var matchIndex : Map<Int, Int>
    /* Count of peers that have acknowledged at least commitIndex+1 (leader counted separately). */
    var ackCount : Int
    var spawnElectionTimeout : Boolean
    var spawnElection : Boolean
    var spawnLeaderHeartbeat : Boolean
    var resetElectionTimer : Boolean

    var aePeer : Node
    var aeTerm : Int
    var aeLeaderId : Int
    var aePrevIdx : Int
    var aePrevTerm : Int
    var aeEntryTerm : Int
    var aeEntryValue : String
    var aeEntriesLen : Int
    var aeLeaderCommit : Int
    var aeReady : Boolean

    constructor startRaftCore(me : Node, cluster : List<Node>) {
        transit:
            self := me
            selfId := me.id
            cluster := cluster
            clusterSize := length(cluster)
            currentTerm := 0
            state := "Follower"
            votedFor := -1
            log := []
            lastLogTermVar := 0
            commitIndex := 0
            lastApplied := 0
            sm := []
            votesGranted := {}
            voteCount := 0
            knownLeaderId := -1
            nextIndex := []
            matchIndex := []
            ackCount := 0
            aePeer := Node { id := 0, url := "" }
            aeTerm := 0
            aeLeaderId := 0
            aePrevIdx := 0
            aePrevTerm := 0
            aeEntryTerm := 0
            aeEntryValue := ""
            aeEntriesLen := 0
            aeLeaderCommit := 0
            aeReady := false
            spawnElectionTimeout := true
            spawnElection := false
            spawnLeaderHeartbeat := false
            resetElectionTimer := false
    }

    /*
     * Ongaro UpdateTerm: any RPC with a newer term advances us first.
     * Always syncable; no-op when inTerm <= currentTerm.
     */
    /* provider: procfun clients keep public channel keys (no remap on procfun StaticInfo). */
    provider transition UpdateTerm(inTerm : Int) {
        guard: true
        transit:
            let advanced : Boolean := inTerm > currentTerm
            currentTerm := if (advanced) { inTerm } else { currentTerm }
            state := if (advanced) { "Follower" } else { state }
            votedFor := if (advanced) { -1 } else { votedFor }
            knownLeaderId := if (advanced) { -1 } else { knownLeaderId }
            votesGranted := if (advanced) { votesGranted - votesGranted } else { votesGranted }
            voteCount := if (advanced) { 0 } else { voteCount }
            /* Leader/Candidate drivers detect demotion and call lostLeadership /
             * candidateElectionLost; do not spawn ElectionTimeout here (exclusivity). */
            resetElectionTimer := if (advanced) { true } else { resetElectionTimer }
    }

    /* Ongaro Timeout: start a new election. */
    transition Timeout() {
        guard:
            state = "Follower" | state = "Candidate"
        transit:
            state := "Candidate"
            currentTerm := currentTerm + 1
            votedFor := self.id
            votesGranted := {self.id}
            voteCount := 1
            knownLeaderId := -1
            spawnElection := true
            resetElectionTimer := false
    }

    transition startElectionTimeout(me : Node) {
        guard:
            & spawnElectionTimeout
            & me = self
        transit:
            spawnElectionTimeout := false
            resetElectionTimer := false
    }

    transition startElection(
        me : Node,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastTerm : Int
    ) {
        guard:
            & spawnElection
            & me = self
            & state = "Candidate"
            & term = currentTerm
            & candId = self.id
            & lastIdx = length(log)
            & lastTerm = lastLogTermVar
        transit:
            spawnElection := false
    }

    transition startLeaderHeartbeat(me : Node) {
        guard:
            & spawnLeaderHeartbeat
            & me = self
            & state = "Leader"
        transit:
            spawnLeaderHeartbeat := false
    }

    transition resetElectionTimer() {
        guard: resetElectionTimer
        transit:
            resetElectionTimer := false
    }

    provider transition handleRequestVoteRequest(
        inTerm : Int,
        candidateId : Int,
        lastLogIndex : Int,
        lastLogTerm : Int,
        outTerm : Int,
        voteGranted : Boolean
    ) {
        guard:
            let (logOk : Boolean :=
                (lastLogTerm > lastLogTermVar) | (lastLogTerm = lastLogTermVar & lastLogIndex >= length(log))
            ) {
                & inTerm <= currentTerm
                & outTerm = currentTerm
                & (
                    | (
                        & voteGranted
                        & inTerm = currentTerm
                        & (votedFor = -1 | votedFor = candidateId)
                        & logOk
                    )
                    | (
                        & ~voteGranted
                        & ~(
                            & inTerm = currentTerm
                            & (votedFor = -1 | votedFor = candidateId)
                            & logOk
                        )
                    )
                )
            }
        transit:
            votedFor := if (voteGranted) { candidateId } else { votedFor }
            resetElectionTimer := if (voteGranted) { true } else { resetElectionTimer }
    }

    provider transition handleRequestVoteResponse(peerId : Int, term : Int, granted : Boolean) {
        guard:
            & state = "Candidate"
            & term = currentTerm
        transit:
            votesGranted := if (granted) { votesGranted + {peerId} } else { votesGranted }
            voteCount := if (granted) { voteCount + 1 } else { voteCount }
    }

    transition becomeLeader() {
        guard:
            & state = "Candidate"
            & voteCount * 2 > clusterSize
        transit:
            state := "Leader"
            knownLeaderId := self.id
            nextIndex := []
            matchIndex := []
            ackCount := 0
            spawnLeaderHeartbeat := true
    }

    transition candidateElectionLost() {
        guard:
            state = "Candidate" | state = "Follower"
        transit:
            spawnElectionTimeout := true
    }

    transition lostLeadership() {
        guard:
            state ~= "Leader"
        transit:
            spawnElectionTimeout := true
    }

    provider transition clientRequest(value : String, idx : Int) {
        guard:
            & state = "Leader"
            & idx = length(log) + 1
        transit:
            log := log + [Entry { term := currentTerm, value := value }]
            lastLogTermVar := currentTerm
    }

    provider transition committed(value : String, idx : Int) {
        guard:
            & state = "Leader"
            & idx > 0
            & idx <= commitIndex
            & idx <= length(log)
            & value = entryValueAt(log, idx - 1)
    }

    provider transition leaderRedirect(leader : Node) {
        guard:
            & state ~= "Leader"
            & knownLeaderId >= 0
            & leader.id = knownLeaderId
            & knownLeaderId < clusterSize
            & cluster[knownLeaderId] = leader
    }

    provider transition noLeader() {
        guard:
            & state ~= "Leader"
            & knownLeaderId < 0
    }

    provider transition getCommitted(stateMachine : List<String>) {
        guard: stateMachine = sm
    }

    provider transition handleAppendEntriesRequest(
        inTerm : Int,
        leaderId : Int,
        prevLogIndex : Int,
        prevLogTerm : Int,
        entriesLen : Int,
        entryTerm : Int,
        entryValue : String,
        leaderCommit : Int,
        outTerm : Int,
        success : Boolean,
        matchIdx : Int
    ) {
        guard:
            & inTerm <= currentTerm
            & outTerm = currentTerm
            & (entriesLen = 0 | entriesLen = 1)
            & (
                | (
                    & ~success
                    & matchIdx = 0
                    & (
                        | (inTerm < currentTerm)
                        | (
                            & inTerm = currentTerm
                            & (
                                | (prevLogIndex > length(log))
                                | (
                                    & prevLogIndex > 0
                                    & prevLogIndex <= length(log)
                                    & entryTermAt(log, prevLogIndex - 1) ~= prevLogTerm
                                )
                            )
                        )
                    )
                )
                | (
                    & success
                    & inTerm = currentTerm
                    & (
                        | (prevLogIndex = 0)
                        | (
                            & prevLogIndex > 0
                            & prevLogIndex <= length(log)
                            & entryTermAt(log, prevLogIndex - 1) = prevLogTerm
                        )
                    )
                    & (
                        | (entriesLen = 0 & matchIdx = prevLogIndex)
                        | (entriesLen = 1 & matchIdx = prevLogIndex + 1)
                    )
                )
            )
        transit:
            knownLeaderId := if (success) { leaderId } else { knownLeaderId }
            state := if (success & inTerm = currentTerm) { "Follower" } else { state }
            resetElectionTimer := if (success) { true } else { resetElectionTimer }
            log := if (success & entriesLen = 1) {
                log[0:prevLogIndex] + [Entry { term := entryTerm, value := entryValue }]
            } else {
                log
            }
            lastLogTermVar := if (success & entriesLen = 1) {
                entryTerm
            } else {
                lastLogTermVar
            }
            commitIndex := if (success & leaderCommit > commitIndex) {
                let (lastNew : Int := if (entriesLen = 1) { prevLogIndex + 1 } else { length(log) }) {
                    if (leaderCommit < lastNew) { leaderCommit } else { lastNew }
                }
            } else {
                commitIndex
            }
    }

    provider transition handleAppendEntriesResponse(
        peerId : Int,
        inTerm : Int,
        success : Boolean,
        matchIdx : Int
    ) {
        guard:
            & state = "Leader"
            & inTerm = currentTerm
        transit:
            matchIndex[peerId] := if (success) { matchIdx } else {
                if (peerId in matchIndex) { matchIndex[peerId] } else { 0 }
            }
            nextIndex[peerId] := if (success) {
                matchIdx + 1
            } else {
                let (cur : Int := if (peerId in nextIndex) { nextIndex[peerId] } else { length(log) + 1 }) {
                    if (cur > 1) { cur - 1 } else { 1 }
                }
            }
            ackCount := if (success & matchIdx >= commitIndex + 1) {
                ackCount + 1
            } else {
                ackCount
            }
    }

    internal transition advanceCommitIndex() {
        guard:
            & state = "Leader"
            & commitIndex < length(log)
            & entryTermAt(log, commitIndex) = currentTerm
            & (ackCount + 1) * 2 > clusterSize
        transit:
            commitIndex := commitIndex + 1
            ackCount := 0
    }

    internal transition applyEntryToStateMachine() {
        guard:
            & lastApplied < commitIndex
            & lastApplied < length(log)
        transit:
            sm := sm + [entryValueAt(log, lastApplied)]
            lastApplied := lastApplied + 1
    }

    provider transition getIsLeader(isLeader : Boolean) {
        guard: isLeader <=> (state = "Leader")
    }

    provider transition getIsCandidate(isCandidate : Boolean) {
        guard: isCandidate <=> (state = "Candidate")
    }

    provider transition hasQuorum(flag : Boolean) {
        guard:
            & state = "Candidate"
            & (
                | (flag & voteCount * 2 > clusterSize)
                | (~flag & voteCount * 2 <= clusterSize)
            )
    }

    provider transition getCurrentTerm(term : Int) {
        guard: term = currentTerm
    }

    provider transition getElectionInfo(
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastT : Int
    ) {
        guard:
            & term = currentTerm
            & candId = self.id
            & lastIdx = length(log)
            & lastT = lastLogTermVar
    }

    provider transition getCluster(c : List<Node>) {
        guard: c = cluster
    }

    provider transition getSelf(me : Node) {
        guard: me = self
    }

    transition prepareAppendEntries(peer : Node) {
        guard:
            & state = "Leader"
            & peer.id ~= self.id
            & peer.id >= 0
            & peer.id < clusterSize
            & cluster[peer.id] = peer
            & ~aeReady
        transit:
            let nextIdx : Int := if (peer.id in nextIndex) { nextIndex[peer.id] } else { length(log) + 1 }
            aePeer := peer
            aeTerm := currentTerm
            aeLeaderId := self.id
            aeLeaderCommit := commitIndex
            aeReady := true
            aePrevIdx := if (nextIdx > length(log)) { length(log) } else { nextIdx - 1 }
            aePrevTerm := if (nextIdx > length(log)) {
                lastLogTermVar
            } else {
                if (nextIdx - 1 <= 0) { 0 } else { entryTermAt(log, nextIdx - 2) }
            }
            aeEntriesLen := if (nextIdx > length(log)) { 0 } else { 1 }
            aeEntryTerm := if (nextIdx > length(log)) { 0 } else { entryTermAt(log, nextIdx - 1) }
            aeEntryValue := if (nextIdx > length(log)) { "" } else { entryValueAt(log, nextIdx - 1) }
    }

    provider transition getAppendEntriesForPeer(peer : Node, data : AppendEntriesData) {
        guard:
            & aeReady
            & peer = aePeer
            & data = AppendEntriesData {
                term := aeTerm,
                leaderId := aeLeaderId,
                prevLogIndex := aePrevIdx,
                prevLogTerm := aePrevTerm,
                entryTerm := aeEntryTerm,
                entryValue := aeEntryValue,
                entriesLen := aeEntriesLen,
                leaderCommit := aeLeaderCommit
            }
        transit:
            aeReady := false
    }
}
