import julay.proclib.HttpClient
import julay.funlib.split
import julay.funlib.parseInt
import node.lib.Node
import node.lib.AppendEntriesData
import node.lib.fieldValue
import node.lib.encodeRequestVote
import node.lib.encodeAppendEntries
import node.lib.parseBool

/*
 * Outbound Raft RPCs as procfuns. They rendezvous with RpcOutHandler via provider/client
 * (public channel keys) because procfun StaticInfo does not receive composition-remapped
 * keys. RpcOutHandler owns the HttpClient session (matching remapped keys under ||).
 */

proc RpcOutHandler {
    var step : String
    var reqUrl : String
    var reqBody : String
    var respBody : String

    constructor startRpcOut() {
        transit:
            step := "createHttp"
            reqUrl := ""
            reqBody := ""
            respBody := ""
    }

    session transition createHttpClient() {
        guard: step = "createHttp"
        transit: step := "idle"
    }

    session transition closeHttpClient() {
        guard: false
    }

    provider transition beginOutHttp(url : String, body : String) {
        guard: step = "idle"
        transit:
            reqUrl := url
            reqBody := body
            step := "send"
    }

    session transition sendRequest(req : HttpClientRequest) {
        guard:
            & step = "send"
            & req = HttpClientRequest {
                url := reqUrl,
                method := "POST",
                body := reqBody
            }
        transit:
            step := "recv"
    }

    session transition receiveResponse(resp : HttpClientResponse) {
        guard: step = "recv"
        transit:
            respBody := resp.body
            step := "end"
    }

    provider transition endOutHttp(body : String) {
        guard:
            & step = "end"
            & body = respBody
        transit:
            step := "idle"
    }
}

export procfun outRequestVoteRPC(
    peer : Node,
    term : Int,
    candId : Int,
    lastIdx : Int,
    lastTerm : Int
) : Boolean {
    const reqBody : String := encodeRequestVote(term, candId, lastIdx, lastTerm)
    const reqUrl : String := peer.url + "/raft/requestVote"
    var step : String := "begin"
    var respBody : String := ""
    var respTerm : Int := 0
    var grantedFlag : Boolean := false

    client transition beginOutHttp(url : String, body : String) {
        guard:
            & step = "begin"
            & url = reqUrl
            & body = reqBody
        transit:
            step := "await"
    }

    client transition endOutHttp(body : String) {
        guard: step = "await"
        transit:
            respBody := body
            step := "parse"
    }

    internal transition parseResp() {
        guard: step = "parse"
        transit:
            respTerm := parseInt(fieldValue(split(respBody, "|")[0]))
            grantedFlag := parseBool(fieldValue(split(respBody, "|")[1]))
            step := "updateTerm"
    }

    client transition UpdateTerm(inTerm : Int) {
        guard:
            & step = "updateTerm"
            & inTerm = respTerm
        transit:
            step := "checkStale"
    }

    client transition getCurrentTerm(term : Int) {
        guard: step = "checkStale"
        transit:
            step := if (respTerm < term) { "drop" } else { "handle" }
    }

    client transition handleRequestVoteResponse(peerId : Int, term : Int, granted : Boolean) {
        guard:
            & step = "handle"
            & peerId = peer.id
            & term = respTerm
            & granted = grantedFlag
        transit:
            step := "done"
    }

    internal transition markDrop() {
        guard: step = "drop"
        transit: step := "doneDrop"
    }

    internal transition finishOk() {
        guard: step = "done"
        return: grantedFlag
    }

    internal transition finishDrop() {
        guard: step = "doneDrop"
        return: false
    }
}

export procfun outAppendEntriesRPC(peer : Node, data : AppendEntriesData) : Boolean {
    const reqBody : String := encodeAppendEntries(data)
    const reqUrl : String := peer.url + "/raft/appendEntries"
    var step : String := "begin"
    var respBody : String := ""
    var respTerm : Int := 0
    var successFlag : Boolean := false
    var matchIdxVal : Int := 0

    client transition beginOutHttp(url : String, body : String) {
        guard:
            & step = "begin"
            & url = reqUrl
            & body = reqBody
        transit:
            step := "await"
    }

    client transition endOutHttp(body : String) {
        guard: step = "await"
        transit:
            respBody := body
            step := "parse"
    }

    internal transition parseResp() {
        guard: step = "parse"
        transit:
            respTerm := parseInt(fieldValue(split(respBody, "|")[0]))
            successFlag := parseBool(fieldValue(split(respBody, "|")[1]))
            matchIdxVal := parseInt(fieldValue(split(respBody, "|")[2]))
            step := "updateTerm"
    }

    client transition UpdateTerm(inTerm : Int) {
        guard:
            & step = "updateTerm"
            & inTerm = respTerm
        transit:
            step := "checkStale"
    }

    client transition getCurrentTerm(term : Int) {
        guard: step = "checkStale"
        transit:
            step := if (respTerm < term) { "drop" } else { "handle" }
    }

    client transition handleAppendEntriesResponse(
        peerId : Int,
        inTerm : Int,
        success : Boolean,
        matchIdx : Int
    ) {
        guard:
            & step = "handle"
            & peerId = peer.id
            & inTerm = respTerm
            & success = successFlag
            & matchIdx = matchIdxVal
        transit:
            step := "done"
    }

    internal transition markDrop() {
        guard: step = "drop"
        transit: step := "doneDrop"
    }

    internal transition finishOk() {
        guard: step = "done"
        return: successFlag
    }

    internal transition finishDrop() {
        guard: step = "doneDrop"
        return: false
    }
}

export proc RpcOut := RpcOutHandler || HttpClient
