import julay.funlib.length
import julay.funlib.delaySeconds
import node.lib.Node
import node.lib.AppendEntriesData
import node.rpc_out.outAppendEntriesRPC

/*
 * Leader heartbeat / log replication. Periodically sends AppendEntries
 * (with real entries when followers are behind) via outAppendEntriesRPC.
 * On demotion, reports lostLeadership so Core re-spawns ElectionTimeout.
 */

export proc LeaderHeartbeat {
    const me : Node
    var step : String
    var peers : List<Node>
    var idx : Int
    var target : Node
    var ae : AppendEntriesData

    constructor startLeaderHeartbeat(me : Node) {
        transit:
            me := me
            step := "sleep"
            peers := []
            idx := 0
            target := Node { id := 0, url := "" }
            ae := AppendEntriesData {
                term := 0,
                leaderId := 0,
                prevLogIndex := 0,
                prevLogTerm := 0,
                entryTerm := 0,
                entryValue := "",
                entriesLen := 0,
                leaderCommit := 0
            }
    }

    internal transition sleep() {
        guard: step = "sleep"
        transit: step := "checkLeader"
        after: delaySeconds(1)
    }

    client transition getIsLeader(isLeader : Boolean) {
        guard: step = "checkLeader"
        transit:
            step := if (isLeader) { "loadCluster" } else { "handback" }
    }

    client transition getCluster(c : List<Node>) {
        guard: step = "loadCluster"
        transit:
            peers := c
            idx := 0
            step := "pickPeer"
    }

    internal transition skipSelf() {
        guard:
            & step = "pickPeer"
            & idx < length(peers)
            & peers[idx].id = me.id
        transit:
            idx := idx + 1
    }

    internal transition roundDone() {
        guard:
            & step = "pickPeer"
            & idx >= length(peers)
        transit:
            step := "sleep"
    }

    internal transition pickPeer() {
        guard:
            & step = "pickPeer"
            & idx < length(peers)
            & peers[idx].id ~= me.id
        transit:
            target := peers[idx]
            idx := idx + 1
            step := "prepareAE"
    }

    transition prepareAppendEntries(peer : Node) {
        guard:
            & step = "prepareAE"
            & peer = target
        transit:
            step := "needMeta"
    }

    client transition getAppendEntriesForPeer(peer : Node, data : AppendEntriesData) {
        guard:
            & step = "needMeta"
            & peer = target
        transit:
            ae := data
            step := "sendAE"
    }

    internal transition sendAE() {
        guard: step = "sendAE"
        transit:
            let _ok : Boolean := outAppendEntriesRPC(target, ae)
            step := "pickPeer"
    }

    transition lostLeadership() {
        guard: step = "handback"
        transit: step := "done"
    }
}
