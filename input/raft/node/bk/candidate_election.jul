import julay.funlib.length
import node.lib.Node
import node.rpc_out.outRequestVoteRPC

/*
 * Candidate election: RequestVote each peer via outRequestVoteRPC, then
 * become leader or report loss. Ends when Core spawns LeaderHeartbeat or
 * re-spawns ElectionTimeout.
 */

export proc CandidateElection {
    const selfNode : Node
    const snapTerm : Int
    const snapCand : Int
    const snapLastIdx : Int
    const snapLastTerm : Int
    var step : String
    var peers : List<Node>
    var idx : Int
    var peer : Node

    constructor startElection(
        me : Node,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastTerm : Int
    ) {
        transit:
            selfNode := me
            snapTerm := term
            snapCand := candId
            snapLastIdx := lastIdx
            snapLastTerm := lastTerm
            peers := []
            idx := 0
            peer := Node { id := 0, url := "" }
            step := "loadCluster"
    }

    client transition getCluster(c : List<Node>) {
        guard: step = "loadCluster"
        transit:
            peers := c
            idx := 0
            step := "pickPeer"
    }

    internal transition skipSelf() {
        guard:
            & step = "pickPeer"
            & idx < length(peers)
            & peers[idx].id = selfNode.id
        transit:
            idx := idx + 1
    }

    internal transition allPeersDone() {
        guard:
            & step = "pickPeer"
            & idx >= length(peers)
        transit:
            step := "checkQuorum"
    }

    internal transition pickPeer() {
        guard:
            & step = "pickPeer"
            & idx < length(peers)
            & peers[idx].id ~= selfNode.id
        transit:
            peer := peers[idx]
            idx := idx + 1
            step := "sendVote"
    }

    internal transition sendVote() {
        guard: step = "sendVote"
        transit:
            let _ignored : Boolean := outRequestVoteRPC(
                peer, snapTerm, snapCand, snapLastIdx, snapLastTerm
            )
            step := "pickPeer"
    }

    client transition getIsCandidate(isCandidate : Boolean) {
        guard: step = "checkQuorum"
        transit:
            step := if (isCandidate) { "quorumCheck" } else { "lost" }
    }

    client transition hasQuorum(flag : Boolean) {
        guard: step = "quorumCheck"
        transit:
            step := if (flag) { "win" } else { "lost" }
    }

    transition becomeLeader() {
        guard: step = "win"
        transit: step := "done"
    }

    transition candidateElectionLost() {
        guard: step = "lost"
        transit: step := "done"
    }
}
