import julay.funlib.length
import julay.funlib.split
import julay.funlib.startsWith

/*
 * Shared Raft types and helpers (RPC encoding, config parsing, log access).
 */

export obj Entry {
    term : Int
    value : String
}

export obj Node {
    id : Int
    url : String
}

/*
 * AppendEntries payload. entriesLen is 0 (heartbeat) or 1 (single entry).
 * Multi-entry batches can be added later; one-at-a-time replication is enough
 * for followers to build their logs.
 */
export obj AppendEntriesData {
    term : Int
    leaderId : Int
    prevLogIndex : Int
    prevLogTerm : Int
    entryTerm : Int
    entryValue : String
    entriesLen : Int
    leaderCommit : Int
}

export fun entryValueAt(log : List<Entry>, idx : Int) : String =
    let (e : Entry := log[idx]) { e.value }

export fun entryTermAt(log : List<Entry>, idx : Int) : Int =
    let (e : Entry := log[idx]) { e.term }

fun isQuorum(n : Int, granted : Set<Int>) : Boolean =
    length(granted) * 2 > n

export fun fieldValue(line : String) : String =
    split(line, "=")[1]

export fun encodeRequestVote(term : Int, candidateId : Int, lastLogIndex : Int, lastLogTerm : Int) : String =
    "term=" + term + "|candidateId=" + candidateId + "|lastLogIndex=" + lastLogIndex + "|lastLogTerm=" + lastLogTerm

export fun encodeRequestVoteResp(term : Int, voteGranted : Boolean) : String =
    "term=" + term + "|voteGranted=" + if (voteGranted) { "true" } else { "false" }

export fun encodeAppendEntries(data : AppendEntriesData) : String =
    "term=" + data.term
        + "|leaderId=" + data.leaderId
        + "|prevLogIndex=" + data.prevLogIndex
        + "|prevLogTerm=" + data.prevLogTerm
        + "|entriesLen=" + data.entriesLen
        + "|entryTerm=" + data.entryTerm
        + "|entryValue=" + data.entryValue
        + "|leaderCommit=" + data.leaderCommit

export fun encodeAppendEntriesResp(term : Int, success : Boolean, matchIndex : Int) : String =
    "term=" + term
        + "|success=" + if (success) { "true" } else { "false" }
        + "|matchIndex=" + matchIndex

export fun isBlankOrComment(line : String) : Boolean =
    line = "" | startsWith(line, "#")

export fun parseBool(s : String) : Boolean =
    s = "true"
