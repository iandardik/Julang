import julay.proclib.HttpServer
import julay.funlib.parseInt
import julay.funlib.split
import node.lib.fieldValue
import node.lib.encodeRequestVoteResp

procfun inRequestVoteRPC(req : HttpServerRequest) : HttpServerResponse {
    // TODO right now a malformed req body can crash the server
    const rvTerm : Int := parseInt(fieldValue(split(req.body, "|")[0]))
    const rvCand : Int := parseInt(fieldValue(split(req.body, "|")[1]))
    const rvLastIdx : Int := parseInt(fieldValue(split(req.body, "|")[2]))
    const rvLastTerm : Int := parseInt(fieldValue(split(req.body, "|")[3]))
    var respBody : String := ""
    var step : String := "handle"

    // TODO rename to: handleRequestVoteRequest
    transition receiveVoteRequest(
        inTerm : Int,
        candidateId : Int,
        lastLogIndex : Int,
        lastLogTerm : Int,
        outTerm : Int,
        voteGranted : Boolean
    ) {
        guard:
            & step = "handle"
            & inTerm = rvTerm
            & candidateId = rvCand
            & lastLogIndex = rvLastIdx
            & lastLogTerm = rvLastTerm
        transit:
            respBody := encodeRequestVoteResp(outTerm, voteGranted)
            step := "ret"
    }

    transition ret() {
        guard:
            step = "ret"
        return:
             HttpServerResponse {
                body := respBody,
                code := 200
            }
    }
}

/*
 * A RpcReqHandler get created for each incoming request.
*/
proc RpcReqHandler {
    const httpReq : HttpServerRequest
    var httpResp : HttpServerResponse
    var step : String

    session constructor receiveRequest(req : HttpServerRequest) {
        transit:
            httpReq := req
            //httpResp := HttpServerResponse { body := "", code := 500 }
            httpResp := when (req.path) {
                "raft/requestVote" -> inRequestVoteRPC(req)
                "raft/appendEntries" -> inAppendEntriesRPC(req)
                "client/append" -> inClientAppendRPC(req)
                "client/get" -> inClientGetRPC(req)
                else -> HttpServerResponse { body := "NOT_FOUND", code := 404 }
            }
            /*
            step := when (req.path) {
                "raft/requestVote" -> "startInRequestVoteRpc"
                "raft/appendEntries" -> "startInAppendEntriesRpc"
                "client/append" -> "startClientAppendRpc"
                "client/get" -> "startClientGetRpc"
                else -> "badPath"
            }
            */
    }

    /*
     * Handle bad paths.
    */
    internal transition badPath() {
        guard:
            step = "badPath"
        transit:
            httpResp := HttpServerResponse {
                body := "NOT_FOUND",
                code := 404
            }
            step := "sendResponse"
    }

    /*
     * Start and end incoming RequestVote RPCs.
    */

    session transition startInRequestVoteRpc(req : HttpServerRequest) {
        guard:
            & step = "startInRequestVoteRpc"
            & req = httpReq
        transit:
            step := "endInRequestVoteRpc"
    }

    session transition endInRequestVoteRpc(resp : HttpServerResponse) {
        guard:
            & step = "endInRequestVoteRpc"
        transit:
            step := "sendResponse"
            httpResp := resp
    }

    /*
     * Start and end incoming AppendEntries RPCs.
    */

    session transition startInAppendEntriesRpc(req : HttpServerRequest) {
        guard:
            & step = "startInAppendEntriesRpc"
            & req = httpReq
        transit:
            step := "endInAppendEntriesRpc"
    }

    session transition endInAppendEntriesRpc(resp : HttpServerResponse) {
        guard:
            & step = "endInAppendEntriesRpc"
        transit:
            step := "sendResponse"
            httpResp := resp
    }

    /*
     * Start and end ClientAppend RPCs.
    */

    session transition startClientAppendRpc(req : HttpServerRequest) {
        guard:
            & step = "startClientAppendRpc"
            & req = httpReq
        transit:
            step := "endClientAppendRpc"
    }

    session transition endClientAppendRpc(resp : HttpServerResponse) {
        guard:
            & step = "endClientAppendRpc"
        transit:
            step := "sendResponse"
            httpResp := resp
    }

    /*
     * Send the RPC response to the client.
    */
    session transition sendResponse(resp : HttpServerResponse) {
        guard:
            & step = "sendResponse"
            & resp = httpResp
        transit:
            step := "done"
    }
}

proc ServerInitializer {
    var started : Boolean
    var listenPort : Int

    constructor startServer(port : Int) {
        transit:
            started := false
            listenPort := port
        error:
            (port <= 0) -> "Invalid port passed to the server"
    }

    session transition createHttpServer(port : Int) {
        guard:
            & ~started
            & listenPort > 0
            & port = listenPort
        transit:
            started := true
    }

    session transition closeHttpServer() {
        guard: false
    }
}

/*
 * Process that routes incoming RPCs.
*/
export proc RpcIn := RpcReqHandler || ServerInitializer || HttpServer
