import julay.proclib.HttpServer
import julay.funlib.parseInt
import julay.funlib.split
import node.lib.fieldValue
import node.lib.encodeAppendEntriesResp
import node.lib.encodeRequestVoteResp

procfun inRequestVoteRPC(req : HttpServerRequest) : HttpServerResponse {
    // TODO right now a malformed req body can crash the server
    const rvTerm : Int := parseInt(fieldValue(split(req.body, "|")[0]))
    const rvCand : Int := parseInt(fieldValue(split(req.body, "|")[1]))
    const rvLastIdx : Int := parseInt(fieldValue(split(req.body, "|")[2]))
    const rvLastTerm : Int := parseInt(fieldValue(split(req.body, "|")[3]))
    var respBody : String := ""
    var step : String := "handle"

    // TODO rename to: handleRequestVoteRequest
    transition receiveVoteRequest(
        inTerm : Int,
        candidateId : Int,
        lastLogIndex : Int,
        lastLogTerm : Int,
        outTerm : Int,
        voteGranted : Boolean
    ) {
        guard:
            & step = "handle"
            & inTerm = rvTerm
            & candidateId = rvCand
            & lastLogIndex = rvLastIdx
            & lastLogTerm = rvLastTerm
        return:
             HttpServerResponse {
                body := encodeRequestVoteResp(outTerm, voteGranted),
                code := 200
            }
    }
}

procfun inAppendEntriesRPC(req :  HttpServerRequest) : HttpServerResponse {
    var step : String := "handle"
    var aeTerm : Int := parseInt(fieldValue(split(req.body, "|")[0]))
    var aeLeaderId : Int := parseInt(fieldValue(split(req.body, "|")[1]))
    var aePrevIdx : Int := parseInt(fieldValue(split(req.body, "|")[2]))
    var aePrevTerm : Int := parseInt(fieldValue(split(req.body, "|")[3]))
    var aeEntriesLen : Int := 0
    var aeEntryTerm : Int := parseInt(fieldValue(split(req.body, "|")[5]))
    var aeEntryValue : String := fieldValue(split(req.body, "|")[6])
    var aeLeaderCommit : Int := parseInt(fieldValue(split(req.body, "|")[7]))
    var respBody : String := ""

    // TODO rename to: handleAppendEntriesRequest
    transition receiveAppendEntries(
        inTerm : Int, leaderId : Int, prevLogIndex : Int, prevLogTerm : Int,
        entriesLen : Int, entryTerm : Int, entryValue : String, leaderCommit : Int,
        outTerm : Int, success : Boolean, matchIdx : Int
    ) {
        guard:
            & step = "handle"
            & inTerm = aeTerm & leaderId = aeLeaderId
            & prevLogIndex = aePrevIdx & prevLogTerm = aePrevTerm
            & entriesLen = aeEntriesLen & entryTerm = aeEntryTerm
            & entryValue = aeEntryValue & leaderCommit = aeLeaderCommit
        return:
            HttpServerResponse {
                body := encodeAppendEntriesResp(outTerm, success, matchIdx),
                code := 200
            }
    }
}

procfun clientAppendRPC(req : HttpServerRequest) : HttpServerResponse {
    var step : String := "clientRequest"
    var appendIdx : Int := -1

    transition clientRequest(value : String, idx : Int) {
        guard:
            & step = "clientRequest"
            & value = req.body
        transit:
            step := "waitForCommit"
            appendIdx := idx
    }

    /*
     * Per the RaftProtocol, respond to the client once the value is committed.
    */
    client transition committed(value : String, idx : Int) {
        guard:
            & step = "waitForCommit"
            & value = req.body
            & idx = appendIdx
        return:
            HttpServerResponse {
                body := "OK " + appendIdx,
                code := 200
            }
    }

    transition leaderRedirect(leader : Node) {
        return:
            HttpServerResponse {
                body := "LEADER " + leader.url,
                code := 303
            }
    }

    transition noLeader() {
        return:
            HttpServerResponse {
                body := "NO_LEADER",
                code := 503
            }
    }
}

procfun clientGetRPC(req : HttpServerRequest) : HttpServerResponse {
    client transition getCommitted(stateMachine : List<String>) {
        return:
            HttpServerResponse {
                body := stateMachine + "",
                code := 200
            }
    }
}

/*
 * A RpcReqHandler get created for each incoming request.
*/
proc RpcReqHandler {
    const httpReq : HttpServerRequest
    var httpResp : HttpServerResponse
    var step : String

    session constructor receiveRequest(req : HttpServerRequest) {
        transit:
            httpReq := req
            //httpResp := HttpServerResponse { body := "", code := 500 }
            httpResp := when (req.path) {
                "raft/requestVote" -> inRequestVoteRPC(req)
                "raft/appendEntries" -> inAppendEntriesRPC(req)
                "client/append" -> clientAppendRPC(req)
                "client/get" -> clientGetRPC(req)
                else -> HttpServerResponse { body := "NOT_FOUND", code := 404 }
            }
            /*
            step := when (req.path) {
                "raft/requestVote" -> "startInRequestVoteRpc"
                "raft/appendEntries" -> "startInAppendEntriesRpc"
                "client/append" -> "startClientAppendRpc"
                "client/get" -> "startClientGetRpc"
                else -> "badPath"
            }
            */
    }

    /*
     * Handle bad paths.
    */
    internal transition badPath() {
        guard:
            step = "badPath"
        transit:
            httpResp := HttpServerResponse {
                body := "NOT_FOUND",
                code := 404
            }
            step := "sendResponse"
    }

    /*
     * Start and end incoming RequestVote RPCs.
    */

    session transition startInRequestVoteRpc(req : HttpServerRequest) {
        guard:
            & step = "startInRequestVoteRpc"
            & req = httpReq
        transit:
            step := "endInRequestVoteRpc"
    }

    session transition endInRequestVoteRpc(resp : HttpServerResponse) {
        guard:
            & step = "endInRequestVoteRpc"
        transit:
            step := "sendResponse"
            httpResp := resp
    }

    /*
     * Start and end incoming AppendEntries RPCs.
    */

    session transition startInAppendEntriesRpc(req : HttpServerRequest) {
        guard:
            & step = "startInAppendEntriesRpc"
            & req = httpReq
        transit:
            step := "endInAppendEntriesRpc"
    }

    session transition endInAppendEntriesRpc(resp : HttpServerResponse) {
        guard:
            & step = "endInAppendEntriesRpc"
        transit:
            step := "sendResponse"
            httpResp := resp
    }

    /*
     * Start and end ClientAppend RPCs.
    */

    session transition startClientAppendRpc(req : HttpServerRequest) {
        guard:
            & step = "startClientAppendRpc"
            & req = httpReq
        transit:
            step := "endClientAppendRpc"
    }

    session transition endClientAppendRpc(resp : HttpServerResponse) {
        guard:
            & step = "endClientAppendRpc"
        transit:
            step := "sendResponse"
            httpResp := resp
    }

    /*
     * Send the RPC response to the client.
    */
    session transition sendResponse(resp : HttpServerResponse) {
        guard:
            & step = "sendResponse"
            & resp = httpResp
        transit:
            step := "done"
    }
}

proc ServerInitializer {
    var started : Boolean
    var listenPort : Int

    constructor startServer(port : Int) {
        transit:
            started := false
            listenPort := port
        error:
            (port <= 0) -> "Invalid port passed to the server"
    }

    session transition createHttpServer(port : Int) {
        guard:
            & ~started
            & listenPort > 0
            & port = listenPort
        transit:
            started := true
    }

    session transition closeHttpServer() {
        guard: false
    }
}

/*
 * Process that routes incoming RPCs.
*/
export proc RpcIn := RpcReqHandler || ServerInitializer || HttpServer
