import julay.proclib.HttpServer

/*
 * A RpcReqHandler get created for each incoming request.
*/
proc RpcReqHandler {
    const httpReq : HttpServerRequest
    var httpResp : HttpServerResponse
    var step : String

    session constructor receiveRequest(req : HttpServerRequest) {
        transit:
            httpReq := req
            httpResp := HttpServerResponse { body := "", code := 500 }
            step := when (req.path) {
                "raft/requestVote" -> "startInRequestVoteRpc"
                "raft/appendEntries" -> "startInAppendEntriesRpc"
                "client/append" -> "startClientAppendRpc"
                "client/get" -> "startClientGetRpc"
                else -> "badPath"
            }
    }

    /*
     * Handle bad paths.
    */
    internal transition badPath() {
        guard:
            step = "badPath"
        transit:
            httpResp := HttpServerResponse {
                body := "NOT_FOUND",
                code := 404
            }
            step := "sendResponse"
    }

    /*
     * Start and end incoming RequestVote RPCs.
    */

    session transition startInRequestVoteRpc(req : HttpServerRequest) {
        guard:
            & step = "startInRequestVoteRpc"
            & req = httpReq
        transit:
            step := "endInRequestVoteRpc"
    }

    session transition endInRequestVoteRpc(resp : HttpServerResponse) {
        guard:
            & step = "endInRequestVoteRpc"
        transit:
            step := "sendResponse"
            httpResp := resp
    }

    /*
     * Start and end incoming AppendEntries RPCs.
    */

    session transition startInAppendEntriesRpc(req : HttpServerRequest) {
        guard:
            & step = "startInAppendEntriesRpc"
            & req = httpReq
        transit:
            step := "endInAppendEntriesRpc"
    }

    session transition endInAppendEntriesRpc(resp : HttpServerResponse) {
        guard:
            & step = "endInAppendEntriesRpc"
        transit:
            step := "sendResponse"
            httpResp := resp
    }

    /*
     * Start and end ClientAppend RPCs.
    */

    session transition startClientAppendRpc(req : HttpServerRequest) {
        guard:
            & step = "startClientAppendRpc"
            & req = httpReq
        transit:
            step := "endClientAppendRpc"
    }

    session transition endClientAppendRpc(resp : HttpServerResponse) {
        guard:
            & step = "endClientAppendRpc"
        transit:
            step := "sendResponse"
            httpResp := resp
    }

    /*
     * Send the RPC response to the client.
    */
    session transition sendResponse(resp : HttpServerResponse) {
        guard:
            & step = "sendResponse"
            & resp = httpResp
        transit:
            step := "done"
    }
}

proc ServerInitializer {
    var started : Boolean
    var myPort : Int

    constructor initially(args : List<String>) {
        transit:
            started := false
            myPort := 0
    }

    client transition getListenPort(port : Int) {
        guard:
            & ~started
            & myPort = 0
        transit:
            myPort := port
        error:
            (port <= 0) -> "Invalid port passed to the server"
    }

    session transition createHttpServer(port : Int) {
        guard:
            & ~started
            & myPort > 0
            & port = myPort
        transit:
            started := true
    }

    session transition closeHttpServer() {
        guard: false
    }
}

/*
 * Process that routes incoming RPCs.
*/
export proc RpcIn := RpcReqHandler || ServerInitializer || HttpServer
