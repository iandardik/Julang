import julay.funlib.split
import julay.funlib.parseInt
import node.lib.fieldValue
import node.lib.Node
import node.lib.encodeRequestVote
import node.lib.encodeRequestVoteResp
import node.lib.parseBool

/*
 * RequestVote RPCs (incoming and outgoing).
 */

proc IncomingRequestVoteRPC {
    var rvTerm : Int
    var rvCand : Int
    var rvLastIdx : Int
    var rvLastTerm : Int
    var respBody : String
    var step : String

    constructor beginIncomingRequestVote(req : HttpServerRequest) {
        transit:
            rvTerm := parseInt(fieldValue(split(req.body, "|")[0]))
            rvCand := parseInt(fieldValue(split(req.body, "|")[1]))
            rvLastIdx := parseInt(fieldValue(split(req.body, "|")[2]))
            rvLastTerm := parseInt(fieldValue(split(req.body, "|")[3]))
            respBody := ""
            step := "handle"
    }

    transition receiveVoteRequest(
        inTerm : Int,
        candidateId : Int,
        lastLogIndex : Int,
        lastLogTerm : Int,
        outTerm : Int,
        voteGranted : Boolean
    ) {
        guard:
            & step = "handle"
            & inTerm = rvTerm
            & candidateId = rvCand
            & lastLogIndex = rvLastIdx
            & lastLogTerm = rvLastTerm
        transit:
            respBody := encodeRequestVoteResp(outTerm, voteGranted)
            step := "resp"
    }

    transition endIncomingRequestVote(body : String, code : Int) {
        guard:
            & step = "resp"
            & body = respBody
            & code = 200
        transit:
            step := "done"
    }
}

proc OutgoingRequestVoteRPC {
    const cPeer : Node
    const cTerm : Int
    const cCandId : Int
    const cLastIdx : Int
    const cLastTerm : Int
    const cReqBody : String
    var step : String
    var respBody : String
    var voteTerm : Int
    var voteGrantedFlag : Boolean

    constructor beginOutgoingRequestVote(
        peer : Node,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastTerm : Int
    ) {
        transit:
            cPeer := peer
            cTerm := term
            cCandId := candId
            cLastIdx := lastIdx
            cLastTerm := lastTerm
            cReqBody := encodeRequestVote(term, candId, lastIdx, lastTerm)
            respBody := ""
            voteTerm := 0
            voteGrantedFlag := false
            step := "beginHttp"
    }

    transition beginHttpRequestVote(peerUrl : String, reqBody : String) {
        guard:
            & step = "beginHttp"
            & peerUrl = cPeer.url
            & reqBody = cReqBody
        transit:
            step := "awaitHttp"
    }

    transition endHttpRequestVote(respOut : String) {
        guard:
            step = "awaitHttp"
        transit:
            respBody := respOut
            step := "parse"
    }

    internal transition parseVote() {
        guard:
            step = "parse"
        transit:
            voteTerm := parseInt(fieldValue(split(respBody, "|")[0]))
            voteGrantedFlag := parseBool(fieldValue(split(respBody, "|")[1]))
            step := "tally"
    }

    /* Pairwise with CandidateElection: hand off vote result (election records it with Core). */
    transition endOutgoingRequestVote(peerId : Int, term : Int, granted : Boolean) {
        guard:
            & step = "tally"
            & peerId = cPeer.id
            & term = voteTerm
            & granted = voteGrantedFlag
        transit:
            step := "done"
    }
}
