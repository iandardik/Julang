import julay.funlib.length
import julay.funlib.max
import node.election_timeout.ElectionTimeout
import node.leader_heartbeat.LeaderHeartbeat
import node.lib.Entry
import node.lib.Node
import node.lib.AppendEntriesData
import node.lib.Value
import node.lib.entryValueAt
import node.lib.entryTermAt
import node.lib.noneNode
import node.lib.nodeById
import node.lib.batchForPeer
import node.lib.maxBatchEntries
import node.lib.applyAppendEntries
import node.lib.aeConflictIndex
import node.lib.aeConflictTerm
import node.lib.commitJumpTo
import node.rpc_in.RpcIn
import node.rpc_out.RpcOut
import node.vote_requester.VoteRequester
import julay.funlib.listOf
import julay.funlib.setOf
import julay.funlib.splice
import julay.optional.Optional
import julay.optional.some

export api RaftCore {
    proc: RaftProtocol || ElectionTimeout || VoteRequester || LeaderHeartbeat || RpcIn || RpcOut
}

export proc RaftProtocol {
    const self : Node
    const cluster : Set<Node>
    var currentTerm : Int
    var state : String
    var votedFor : Optional<Node>
    var log : List<Entry>
    var lastLogTerm : Int
    var commitIndex : Int
    var votesGranted : Set<Node>
    var votesResponded : Set<Node>
    var knownLeader : Optional<Node>
    var nextIndex : Map<Node, Int>
    var matchIndex : Map<Node, Int>

    constructor startRaftCore(me : Node, cluster : Set<Node>) {
        transit:
            // Async start: spawns a worker that syncs startElectionTimeout with ElectionTimeout.
            let _ : Boolean := ElectionTimeout.startElectionTimeout(me, 0)
            self := me
            cluster := cluster
            currentTerm := 0
            state := "Follower"
            votedFor := noneNode()
            log := listOf()
            lastLogTerm := 0
            commitIndex := 0
            votesGranted := setOf()
            votesResponded := setOf()
            knownLeader := noneNode()
            nextIndex := cluster.associateWith(n -> 1)
            matchIndex := cluster.associateWith(n -> 0)
        error:
            (me ~in cluster) -> "Invalid config: node not in cluster"
            length(cluster.map(n -> n.id)) ~= length(cluster) -> "Invalid config: duplicate node IDs"
    }

    /*
     * The "Timeout" transition in the Raft protocol.
     * Start ElectionTimeout for the new term. Re-start via async startElectionTimeout —
     * safe mid-sync because it returns without blocking on the election-timer peer.
     */
    transition electionTimeout() {
        guard:
            state in setOf("Follower", "Candidate")
        transit:
            let newTerm : Int := currentTerm + 1
            let _ : Boolean := ElectionTimeout.startElectionTimeout(self, newTerm)
            state := "Candidate"
            currentTerm := newTerm
            votedFor := some(self)
            votesGranted := setOf(self)
            votesResponded := setOf(self)
            knownLeader := noneNode()
    }

    /*
     * Request a vote from the target node.
     */
    transition requestVote(target : Node, payload : VoteRequestData) {
        guard:
            & state = "Candidate"
            & target in cluster
            & target ~in votesResponded
            & payload = VoteRequestData {
                term := currentTerm,
                candidateId := self.id,
                lastLogIndex := length(log),
                lastLogTerm := lastLogTerm
            }
    }

    transition appendEntries(target : Node, payload : AppendEntriesData) {
        guard:
            & target in cluster
            & target ~= self
            & state = "Leader"
            & payload = if (nextIndex[target] <= length(log)) {
                let (nextLogIndex : Int := nextIndex[target])
                let (prevLogIndex : Int := nextLogIndex - 1)
                let (prevLogTerm : Int := if (prevLogIndex > 0) entryTermAt(log, prevLogIndex) else 0)
                let (batch : List<Entry> := batchForPeer(log, nextLogIndex, maxBatchEntries())) {
                    AppendEntriesData {
                        term := currentTerm,
                        leaderId := self.id,
                        prevLogIndex := prevLogIndex,
                        prevLogTerm := prevLogTerm,
                        entries := batch,
                        entriesLen := length(batch),
                        leaderCommit := commitIndex
                    }
                }
            }
            else {
                AppendEntriesData {
                    term := currentTerm,
                    leaderId := self.id,
                    prevLogIndex := length(log),
                    prevLogTerm := lastLogTerm,
                    entries := listOf<Entry>(),
                    entriesLen := 0,
                    leaderCommit := commitIndex
                }
            }
    }

    internal transition becomeLeader() {
        guard:
            & state = "Candidate"
            & length(votesGranted) * 2 > length(cluster)
        transit:
            let _ : Boolean := ElectionTimeout.stopElectionTimeout(currentTerm)
            let _ : Boolean := LeaderHeartbeat.startLeaderHeartbeat(self, currentTerm, cluster)
            state := "Leader"
            knownLeader := some(self)
            nextIndex := cluster.associateWith(n -> length(log) + 1)
            matchIndex := cluster.associateWith(n -> 0)
    }

    // TODO do we really need to send back the idx to the client?
    provider transition clientRequest(value : Value, idx : Int) {
        guard:
            & state = "Leader"
            & idx = length(log) + 1
        transit:
            let _ : Boolean := LeaderHeartbeat.eagerReplication()
            log := log + listOf(Entry { term := currentTerm, value := value })
            lastLogTerm := currentTerm
    }

    /*
     * True iff some other node still needs log entries (nextIndex behind tip).
     * LeaderHeartbeat uses this after each AE round to choose catch-up vs idle wait.
     */
    transition logOutdated(outdated : Boolean) {
        guard:
            & state = "Leader"
            & let (numOutdatedLogIndices : Int :=
                nextIndex.keys.filter(n -> n ~= self & nextIndex[n] <= length(log)).length) {
                outdated <=> (numOutdatedLogIndices > 0)
            }
    }

    // B1 backup: step +1 when a response jump did not cover contiguous commit.
    // Primary jump is in handleAppendEntriesResponse via commitJumpTo.
    // Quorum filter uses commitIndex (state), not newCommitIndex (symbolic arg).
    internal transition advanceCommitIndex(newCommitIndex : Int) {
        guard:
            & state = "Leader"
            & newCommitIndex = commitIndex + 1
            & newCommitIndex <= length(log)
            & entryTermAt(log, newCommitIndex) = currentTerm
            & let (numAgree : Int := 1 + matchIndex.keys.filter(k -> matchIndex[k] > commitIndex).length) {
                numAgree * 2 > length(cluster)
            }
        transit:
            commitIndex := newCommitIndex
    }

    provider transition handleRequestVoteRequest(
        inTerm : Int,
        candidateId : Int,
        lastLogIndex : Int,
        lastLogTerm : Int,
        outTerm : Int,
        voteGranted : Boolean
    ) {
        guard:
            let (logOk : Boolean :=
                (lastLogTerm > this.lastLogTerm) | (lastLogTerm = this.lastLogTerm & lastLogIndex >= length(log))) {
            let (voteCondition : Boolean := inTerm = currentTerm & (~votedFor.present | votedFor.value.id = candidateId) & logOk) {
                & inTerm <= currentTerm
                & outTerm = currentTerm
                & (voteGranted <=> voteCondition)
            }}
        transit:
            votedFor := if (voteGranted) some(nodeById(cluster, candidateId)) else votedFor
    }

    provider transition handleRequestVoteResponse(peer : Node, term : Int, granted : Boolean) {
        guard:
            & state = "Candidate"
            & term = currentTerm
        transit:
            votesGranted := if (granted) votesGranted + setOf(peer) else votesGranted
            votesResponded := votesResponded + setOf(peer)
    }

    provider transition handleAppendEntriesRequest(
        inTerm : Int,
        leaderId : Int,
        prevLogIndex : Int,
        prevLogTerm : Int,
        entries : List<Entry>,
        leaderCommit : Int,
        outTerm : Int,
        success : Boolean,
        matchIdx : Int,
        conflictTerm : Int
    ) {
        guard:
            & inTerm <= currentTerm
            & outTerm = currentTerm
            & length(entries) <= maxBatchEntries()
            & (
                | (
                    & ~success
                    & (
                        | (
                            & inTerm < currentTerm
                            & matchIdx = 0
                            & conflictTerm = 0
                        )
                        | (
                            & inTerm = currentTerm
                            & (
                                | (prevLogIndex > length(log))
                                | (
                                    & prevLogIndex >= 1
                                    & prevLogIndex <= length(log)
                                    & entryTermAt(log, prevLogIndex) ~= prevLogTerm
                                )
                            )
                            & matchIdx = aeConflictIndex(log, prevLogIndex)
                            & conflictTerm = aeConflictTerm(log, prevLogIndex)
                        )
                    )
                )
                | (
                    & success
                    & inTerm = currentTerm
                    & conflictTerm = 0
                    & matchIdx = prevLogIndex + length(entries)
                    & (
                        | (prevLogIndex = 0)
                        | (
                            & prevLogIndex >= 1
                            & prevLogIndex <= length(log)
                            & entryTermAt(log, prevLogIndex) = prevLogTerm
                        )
                    )
                )
            )
        transit:
            // Any AE for our current term is from the leader for this term (paper §5.2);
            // reset election timeout on conflict as well as success so catch-up cannot
            // race a local electionTimeout.
            let _ : Boolean := if (inTerm = currentTerm) {
                ElectionTimeout.gotHeartbeat()
            } else true
            let applied : List<Entry> := if (success & length(entries) > 0) {
                applyAppendEntries(log, prevLogIndex, entries)
            } else {
                log
            }
            knownLeader := if (inTerm = currentTerm) some(nodeById(cluster, leaderId)) else knownLeader
            state := if (inTerm = currentTerm) "Follower" else state
            log := applied
            lastLogTerm := if (success & length(entries) > 0) {
                entryTermAt(applied, prevLogIndex + length(entries))
            } else {
                lastLogTerm
            }
            commitIndex := if (success & leaderCommit > commitIndex) {
                let (lastNew : Int := prevLogIndex + length(entries)) {
                    let (bound : Int := if (length(entries) = 0) length(applied) else lastNew) {
                        if (leaderCommit < bound) leaderCommit else bound
                    }
                }
            } else {
                commitIndex
            }
    }

    provider transition handleAppendEntriesResponse(
        peer : Node,
        inTerm : Int,
        success : Boolean,
        matchIdx : Int,
        conflictTerm : Int
    ) {
        guard:
            & state = "Leader"
            & inTerm = currentTerm
        transit:
            let advNext : Int := if (success) {
                max(matchIdx + 1, nextIndex[peer])
            } else {
                // B2: jump to conflict index (matchIdx); fall back to -1 if no hint.
                max(1, if (matchIdx > 0) matchIdx else max(nextIndex[peer] - 1, 1))
            }
            let newMatch : Int := if (success) {
                max(matchIdx, matchIndex[peer])
            } else {
                matchIndex[peer]
            }
            let updatedMatch : Map<Node, Int> := matchIndex.keys.associateWith(
                k -> if (k = peer) newMatch else matchIndex[k]
            )
            nextIndex[peer] := advNext
            matchIndex[peer] := newMatch
            // B1: jump commit toward the peer's new match index when quorum allows.
            commitIndex := commitJumpTo(
                commitIndex, log, currentTerm, updatedMatch, length(cluster), newMatch
            )
    }

    /*
     * Any RPC with a newer term advances us first.
     * Always syncable; no-op when inTerm <= currentTerm.
     */
    provider transition updateTerm(inTerm : Int) {
        transit:
            let advance : Boolean := inTerm > currentTerm
            let wasLeader : Boolean := state = "Leader"
            // Stop heartbeat on leader step-down.
            let _ : Boolean := if (advance & wasLeader) {
                LeaderHeartbeat.stopLeaderHeartbeat()
            } else { true }
            // Async start of ElectionTimeout (safe mid-provider sync).
            let _ : Boolean := if (advance) {
                ElectionTimeout.startElectionTimeout(self, inTerm)
            } else { true }
            currentTerm := if (advance) inTerm else currentTerm
            state := if (advance) "Follower" else state
            votedFor := if (advance) noneNode() else votedFor
            knownLeader := if (advance) noneNode() else knownLeader
            votesGranted := if (advance) {
                setOf()
            } else { votesGranted }
    }

    provider transition dropStaleResponse(respTerm : Int, drop : Boolean) {
        guard:
            drop <=> (respTerm < currentTerm)
    }


    
    /*
     * Getter actions that are not technically part of the protocol.
    */

    provider transition committed(value : Value, idx : Int) {
        guard:
            & state = "Leader"
            & idx > 0
            & idx <= length(log)
            & idx <= commitIndex
            & value = entryValueAt(log, idx)
    }

    provider transition noLeader() {
        guard:
            & state ~= "Leader"
            & ~knownLeader.present
    }

    provider transition getCommitted(stateMachine : List<String>) {
        guard: stateMachine = splice(log, 1, commitIndex).map(e -> e.value)
    }

    provider transition staleTerm(term : Int) {
        guard: term < currentTerm
    }

    // TODO should be able to delete this
    provider transition leaderRedirect(leader : Node) {
        guard:
            & state ~= "Leader"
            & knownLeader.present
            & knownLeader.value = leader
    }
}
