import julay.funlib.length
import node.lib.Entry
import node.lib.Node
import node.lib.AppendEntriesData
import node.lib.entryValueAt

/*
 * Local Raft state for one node.
 * RaftCore is a singleton--one RaftCore is expected to live on each node.
 * Peer URLs live in ClusterInfo; this core tracks leaderId for redirects.
 * RaftCore is the sole constructor of FollowerHeartbeat, CandidateElection, and LeaderHeartbeat.
 */

export proc RaftCore {
    const selfId : Int
    const clusterSize : Int
    var self : Node
    var currentTerm : Int
    var state : String
    var votedFor : Int
    var log : List<Entry>
    var lastLogTermVar : Int
    var commitIndex : Int
    var lastApplied : Int
    var stateMachine : List<String>
    var votesGranted : Set<Int>
    var voteCount : Int
    var knownLeaderId : Int
    var electionEpoch : Int
    var startFollowerHeartbeat : Boolean
    var startElection : Boolean
    var startLeaderHeartbeat : Boolean

    constructor startRaftCore(id : Int, n : Int, url : String) {
        transit:
            selfId := id
            clusterSize := n
            self := Node { id := id, url := url }
            currentTerm := 0
            state := "Follower"
            votedFor := -1
            log := []
            lastLogTermVar := 0
            commitIndex := 0
            lastApplied := 0
            stateMachine := []
            votesGranted := {}
            voteCount := 0
            knownLeaderId := -1
            electionEpoch := 0
            startFollowerHeartbeat := true
            startElection := false
            startLeaderHeartbeat := false
    }

    /*
     * A candidate (from a different node) is requesting a vote from us.
     * Simplified RequestVote: grant if term ok and log at least as long
     */
    transition receiveVoteRequest(
        inTerm : Int,
        candidateId : Int,
        lastLogIndex : Int,
        lastLogTerm : Int,
        outTerm : Int,
        voteGranted : Boolean
    ) {
        guard:
            & candidateId >= 0 & candidateId < clusterSize
            & (
                | (
                    & inTerm > currentTerm
                    & outTerm = inTerm
                    & (
                        | (voteGranted & lastLogIndex >= length(log))
                        | (~voteGranted & lastLogIndex < length(log))
                    )
                )
                | (
                    & inTerm = currentTerm
                    & outTerm = currentTerm
                    & (
                        | (voteGranted & (votedFor = -1 | votedFor = candidateId) & lastLogIndex >= length(log))
                        | (~voteGranted & ~((votedFor = -1 | votedFor = candidateId) & lastLogIndex >= length(log)))
                    )
                )
                | (inTerm < currentTerm & outTerm = currentTerm & ~voteGranted)
            )
        transit:
            votedFor := if (voteGranted) { candidateId } else { if (inTerm > currentTerm) { -1 } else { votedFor } }
            state := if (inTerm > currentTerm) { "Follower" } else { state }
            knownLeaderId := if (inTerm > currentTerm) { -1 } else { knownLeaderId }
            electionEpoch := if (inTerm > currentTerm) { electionEpoch + 1 } else { electionEpoch }
            currentTerm := if (inTerm > currentTerm) { inTerm } else { currentTerm }
    }

    /*
     * Start the FollowerHeartbeat process.
     */
    transition startFollowerHeartbeat(me : Node, n : Int) {
        guard:
            & startFollowerHeartbeat
            & me = self
            & n = clusterSize
        transit:
            startFollowerHeartbeat := false
    }

    /*
     * The FollowerHeartbeat process did not receive a heartbeat from
     * a leader within the allotted timeout, and is now notifying /this/
     * process.
     */
    transition becomeCandidate(
        epoch : Int,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastT : Int
    ) {
        guard:
            & (state = "Follower" | state = "Candidate")
            & epoch = electionEpoch
            & term = currentTerm + 1
            & candId = selfId
            & lastIdx = length(log)
            & lastT = lastLogTermVar
        transit:
            state := "Candidate"
            currentTerm := currentTerm + 1
            votedFor := selfId
            votesGranted := {selfId}
            voteCount := 1
            electionEpoch := electionEpoch + 1
            knownLeaderId := -1
            startElection := true
    }

    /*
     * After the FollowerHeartbeat tells us to start an election, this
     * process now starts a CandidateElection process in attempt to become
     * the new leader.
     */
    transition startElection(
        me : Node,
        n : Int,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastTerm : Int
    ) {
        guard:
            & startElection
            & me = self
            & n = clusterSize
            & term = currentTerm
            & candId = selfId
            & lastIdx = length(log)
            & lastTerm = lastLogTermVar
        transit:
            startElection := false
    }

    /*
     * Received a vote from another node--record it to see if we can garner a quorum.
     */
    transition recordVote(peerId : Int, term : Int, granted : Boolean) {
        guard:
            & state = "Candidate"
            & term = currentTerm
            & peerId >= 0
            & peerId < clusterSize
        transit:
            votesGranted := if (granted) { votesGranted + {peerId} } else { votesGranted }
            voteCount := if (granted) { voteCount + 1 } else { voteCount }
    }

    /*
     * CandidateElection failed to win quorum; spawn a new FollowerHeartbeat.
     */
    transition candidateElectionLost() {
        guard:
            state = "Candidate"
        transit:
            startFollowerHeartbeat := true
    }

    /*
     * We have received enough votes to become the leader!
     */
    transition becomeLeader() {
        guard:
            & state = "Candidate"
            & voteCount * 2 > clusterSize
        transit:
            state := "Leader"
            knownLeaderId := selfId
            electionEpoch := electionEpoch + 1
            startLeaderHeartbeat := true
    }

    /*
     * Spawn LeaderHeartbeat after winning an election.
     */
    transition startLeaderHeartbeat(me : Node, n : Int) {
        guard:
            & startLeaderHeartbeat
            & me = self
            & n = clusterSize
        transit:
            startLeaderHeartbeat := false
    }

    /*
     * LeaderHeartbeat detected demotion; spawn a new FollowerHeartbeat.
     */
    transition lostLeadership() {
        guard:
            state ~= "Leader"
        transit:
            startFollowerHeartbeat := true
    }

    /*
     * A ClientRequest message--add it to the log
     */
    transition clientAppendRequest(value : String, ok : Boolean, idx : Int) {
        guard:
            let (newLogLen : Int := length(log) + 1) {
                | (state = "Leader" & ok & idx = newLogLen)
                | (state ~= "Leader" & ~ok & idx = 0)
            }
        transit:
            log := if (state = "Leader") {
                log + [Entry { term := currentTerm, value := value }]
            } else {
                log
            }
            lastLogTermVar := if (state = "Leader") { currentTerm } else { lastLogTermVar }
            commitIndex := if (state = "Leader") {
                let (newLogLen : Int := length(log) + 1) { newLogLen }
            } else {
                commitIndex
            }
    }

    /*
     * Send an AppendEntries message to a follower.
     * Pairwise with OutgoingAppendEntriesRPC (Heartbeat advances via endOutgoingAppendEntries).
     */
    transition sendAppendEntries(
        peerId : Int,
        inTerm : Int,
        success : Boolean,
        matchIdx : Int
    ) {
        guard:
            & state = "Leader"
            & peerId >= 0
            & peerId < clusterSize
            & inTerm = currentTerm
        transit:
            commitIndex := if (success & matchIdx > commitIndex) { matchIdx } else { commitIndex }
    }

    /*
     * Receive an AppendEntries message from a leader.
     */
    transition receiveAppendEntries(
        inTerm : Int,
        leaderId : Int,
        prevLogIndex : Int,
        prevLogTerm : Int,
        entriesLen : Int,
        entryTerm : Int,
        entryValue : String,
        leaderCommit : Int,
        outTerm : Int,
        success : Boolean,
        matchIdx : Int
    ) {
        guard:
            & leaderId >= 0
            & leaderId < clusterSize
            & (
                | (inTerm < currentTerm & outTerm = currentTerm & ~success & matchIdx = 0)
                | (
                    & inTerm >= currentTerm
                    & outTerm = inTerm
                    & success
                    & matchIdx = length(log)
                    & entriesLen = 0
                )
            )
        transit:
            votedFor := if (inTerm > currentTerm) { -1 } else { votedFor }
            state := if (inTerm >= currentTerm) { "Follower" } else { state }
            knownLeaderId := if (inTerm >= currentTerm) { leaderId } else { knownLeaderId }
            electionEpoch := if (inTerm >= currentTerm) { electionEpoch + 1 } else { electionEpoch }
            currentTerm := if (inTerm > currentTerm) { inTerm } else { currentTerm }
            commitIndex := if (inTerm >= currentTerm & leaderCommit > commitIndex) {
                leaderCommit
            } else {
                commitIndex
            }
    }

    internal transition applyEntryToStateMachine() {
        guard:
            & lastApplied < commitIndex
            & lastApplied < length(log)
        transit:
            stateMachine := stateMachine + [entryValueAt(log, lastApplied)]
            lastApplied := lastApplied + 1
    }


    /*
     * The provider transitions that RaftCore offers for accessing its info.
     * Essentially, the transitions below are getters.
     */

    provider transition getIsLeader(isLeader : Boolean) {
        guard: isLeader <=> (state = "Leader")
    }

    provider transition hasQuorum(flag : Boolean) {
        guard:
            & state = "Candidate"
            & ((flag & voteCount * 2 > clusterSize) | (~flag & voteCount * 2 <= clusterSize))
    }

    provider transition getElectionSnapshot(
        epoch : Int,
        term : Int,
        candId : Int,
        lastIdx : Int,
        lastT : Int,
        role : String
    ) {
        guard:
            & epoch = electionEpoch
            & term = currentTerm
            & candId = selfId
            & lastIdx = length(log)
            & lastT = lastLogTermVar
            & role = state
    }

    provider transition getSerializedStateMachine(serializedSM : String, isLeader : Boolean) {
        guard:
            | (state = "Leader" & isLeader & serializedSM = stateMachine + "")
            | (state ~= "Leader" & ~isLeader & serializedSM = "")
    }

    /* Follower redirect: known leader id, or hasLeader false when unknown. */
    provider transition getRedirectLeader(leaderIdOut : Int, hasLeader : Boolean) {
        guard:
            & state ~= "Leader"
            & (
                | (hasLeader & leaderIdOut = knownLeaderId & knownLeaderId >= 0)
                | (~hasLeader & leaderIdOut = -1 & knownLeaderId < 0)
            )
    }

    provider transition getLogMetadata(data : AppendEntriesData) {
        guard:
            & state = "Leader"
            & data = AppendEntriesData {
                term := currentTerm,
                leaderId := selfId,
                prevLogIndex := length(log),
                prevLogTerm := lastLogTermVar,
                entryTerm := 0,
                entryValue := "",
                entriesLen := 0,
                leaderCommit := commitIndex
            }
    }
}
