import julay.funlib.length
import julay.funlib.max
import node.election_timeout.ElectionTimeout
import node.leader_heartbeat.LeaderHeartbeat
import node.lib.Entry
import node.lib.Node
import node.lib.AppendEntriesData
import node.lib.entryValueAt
import node.lib.entryTermAt
import node.rpc_in.RpcIn
import node.rpc_out.RpcOut
import node.vote_requester.VoteRequester
import julay.funlib.listOf
import julay.funlib.setOf
import julay.funlib.splice

export api RaftCore {
    proc: RaftProtocol || ElectionTimeout || VoteRequester || LeaderHeartbeat || RpcIn || RpcOut
}

export proc RaftProtocol {
    const self : Node
    const cluster : List<Node>
    var currentTerm : Int
    var state : String
    var votedFor : Int
    var log : List<Entry>
    var lastLogTermVar : Int
    var commitIndex : Int
    var votesGranted : Set<Int>
    var votesResponded : Set<Int> //Set<Node>
    var knownLeaderId : Int
    var nextIndex : List<Int> // Map<Int, Int>
    var matchIndex : List<Int> // Map<Int, Int>

    constructor startRaftCore(me : Node, cluster : List<Node>) {
        transit:
            let _ : Boolean := ElectionTimeout.startElectionTimeout(me, 0)
            self := me
            cluster := cluster
            currentTerm := 0
            state := "Follower"
            votedFor := -1
            log := listOf()
            lastLogTermVar := 0
            commitIndex := 0
            votesGranted := setOf()
            votesResponded := setOf()
            knownLeaderId := -1
            nextIndex := cluster.map(n -> 1)
            matchIndex := cluster.map(n -> 0)
    }

    /*
     * The "Timeout" transition in the Raft protocol.
    */
    transition electionTimeout() {
        guard:
            state = "Follower" | state = "Candidate"
        transit:
            let _ : Boolean := ElectionTimeout.startElectionTimeout(self, currentTerm + 1)
            state := "Candidate"
            currentTerm := currentTerm + 1
            votedFor := self.id
            votesGranted := setOf(self.id)
            votesResponded := setOf(self.id)
            knownLeaderId := -1
    }

    /*
     * Request a vote from the target node.
    */
    transition requestVote(target : Node, payload : VoteRequestData) {
        guard:
            & state = "Candidate"
            & target.id >= 1
            & target.id <= length(cluster)
            & cluster[target.id] = target
            & target.id ~in votesResponded
            & payload = VoteRequestData {
                term := currentTerm,
                candidateId := self.id,
                lastLogIndex := length(log),
                lastLogTerm := lastLogTermVar
            }
    }

    transition appendEntries(target : Node, payload : AppendEntriesData) {
        guard:
            & target.id >= 1
            & target.id <= length(cluster)
            & cluster[target.id] = target
            & target ~= self
            & state = "Leader"
            & payload = if (nextIndex[target.id] <= length(log)) {
                // if there's at least one entry to send
                let (nextLogIndex : Int := nextIndex[target.id])
                // prevLogIndex is the previous entry's index, or 0 if none
                let (prevLogIndex : Int := nextLogIndex - 1)
                let (prevLogTerm : Int := if (prevLogIndex > 0) entryTermAt(log, prevLogIndex) else 0)
                    AppendEntriesData {
                        term := currentTerm,
                        leaderId := self.id,
                        prevLogIndex := prevLogIndex,
                        prevLogTerm := prevLogTerm,
                        entry := log[nextLogIndex],
                        entriesLen := 1,
                        leaderCommit := commitIndex
                    }
            }
            else {
                // The log is caught up so send a heartbeat. prevLogIndex = last log index, or 0 if empty.
                // TODO make a fun for a heartbeat AE
                AppendEntriesData {
                    term := currentTerm,
                    leaderId := self.id,
                    prevLogIndex := length(log),
                    prevLogTerm := lastLogTermVar,
                    entry := Entry { term := 0, value := "" },
                    entriesLen := 0,
                    leaderCommit := commitIndex
                }
            }
    }

    internal transition becomeLeader() {
        guard:
            & state = "Candidate"
            & length(votesGranted) * 2 > length(cluster)
        transit:
            let _ : Boolean := LeaderHeartbeat.startLeaderHeartbeat(self, currentTerm, cluster)
            let _ : Boolean := ElectionTimeout.stopElectionTimeout(currentTerm)
            state := "Leader"
            knownLeaderId := self.id
            nextIndex := cluster.map(n -> length(log) + 1)
            matchIndex := cluster.map(n -> 0)
    }

    // TODO do we really need to send back the idx to the client?
    provider transition clientRequest(value : String, idx : Int) {
        guard:
            & state = "Leader"
            & idx = length(log) + 1
        transit:
            log := log + listOf(Entry { term := currentTerm, value := value })
            lastLogTermVar := currentTerm
    }

    internal transition advanceCommitIndex(newCommitIndex : Int) {
        guard:
            & state = "Leader"
            & commitIndex < newCommitIndex
            & newCommitIndex <= length(log)
            & entryTermAt(log, newCommitIndex) = currentTerm
            // matchIndex[self] stays 0 (leader never AEs itself), so count the leader explicitly.
            // Filter compares against state (commitIndex), not the action arg — required for fast guards.
            & let (numAgree : Int := 1 + matchIndex.filter(i -> i >= commitIndex).length) {
                numAgree * 2 > length(cluster)
            }
        transit:
            commitIndex := newCommitIndex
    }

    provider transition handleRequestVoteRequest(
        inTerm : Int,
        candidateId : Int,
        lastLogIndex : Int,
        lastLogTerm : Int,
        outTerm : Int,
        voteGranted : Boolean
    ) {
        guard:
            let (logOk : Boolean :=
                (lastLogTerm > lastLogTermVar) | (lastLogTerm = lastLogTermVar & lastLogIndex >= length(log))) {
            let (voteCondition : Boolean := inTerm = currentTerm & (votedFor = -1 | votedFor = candidateId) & logOk) {
                & inTerm <= currentTerm
                & outTerm = currentTerm
                & (voteGranted <=> voteCondition)
            }}
        transit:
            votedFor := if (voteGranted) candidateId else votedFor
    }

    provider transition handleRequestVoteResponse(peerId : Int, term : Int, granted : Boolean) {
        guard:
            & state = "Candidate"
            & term = currentTerm
        transit:
            votesGranted := if (granted) votesGranted + setOf(peerId) else votesGranted
            votesResponded := votesResponded + setOf(peerId)
    }

    provider transition handleAppendEntriesRequest(
        inTerm : Int,
        leaderId : Int,
        prevLogIndex : Int,
        prevLogTerm : Int,
        entriesLen : Int,
        entryTerm : Int,
        entryValue : String,
        leaderCommit : Int,
        outTerm : Int,
        success : Boolean,
        matchIdx : Int
    ) {
        guard:
            & inTerm <= currentTerm
            & outTerm = currentTerm
            & (entriesLen in setOf(0, 1))
            & (
                | (
                    & ~success
                    & matchIdx = 0
                    & (
                        | (inTerm < currentTerm)
                        | (
                            & inTerm = currentTerm
                            & (
                                | (prevLogIndex > length(log))
                                | (
                                    & prevLogIndex >= 1
                                    & prevLogIndex <= length(log)
                                    & entryTermAt(log, prevLogIndex) ~= prevLogTerm
                                )
                            )
                        )
                    )
                )
                | (
                    & success
                    & inTerm = currentTerm
                    & (
                        | (prevLogIndex = 0)
                        | (
                            & prevLogIndex >= 1
                            & prevLogIndex <= length(log)
                            & entryTermAt(log, prevLogIndex) = prevLogTerm
                        )
                    )
                    // matchIdx = last replicated index (paper: prevLogIndex + len(entries))
                    & (
                        | (entriesLen = 0 & matchIdx = prevLogIndex)
                        | (entriesLen = 1 & matchIdx = prevLogIndex + 1)
                    )
                )
            )
        transit:
            // Reset only on accepted AE; avoids blocking gotHeartbeat when leader has stopped its timer.
            let _ : Boolean := if (success) {
                ElectionTimeout.gotHeartbeat()
            } else true
            let index : Int := prevLogIndex + 1
            let alreadyDone : Boolean :=
                success & entriesLen = 1 & length(log) >= index & entryTermAt(log, index) = entryTerm
            knownLeaderId := if (success) leaderId else knownLeaderId
            // Matching-term AE: Candidate -> Follower, accept or reject.
            state := if (inTerm = currentTerm) "Follower" else state
            // accept paths, one-shot for sync RPC: already-done | conflict truncate+append | append.
            log := if (success & entriesLen = 1) {
                if (alreadyDone) {
                    log
                } else if (length(log) >= index) {
                    if (prevLogIndex = 0) {
                        listOf(Entry { term := entryTerm, value := entryValue })
                    } else {
                        splice(log, 1, prevLogIndex)
                            + listOf(Entry { term := entryTerm, value := entryValue })
                    }
                } else {
                    log + listOf(Entry { term := entryTerm, value := entryValue })
                }
            } else {
                log
            }
            lastLogTermVar := if (success & entriesLen = 1 & ~alreadyDone) {
                entryTerm
            } else {
                lastLogTermVar
            }
            commitIndex := if (success & leaderCommit > commitIndex) {
                let (lastNew : Int := if (entriesLen = 1) prevLogIndex + 1 else length(log)) {
                    if (leaderCommit < lastNew) leaderCommit else lastNew
                }
            } else {
                commitIndex
            }
    }

    provider transition handleAppendEntriesResponse(
        peerId : Int,
        inTerm : Int,
        success : Boolean,
        matchIdx : Int
    ) {
        guard:
            & state = "Leader"
            & inTerm = currentTerm
        transit:
            nextIndex[peerId] := if (success) {
                max(matchIdx + 1, nextIndex[peerId]) // ensure that nextIndex increases monotonically
            } else { max(nextIndex[peerId] - 1, 1) }
            matchIndex[peerId] := if (success) {
                max(matchIdx, matchIndex[peerId]) // ensure that matchIndex increases monotonically
            } else { matchIndex[peerId] }
    }

    /*
     * Any RPC with a newer term advances us first.
     * Always syncable; no-op when inTerm <= currentTerm.
     */
    provider transition updateTerm(inTerm : Int) {
        transit:
            let advance : Boolean := inTerm > currentTerm
            let _ : Boolean := if (advance) {
                ElectionTimeout.startElectionTimeout(self, inTerm)
            } else { true }
            currentTerm := if (advance) inTerm else currentTerm
            state := if (advance) "Follower" else state
            votedFor := if (advance) -1 else votedFor
            knownLeaderId := if (advance) -1 else knownLeaderId
            votesGranted := if (advance) {
                // TODO hack to get an empty set, since that doesn't compile for some reason
                votesGranted - votesGranted
            } else { votesGranted }
    }

    provider transition dropStaleResponse(respTerm : Int, drop : Boolean) {
        guard:
            drop <=> (respTerm < currentTerm)
    }


    
    /*
     * Getter actions that are not technically part of the protocol.
    */

    provider transition committed(value : String, idx : Int) {
        guard:
            & state = "Leader"
            & idx > 0
            & idx <= length(log)
            & idx <= commitIndex
            & value = entryValueAt(log, idx)
    }

    provider transition noLeader() {
        guard:
            & state ~= "Leader"
            & knownLeaderId < 0
    }

    provider transition getCommitted(stateMachine : List<String>) {
        guard: stateMachine = splice(log, 1, commitIndex).map(e -> e.value)
    }

    provider transition staleTerm(term : Int) {
        guard: term < currentTerm
    }

    // TODO should be able to delete this
    provider transition leaderRedirect(leader : Node) {
        guard:
            & state ~= "Leader"
            & knownLeaderId >= 1
            & leader.id = knownLeaderId
            & knownLeaderId <= length(cluster)
            & cluster[knownLeaderId] = leader
    }
}
