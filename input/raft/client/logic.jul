import julaylib.pclass.HttpClient
import julaylib.fun.length
import julaylib.fun.split
import julaylib.fun.startsWith
import julaylib.fun.createEmptyChannel

/*
 * Raft client — CLI:
 *   <nodeUrl> append <value>
 *   <nodeUrl> get
 *
 * Prints every response; on 303 LEADER <url>, retries once against the leader.
 */

p-class RaftClientLogic {
    const command : String
    const value : String
    const path : String
    const reqBody : String
    var step : String
    var targetUrl : String
    var respBody : String
    var respCode : Int
    var retried : Boolean
    var httpChan : Channel<receiveResponse>

    constructor initially(args : List<String>) {
        transit:
            targetUrl := args[0]
            command := args[1]
            value := if (length(args) > 2) { args[2] } else { "" }
            path := if (args[1] = "append") { "/client/append" } else { "/client/get" }
            reqBody := if (args[1] = "append") { args[2] } else { "" }
            respBody := ""
            respCode := 0
            retried := false
            httpChan := createEmptyChannel<receiveResponse>()
            step := "createHttpClient"
    }

    transition createHttpClient() {
        guard: step = "createHttpClient"
        transit: step := "send"
    }

    transition sendRequest(req : HttpClientRequest, httpChan : Channel<receiveResponse>) {
        guard:
            & step = "send"
            & req = HttpClientRequest {
                url := targetUrl + path,
                method := "POST",
                body := reqBody
            }
        transit:
            httpChan := httpChan
            step := "recv"
    }

    transition receiveResponse<httpChan>(resp : HttpClientResponse) {
        guard: step = "recv"
        transit:
            respBody := resp.body
            respCode := resp.code
            step := "print"
    }

    internal transition printResp() {
        guard: step = "print"
        transit: step := "afterPrint"
        effect:
            println("" + respCode + " " + respBody)
    }

    internal transition retryLeader() {
        guard:
            & step = "afterPrint"
            & ~retried
            & respCode = 303
            & startsWith(respBody, "LEADER ")
        transit:
            targetUrl := split(respBody, " ")[1]
            retried := true
            step := "send"
    }

    internal transition doneOk() {
        guard:
            & step = "afterPrint"
            & (respCode = 200 | retried | respCode = 503 | ~(startsWith(respBody, "LEADER ")))
        effect:
            exitProcess()
    }
}

proc Client := RaftClientLogic || HttpClient
