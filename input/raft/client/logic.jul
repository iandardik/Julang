import julay.funlib.httpRequest
import julay.funlib.length
import julay.funlib.split
import julay.funlib.startsWith
import julay.funlib.exitProgram
import julay.funlib.println

/*
 * Raft client — CLI:
 *   <nodeUrl> append <value>
 *   <nodeUrl> get
 *
 * Prints every response; on 303 LEADER <url>, retries once against the leader.
 */

proc RaftClientLogic {
    const command : String
    const value : String
    const path : String
    const reqBody : String
    var step : String
    var targetUrl : String
    var respBody : String
    var respCode : Int
    var retried : Boolean

    constructor initially(args : List<String>) {
        transit:
            targetUrl := args[1]
            command := args[2]
            value := if (length(args) > 2) args[3] else ""
            path := if (args[2] = "append") "/client/append" else "/client/get"
            reqBody := if (args[2] = "append") args[3] else ""
            respBody := ""
            respCode := 0
            retried := false
            step := "send"
    }

    internal transition doRequest() {
        guard: step = "send"
        transit:
            let resp : HttpClientResponse := httpRequest(HttpClientRequest {
                url := targetUrl + path,
                method := "POST",
                body := reqBody
            })
            respBody := resp.body
            respCode := resp.code
            step := "print"
    }

    internal transition printResp() {
        guard: step = "print"
        transit: step := "afterPrint"
        after:
            println("" + respCode + " " + respBody)
    }

    internal transition retryLeader() {
        guard:
            & step = "afterPrint"
            & ~retried
            & respCode = 303
            & startsWith(respBody, "LEADER ")
        transit:
            targetUrl := split(respBody, " ")[2]
            retried := true
            step := "send"
    }

    internal transition doneOk() {
        guard:
            & step = "afterPrint"
            & (respCode = 200 | retried | respCode = 503 | ~(startsWith(respBody, "LEADER ")))
        after:
            exitProgram(0)
    }
}

export proc Client := RaftClientLogic
