import specs.net.Net
import node.core.RaftProtocol
import node.protocol.NodeSet

invariant OneLeaderPerTerm := forall n1 : NodeSet, forall n2 : NodeSet,
    (RaftProtocol[n1].state = "Leader" & RaftProtocol[n2].state = "Leader" & RaftProtocol[n1].currentTerm = RaftProtocol[n2].currentTerm) => (n1 = n2)

spec ClusterSpec := RaftProtocol[n : NodeSet] {
    const global cluster
    init: cluster.length = NodeSet.length
}
spec Sys := with (n : NodeSet) {
    ClusterSpec[n] || Net[n]
}
export spec RaftNodeSpec := Sys |= OneLeaderPerTerm