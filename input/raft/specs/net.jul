import node.core.RaftProtocol
import node.protocol.NodeSet
import julay.funlib.setOf

obj VoteRequestMsg {
    src : NodeSet
    dest : NodeSet
    msg : VoteRequestData
}
obj VoteResponseMsg {
    src : NodeSet
    dest : NodeSet
    id : Int
    term : Int
    granted : Boolean
}
obj AppendEntriesRequestMsg {
    src : NodeSet
    dest : NodeSet
    msg : AppendEntriesData
}
obj AppendEntriesResponseMsg {
    src : NodeSet
    dest : NodeSet
    id : Int
    term : Int
    success : Boolean
    matchIdx : Int
}

export spec Net[n : NodeSet] {
    var voteRequestMsgs : Set<VoteRequestMsg> := setOf()
    var voteResponseMsgs : Set<VoteResponseMsg> := setOf()
    var appendEntriesRequestMsgs : Set<AppendEntriesRequestMsg> := setOf()
    var appendEntriesResponseMsgs : Set<AppendEntriesResponseMsg> := setOf()
    
    constructor initially(args : List<String>) {}

    transition requestVote(target : Node, payload : VoteRequestData) also (m : NodeSet) {
        guard:
            RaftProtocol[m].self = target
        transit:
            voteRequestMsgs := voteRequestMsgs + setOf(VoteRequestMsg {
                src := n,
                dest := m,
                msg := payload
            })
    }

    client transition handleRequestVoteRequest(
        inTerm : Int,
        candidateId : Int,
        lastLogIndex : Int,
        lastLogTerm : Int,
        outTerm : Int,
        voteGranted : Boolean
    ) also (m : NodeSet) {
        guard:
            VoteRequestMsg {
                src := m,
                dest := n,
                msg := VoteRequestData {
                    term := inTerm,
                    candidateId := candidateId,
                    lastLogIndex := lastLogIndex,
                    lastLogTerm := lastLogTerm
                }
            } in voteRequestMsgs
        transit:
            voteRequestMsgs := voteRequestMsgs - setOf(VoteRequestMsg {
                src := m,
                dest := n,
                msg := VoteRequestData {
                    term := inTerm,
                    candidateId := candidateId,
                    lastLogIndex := lastLogIndex,
                    lastLogTerm := lastLogTerm
                }
            })
            voteResponseMsgs := voteResponseMsgs + setOf(VoteResponseMsg {
                src := n,
                dest := m,
                id := candidateId,
                term := outTerm,
                granted := voteGranted
            })
    }

    client transition handleRequestVoteResponse(peerId : Int, term : Int, granted : Boolean) also (m : NodeSet) {
        guard:
            VoteResponseMsg {
                src := m,
                dest := n,
                id := peerId,
                term := term,
                granted := granted
            } in voteResponseMsgs
        transit:
            voteResponseMsgs := voteResponseMsgs - setOf(VoteResponseMsg {
                src := m,
                dest := n,
                id := peerId,
                term := term,
                granted := granted
            })
    }

    transition appendEntries(target : Node, payload : AppendEntriesData) also (m : NodeSet) {
        guard:
            RaftProtocol[m].self = target
        transit:
            appendEntriesRequestMsgs := appendEntriesRequestMsgs + setOf(AppendEntriesRequestMsg {
                src := n,
                dest := m,
                msg := payload
            })
    }

    client transition handleAppendEntriesRequest(
        inTerm : Int,
        leaderId : Int,
        prevLogIndex : Int,
        prevLogTerm : Int,
        entriesLen : Int,
        entryTerm : Int,
        entryValue : String,
        leaderCommit : Int,
        outTerm : Int,
        success : Boolean,
        matchIdx : Int
    ) also (m : NodeSet) {
        guard:
            AppendEntriesRequestMsg {
                src := m,
                dest := n,
                msg := AppendEntriesData {
                    term := inTerm,
                    leaderId := leaderId,
                    prevLogIndex := prevLogIndex,
                    prevLogTerm := prevLogTerm,
                    entry := Entry {
                        term := entryTerm,
                        value := entryValue
                    },
                    entriesLen := entriesLen,
                    leaderCommit := leaderCommit
                }
            } in appendEntriesRequestMsgs
        transit:
            appendEntriesRequestMsgs := appendEntriesRequestMsgs - setOf(AppendEntriesRequestMsg {
                src := m,
                dest := n,
                msg := AppendEntriesData {
                    term := inTerm,
                    leaderId := leaderId,
                    prevLogIndex := prevLogIndex,
                    prevLogTerm := prevLogTerm,
                    entry := Entry {
                        term := entryTerm,
                        value := entryValue
                    },
                    entriesLen := entriesLen,
                    leaderCommit := leaderCommit
                }
            })
            appendEntriesResponseMsgs := appendEntriesResponseMsgs + setOf(AppendEntriesResponseMsg {
                src := n,
                dest := m,
                id := leaderId,
                term := inTerm,
                success := success,
                matchIdx := matchIdx
            })
    }

    client transition handleAppendEntriesResponse(
        peerId : Int,
        inTerm : Int,
        success : Boolean,
        matchIdx : Int
    ) also (m : NodeSet) {
        guard:
            AppendEntriesResponseMsg {
                src := m,
                dest := n,
                id := peerId,
                term := inTerm,
                success := success,
                matchIdx := matchIdx
            } in appendEntriesResponseMsgs
        transit:
            appendEntriesResponseMsgs := appendEntriesResponseMsgs - setOf(AppendEntriesResponseMsg {
                src := m,
                dest := n,
                id := peerId,
                term := inTerm,
                success := success,
                matchIdx := matchIdx
            })
    }

    client transition updateTerm(inTerm : Int) {
        guard:
            | voteRequestMsgs.filter(m -> m.dest = n & m.msg.term = inTerm).length > 0
            | voteResponseMsgs.filter(m -> m.dest = n & m.term = inTerm).length > 0
            | appendEntriesRequestMsgs.filter(m -> m.dest = n & m.msg.term = inTerm).length > 0
            | appendEntriesResponseMsgs.filter(m -> m.dest = n & m.term = inTerm).length > 0
    }
}
