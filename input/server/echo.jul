p-class EchoHandler {
    var req : String
    var resp : String
    var responded : Boolean
    var done : Boolean

    constructor handleHttpReq(reqBody : String) {
        transit:
            req := reqBody
            resp := reqBody + " is a good point!"
            responded := false
            done := false
    }

    transition httpResp(respBody : String) {
        guard:
            ~responded & respBody = resp
        transit:
            responded := true
    }

    transition println(msg : String) {
        guard:
              responded
            & ~done
            & msg = "Req: '" + req + "', I responded: '" + resp + "'"
        transit:
            done := true
    }
}

program EchoServer := EchoHandler || Println || HttpServer
