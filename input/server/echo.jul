p-class EchoHandler {
    var req : String
    var resp : String
    var responded : Boolean
    var done : Boolean

    constructor receiveRequest(reqBody : String) {
        transit:
            req := reqBody
            resp := reqBody + " is a good point!"
            responded := false
            done := false
    }

    transition sendResponse(respBody : String) {
        guard:
            ~responded & respBody = resp
        transit:
            responded := true
    }

    p2p-consumer transition println(msg : String) {
        guard:
              responded
            & ~done
            & msg = "Req: '" + req + "', I responded: '" + resp + "'"
        transit:
            done := true
    }

    p2p-consumer transition close() {
        guard:
            // never close the server until the user hits ctrl-c
            false
    }
}

program EchoServer := EchoHandler || Println || HttpServer

p-class ClientDispatcher {
    var numReqs : Int
    var maxNumReqs : Int

    constructor initially() {
        transit:
            numReqs := 1
            maxNumReqs := 25
    }

    transition startReq(num : Int) {
        guard:
            numReqs <= maxNumReqs & num = numReqs
        transit:
            numReqs := numReqs + 1
    }
}

p-class ClientLogic {
    var reqNum : Int
    var state : String
    var resp : String

    constructor startReq(num : Int) {
        transit:
            reqNum := num
            state := "A"
            resp := ""
    }

    transition sendRequest(sendBody : String) {
        guard:
            state = "A" & sendBody = "ReqNum: " + reqNum
        transit:
            state := "B"
    }

    transition receiveResponse(respBody : String) {
        guard:
            state = "B"
        transit:
            resp := respBody
            state := "C"
    }

    p2p-consumer transition println(msg : String) {
        guard:
            state = "C" & msg = "response: " + resp
        transit:
            state := "D"
    }
}

program EchoClient := ClientDispatcher || ClientLogic || HttpClient || Println
