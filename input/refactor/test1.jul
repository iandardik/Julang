p-class Inc {
    var print : Boolean
    var counter : Int

    constructor initially() {
        transit:
            print := true
            counter := 0
    }
    
    transition increment(inc : Int) {
        guard:
            (inc > 0) & (counter <= 10) & ~print
        transit:
            counter := counter + inc
            print := true
    }

    transition println(msg : String) {
        guard:
            (msg = "" + counter) & print
        transit:
            print := false
    }
}

p-class T {
    var x : Int

    constructor initially() {
        transit:
            x := 0
    }

    transition increment(inc : Int) {
        guard:
            inc > 2 & x <= 10
        transit:
            x := x + inc
    }
}

program main := Inc || Println || T
