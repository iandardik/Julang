import julaylib.pclass.Println
import julaylib.pclass.HttpServer
import julaylib.fun.createEmptyChannel
import julaylib.fun.createChannel

o-class ReqInfo {
    req : String
    resp : String
}

p-class ServerStarter {
    var started : Boolean
    var myCloseChan : Channel<closeHttpServer>

    constructor initially(args : List<String>) {
        transit:
            started := false
            myCloseChan := createEmptyChannel<closeHttpServer>()
    }

    internal transition allocCloseChan() {
        guard: ~started & myCloseChan = createEmptyChannel<closeHttpServer>()
        transit: myCloseChan := createChannel<closeHttpServer>()
    }

    transition createHttpServer(port : Int, closeChan : Channel<closeHttpServer>) {
        guard: ~started & port = 8000 & closeChan = myCloseChan
            & myCloseChan ~= createEmptyChannel<closeHttpServer>()
        transit: started := true
    }

    transition closeHttpServer<myCloseChan>() {
        guard: false
    }
}

p-class EchoHandler {
    const info : ReqInfo
    const httpReq : HttpServerRequest
    const httpChan : Channel<sendResponse>
    var responded : Boolean
    var done : Boolean

    constructor receiveRequest(req : HttpServerRequest, httpChan : Channel<sendResponse>) {
        transit:
            httpReq := req
            httpChan := httpChan
            info := ReqInfo {
                req := req.body,
                resp := req.body + " is a good point!"
            }
            responded := false
            done := false
    }

    transition sendResponse<httpChan>(resp : HttpServerResponse) {
        guard:
            & ~responded
            & resp = HttpServerResponse {
                body := info.resp,
                code := 200
            }
        transit:
            responded := true
    }

    transition println(msg : String) {
        guard:
            & responded
            & ~done
            & msg = "Req: '" + info.req + "', I responded: '" + info.resp + "'"
        transit:
            done := true
    }
}

proc Server := ServerStarter || EchoHandler || Println || HttpServer
