import julay.funlib.serveHttp
import julay.funlib.println

proc EchoHandler {
    var body : String

    constructor req(r : HttpServerRequest) {
        transit: body := r.body
    }

    return respond(resp : HttpServerResponse) {
        guard:
            resp = HttpServerResponse {
                body := body + " is a good point!",
                code := 200
            }
        before:
            println("Req: '" + body + "', I responded: '" + body + " is a good point!" + "'")
    }
}

static proc ServerStarter {
    constructor initially(args : List<String>) {
        after:
            serveHttp(8000, EchoHandler.req ~> EchoHandler.respond)
    }
}

export proc Server := ServerStarter || EchoHandler
