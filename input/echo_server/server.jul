import julay.proclib.HttpServer
import julay.funlib.println

type ReqInfo {
    req : String
    resp : String
}

proc ServerStarter {
    var started : Boolean

    constructor initially(args : List<String>) {
        transit:
            started := false
    }

    session transition createHttpServer(port : Int) {
        guard: ~started & port = 8000
        transit: started := true
    }

    session transition closeHttpServer() {
        guard: false
    }
}

proc EchoHandler {
    const info : ReqInfo
    const httpReq : HttpServerRequest
    var responded : Boolean
    var done : Boolean

    session constructor receiveRequest(req : HttpServerRequest) {
        transit:
            httpReq := req
            info := ReqInfo {
                req := req.body,
                resp := req.body + " is a good point!"
            }
            responded := false
            done := false
    }

    session transition sendResponse(resp : HttpServerResponse) {
        guard:
            & ~responded
            & resp = HttpServerResponse {
                body := info.resp,
                code := 200
            }
        transit:
            responded := true
    }

    internal transition println(msg : String) {
        guard:
            & responded
            & ~done
            & msg = "Req: '" + info.req + "', I responded: '" + info.resp + "'"
        transit:
            done := true
        after:
            println(msg)
    }
}

export proc Server := ServerStarter || EchoHandler || HttpServer
