import julaylib.pclass.Println
import julaylib.pclass.HttpServer

o-class ReqInfo {
    req : String
    resp : String
}

p-class ServerStarter {
    var started : Boolean

    constructor initially(args : List String) {
        transit: started := false
    }

    transition startServer(port : Int) {
        guard: ~started & port = 8000
        transit: started := true
    }
}

p-class EchoHandler {
    var info : ReqInfo
    var responded : Boolean
    var done : Boolean

    constructor receiveRequest(req : HttpServerRequest) {
        transit:
            info := ReqInfo {
                req := req.body,
                resp := req.body + " is a good point!"
            }
            responded := false
            done := false
    }

    transition sendResponse(resp : HttpServerResponse) {
        guard:
            ~responded & resp = HttpServerResponse {
                body := info.resp,
                code := 200
            }
        transit:
            responded := true
    }

    p2p-consumer transition println(msg : String) {
        guard:
              responded
            & ~done
            & msg = "Req: '" + info.req + "', I responded: '" + info.resp + "'"
        transit:
            done := true
    }

    p2p-consumer transition close() {
        guard:
            // never close the server until the user hits ctrl-c
            false
    }
}

proc Server := ServerStarter || EchoHandler || Println || HttpServer
