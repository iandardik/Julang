import julay.proclib.HttpClient
import julay.proclib.Println
import julay.funlib.length
import julay.funlib.parseInt

proc ClientDispatcher {
    const targetNumReqs : Int
    var numReqs : Int
    var numResps : Int
    var step : String

    constructor initially(args : List<String>) {
        transit:
            numReqs := 1
            numResps := 0
            targetNumReqs := if (length(args) > 0) {
                parseInt(args[0])
            } else {
                25
            }
            step := "run"
    }

    transition startReq(num : Int) {
        guard:
            step = "run" & numReqs <= targetNumReqs & num = numReqs
        transit:
            numReqs := numReqs + 1
    }

    transition gotResp() {
        transit:
            numResps := numResps + 1
    }

    internal transition finish() {
        guard:
            numResps = targetNumReqs
        effect:
            exitProcess()
    }
}

proc ClientLogic {
    const reqNum : Int
    var state : String
    var respText : String

    constructor startReq(num : Int) {
        transit:
            reqNum := num
            state := "createHttp"
            respText := ""
    }

    session transition createHttpClient() {
        guard: state = "createHttp"
        transit: state := "A"
    }

    session transition sendRequest(req : HttpClientRequest) {
        guard:
            state = "A" & req = HttpClientRequest {
                url := "http://localhost:8000",
                method := "POST",
                body := "ReqNum: " + reqNum
            }
        transit:
            state := "B"
    }

    session transition receiveResponse(resp : HttpClientResponse) {
        guard:
            state = "B"
        transit:
            respText := resp.body
            state := "C"
    }

    transition println(msg : String) {
        guard:
            state = "C" & msg = "response: " + respText
        transit:
            state := "D"
    }

    session transition closeHttpClient() {
        guard: state = "D"
        transit: state := "E"
    }

    transition gotResp() {
        guard:
            state = "E"
        transit:
            state := "F"
    }
}

proc Client := ClientDispatcher || ClientLogic || HttpClient || Println
