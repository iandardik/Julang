import julaylib.pclass.HttpClient
import julaylib.pclass.Println
import julaylib.fun.length
import julaylib.fun.parseInt
import julaylib.fun.createEmptyChannel
import julaylib.fun.createChannel

p-class ClientDispatcher {
    const targetNumReqs : Int
    var numReqs : Int
    var numResps : Int
    var step : String

    constructor initially(args : List<String>) {
        transit:
            numReqs := 1
            numResps := 0
            targetNumReqs := if (length(args) > 0) {
                parseInt(args[0])
            } else {
                25
            }
            step := "run"
    }

    transition startReq(num : Int) {
        guard:
            step = "run" & numReqs <= targetNumReqs & num = numReqs
        transit:
            numReqs := numReqs + 1
    }

    transition gotResp() {
        transit:
            numResps := numResps + 1
    }

    internal transition finish() {
        guard:
            numResps = targetNumReqs
        effect:
            exitProcess()
    }
}

p-class ClientLogic {
    const reqNum : Int
    var state : String
    var respText : String
    var httpChan : Channel<receiveResponse>
    var myCloseChan : Channel<closeHttpClient>

    constructor startReq(num : Int) {
        transit:
            reqNum := num
            state := "allocClose"
            respText := ""
            httpChan := createEmptyChannel<receiveResponse>()
            myCloseChan := createEmptyChannel<closeHttpClient>()
    }

    internal transition allocCloseChan() {
        guard: state = "allocClose"
        transit:
            myCloseChan := createChannel<closeHttpClient>()
            state := "createHttp"
    }

    transition createHttpClient(closeChan : Channel<closeHttpClient>) {
        guard: state = "createHttp" & closeChan = myCloseChan
        transit: state := "A"
    }

    transition sendRequest(req : HttpClientRequest, httpChan : Channel<receiveResponse>) {
        guard:
            state = "A" & req = HttpClientRequest {
                url := "http://localhost:8000",
                method := "POST",
                body := "ReqNum: " + reqNum
            }
        transit:
            httpChan := httpChan
            state := "B"
    }

    transition receiveResponse<httpChan>(resp : HttpClientResponse) {
        guard:
            state = "B"
        transit:
            respText := resp.body
            state := "C"
    }

    transition println(msg : String) {
        guard:
            state = "C" & msg = "response: " + respText
        transit:
            state := "D"
    }

    transition closeHttpClient<myCloseChan>() {
        guard: state = "D"
        transit: state := "E"
    }

    transition gotResp() {
        guard:
            state = "E"
        transit:
            state := "F"
    }
}

proc Client := ClientDispatcher || ClientLogic || HttpClient || Println
