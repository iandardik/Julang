import julay.funlib.httpRequest
import julay.funlib.length
import julay.funlib.parseInt
import julay.funlib.exitProgram
import julay.funlib.println

proc ClientDispatcher {
    const targetNumReqs : Int
    var numReqs : Int
    var numResps : Int
    var step : String

    constructor initially(args : List<String>) {
        transit:
            numReqs := 1
            numResps := 0
            targetNumReqs := if (length(args) > 0) {
                parseInt(args[1])
            } else {
                25
            }
            step := "run"
    }

    transition startReq(num : Int) {
        guard:
            step = "run" & numReqs <= targetNumReqs & num = numReqs
        transit:
            numReqs := numReqs + 1
    }

    transition gotResp() {
        transit:
            numResps := numResps + 1
    }

    internal transition finish() {
        guard:
            numResps = targetNumReqs
        after:
            exitProgram(0)
    }
}

proc ClientLogic {
    const reqNum : Int
    var respText : String
    var done : Boolean

    constructor startReq(num : Int) {
        transit:
            reqNum := num
            respText := ""
            done := false
    }

    internal transition sendAndReceive() {
        guard: ~done
        transit:
            respText := httpRequest(HttpClientRequest {
                url := "http://localhost:8000",
                method := "POST",
                body := "ReqNum: " + reqNum
            }).body
            done := true
    }

    internal transition println(msg : String) {
        guard: done & msg = "response: " + respText
        after:
            println(msg)
    }

    transition gotResp() {
        guard: done
    }
}

export proc Client := ClientDispatcher || ClientLogic
