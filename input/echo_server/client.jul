import julaylib.pclass.HttpClient
import julaylib.pclass.Println
import julaylib.fun.length
import julaylib.fun.parseInt

p-class ClientDispatcher {
    var numReqs : Int
    var numResps : Int
    var targetNumReqs : Int

    constructor initially(args : List<String>) {
        transit:
            numReqs := 1
            numResps := 0
            targetNumReqs := if (length(args) > 0) {
                parseInt(args[0])
            } else {
                25
            }
    }

    transition startReq(num : Int) {
        guard:
            numReqs <= targetNumReqs & num = numReqs
        transit:
            numReqs := numReqs + 1
    }

    transition gotResp() {
        transit:
            numResps := numResps + 1
    }

    transition finish() {
        guard:
            numResps = targetNumReqs
        effect:
            exitProcess()
    }
}

p-class ClientLogic {
    var reqNum : Int
    var state : String
    var respText : String

    constructor startReq(num : Int) {
        transit:
            reqNum := num
            state := "A"
            respText := ""
    }

    transition sendRequest(req : HttpClientRequest) {
        guard:
            state = "A" & req = HttpClientRequest {
                url := "http://localhost:8000",
                method := "POST",
                body := "ReqNum: " + reqNum
            }
        transit:
            state := "B"
    }

    transition receiveResponse(resp : HttpClientResponse) {
        guard:
            state = "B"
        transit:
            respText := resp.body
            state := "C"
    }

    p2p-consumer transition println(msg : String) {
        guard:
            state = "C" & msg = "response: " + respText
        transit:
            state := "D"
    }

    transition gotResp() {
        guard:
            state = "D"
        transit:
            state := "E"
    }
}

proc Client := ClientDispatcher || ClientLogic || HttpClient || Println
