import julay.funlib.httpRequest
import julay.funlib.length
import julay.funlib.parseInt
import julay.funlib.exitProgram
import julay.funlib.println

static proc ClientDispatcher {
    const targetNumReqs : Int
    var numReqs : Int
    var numResps : Int
    var step : String

    constructor initially(args : List<String>) {
        transit:
            numReqs := 1
            numResps := 0
            targetNumReqs := if (length(args) > 0) {
                parseInt(args[1])
            } else {
                25
            }
            step := "run"
    }

    transition startReq(num : Int) {
        guard:
            step = "run" & numReqs <= targetNumReqs & num = numReqs
        transit:
            numReqs := numReqs + 1
    }

    transition gotResp() {
        transit:
            numResps := numResps + 1
    }

    internal transition finish() {
        guard:
            numResps = targetNumReqs
        after:
            exitProgram(0)
    }
}

proc ClientLogic {
    var done : Boolean
    var respText : String

    constructor startReq(num : Int) {
        transit:
            respText := httpRequest(HttpClientRequest {
                url := "http://localhost:8000",
                method := "POST",
                body := "ReqNum: " + num
            }).body
            done := false
        after:
            println("response: " + respText)
    }

    transition gotResp() {
        guard:
            ~done
        transit:
            done := true
    }
}

export proc Client := ClientDispatcher || ClientLogic
