import julay.proclib.Println

/* prints the current value of the counter every 5 seconds
*/
proc PeriodicPrint {
    var list : List<String>
    var step : String

    constructor initially(args : List<String>) {
        transit:
            list := []
            step := "A"
    }

    transition getList(lst : List<String>) {
        guard:
            step = "A"
        transit:
            list := lst
            step := "B"
    }

    transition println(msg : String) {
        guard:   step = "B" & (msg = list + "")
        transit: step := "C"
    }

    internal transition wait() {
        guard:   step = "C"
        transit: step := "A"
        effect:  delaySeconds(5)
    }
}

proc Printer := PeriodicPrint || Println
