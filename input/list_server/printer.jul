import julay.funlib.delaySeconds
import julay.funlib.println

/* prints the current value of the counter every 5 seconds
*/
proc PeriodicPrint {
    var list : List<String>
    var step : String

    constructor initially(args : List<String>) {
        transit:
            list := []
            step := "A"
    }

    client transition getList(lst : List<String>) {
        guard:
            step = "A"
        transit:
            list := lst
            step := "B"
    }

    internal transition println(msg : String) {
        guard:   step = "B" & (msg = list + "")
        transit: step := "C"
        after:
            println(msg)
    }

    internal transition wait() {
        guard:   step = "C"
        transit: step := "A"
        after:  delaySeconds(5)
    }
}

export proc Printer := PeriodicPrint
