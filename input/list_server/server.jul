import julay.funlib.serveHttp
import julay.funlib.listOf

static proc ServerStarter {
    constructor initially(args : List<String>) {
        after:
            serveHttp(8000, ListHandler.req ~> ListHandler.respond)
    }
}

proc ListHandler {
    const reqBody : String
    var step : String
    var list : List<String>

    constructor req(r : HttpServerRequest) {
        transit:
            reqBody := r.body
            step := "A"
            list := listOf()
    }

    client transition getAndAppend(e : String, lst : List<String>) {
        guard:
            step = "A" & e = reqBody
        transit:
            step := "B"
            list := lst + listOf(reqBody)
    }

    return respond(resp : HttpServerResponse) {
        guard:
            step = "B" & resp = HttpServerResponse {
                body := list + "",
                code := 200
            }
    }
}

export proc ServerLogic := ServerStarter || ListHandler
