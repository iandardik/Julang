import julay.proclib.HttpServer
import julay.funlib.listOf

proc ServerStarter {
    var started : Boolean

    constructor initially(args : List<String>) {
        transit:
            started := false
    }

    session transition listen(
        port : Int,
        handler : HttpServerRequest ~> HttpServerResponse
    ) {
        guard: ~started & port = 8000 & handler = listHandler
        transit: started := true
    }

    session transition close() {
        guard: false
    }
}

procfun listHandler(req : HttpServerRequest) : HttpServerResponse {
    const reqBody : String := req.body
    var step : String := "A"
    var list : List<String> := listOf()

    client transition getAndAppend(e : String, lst : List<String>) {
        guard:
            step = "A" & e = reqBody
        transit:
            step := "B"
            list := lst + listOf(reqBody)
    }

    internal transition respond() {
        guard: step = "B"
        return: HttpServerResponse {
            body := list + "",
            code := 200
        }
    }
}

export proc ServerLogic := ServerStarter || HttpServer
