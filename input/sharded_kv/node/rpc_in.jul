import julay.funlib.serveHttp
import julay.funlib.portFromUrl
import julay.funlib.parseInt
import julay.funlib.split
import julay.funlib.length
import julay.funlib.listOf
import node.lib.fieldValue
import node.lib.parseCfg
import node.lib.PutResult
import node.lib.GetResult
import node.lib.KvPair
import node.lib.OwnerEntry
import node.shard.Shard

/*
 * Inbound HTTP adapters: parse request → Shard.*; encode results → response.
 * No peer dials or ownership policy here.
 */
export api RpcIn {
    proc: ServerStarter
    calls: handleRpc, put, get, owners, claim, keyCount, moveBatch
}

static proc ServerStarter {
    constructor initially(args : List<String>) {
        after:
            serveHttp(portFromUrl(parseCfg(args[1], parseInt(args[2])).me.url), handleRpc)
        error:
            (length(args) ~= 2) -> "usage: ShardNode <config_file> <node_id>"
    }
}

fun parseKvBatch(entries : String) : List<KvPair> =
    if (entries = "") {
        listOf<KvPair>()
    } else {
        split(entries, ";").map(part -> KvPair {
            k := split(part, "=")[1],
            v := split(part, "=")[2]
        })
    }

fun encodeOwnersBody(entries : List<OwnerEntry>) : String =
    "owners=" + entries.fold("", (acc, e) ->
        if (acc = "") {
            e.k + "->" + e.owner
        } else {
            acc + "|" + e.k + "->" + e.owner
        })

procfun handleRpc(req : HttpServerRequest) : HttpServerResponse {
    internal transition route() {
        return: when (req.path) {
            "kv/put" -> put(req)
            "kv/get" -> get(req)
            "kv/owners" -> owners(req)
            "rpc/claim" -> claim(req)
            "rpc/keyCount" -> keyCount(req)
            "rpc/moveBatch" -> moveBatch(req)
            else -> HttpServerResponse {
                body := "NOT_FOUND",
                code := 404
            }
        }
    }
}

procfun owners(req : HttpServerRequest) : HttpServerResponse {
    var step : String := "call"
    var entries : List<OwnerEntry> := listOf<OwnerEntry>()

    internal transition callDomain() {
        guard: step = "call"
        transit:
            entries := Shard.owners()
            step := "respond"
    }

    internal transition respond() {
        guard: step = "respond"
        return: HttpServerResponse {
            body := encodeOwnersBody(entries),
            code := 200
        }
    }
}

procfun keyCount(req : HttpServerRequest) : HttpServerResponse {
    var step : String := "call"
    var n : Int := 0

    internal transition callDomain() {
        guard: step = "call"
        transit:
            n := Shard.keyCount()
            step := "respond"
    }

    internal transition respond() {
        guard: step = "respond"
        return: HttpServerResponse {
            body := "n=" + n,
            code := 200
        }
    }
}

procfun claim(req : HttpServerRequest) : HttpServerResponse {
    const reqK : String := fieldValue(split(req.body, "|")[1])
    const reqOwner : String := fieldValue(split(req.body, "|")[2])
    var step : String := "call"
    var ok : Boolean := false

    internal transition callDomain() {
        guard: step = "call"
        transit:
            ok := Shard.applyClaim(reqK, reqOwner)
            step := "respond"
    }

    internal transition respond() {
        guard: step = "respond"
        return: HttpServerResponse {
            body := "ok",
            code := 200
        }
    }
}

procfun get(req : HttpServerRequest) : HttpServerResponse {
    const reqK : String := fieldValue(split(req.body, "|")[1])
    var step : String := "call"
    var result : GetResult := GetResult {
        kind := "",
        value := "",
        ownerUrl := ""
    }

    internal transition callDomain() {
        guard: step = "call"
        transit:
            result := Shard.get(reqK)
            step := "respond"
    }

    internal transition respondOk() {
        guard: step = "respond" & result.kind = "ok"
        return: HttpServerResponse {
            body := "v=" + result.value,
            code := 200
        }
    }

    internal transition respondRedirect() {
        guard: step = "respond" & result.kind = "redirect"
        return: HttpServerResponse {
            body := "OWNER " + result.ownerUrl,
            code := 303
        }
    }

    internal transition respondMissing() {
        guard: step = "respond" & result.kind = "missing"
        return: HttpServerResponse {
            body := "MISSING",
            code := 404
        }
    }
}

procfun put(req : HttpServerRequest) : HttpServerResponse {
    const reqK : String := fieldValue(split(req.body, "|")[1])
    const reqV : String := fieldValue(split(req.body, "|")[2])
    var step : String := "call"
    var result : PutResult := PutResult {
        kind := "",
        ownerUrl := ""
    }

    internal transition callDomain() {
        guard: step = "call"
        transit:
            result := Shard.put(reqK, reqV)
            step := "respond"
    }

    internal transition respondOk() {
        guard: step = "respond" & result.kind = "ok"
        return: HttpServerResponse {
            body := "ok",
            code := 200
        }
    }

    internal transition respondRedirect() {
        guard: step = "respond" & result.kind = "redirect"
        return: HttpServerResponse {
            body := "OWNER " + result.ownerUrl,
            code := 303
        }
    }
}

procfun moveBatch(req : HttpServerRequest) : HttpServerResponse {
    /* body: <ownerUrl>|<k=v;k=v;...> */
    const reqOwner : String := split(req.body, "|")[1]
    const entriesRaw : String := if (length(split(req.body, "|")) < 2) {
        ""
    } else {
        split(req.body, "|")[2]
    }
    var step : String := "call"
    var ok : Boolean := false

    internal transition callDomain() {
        guard: step = "call"
        transit:
            ok := Shard.applyMoveBatch(reqOwner, parseKvBatch(entriesRaw))
            step := "respond"
    }

    internal transition respond() {
        guard: step = "respond"
        return: HttpServerResponse {
            body := "ok",
            code := 200
        }
    }
}
