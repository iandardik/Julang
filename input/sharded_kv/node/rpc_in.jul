import julay.funlib.serveHttp
import julay.funlib.portFromUrl
import julay.funlib.parseInt
import julay.funlib.split
import julay.funlib.length
import node.lib.fieldValue
import node.lib.parseCfg
import node.lib.PutResult
import node.lib.GetResult
import node.lib.OwnerEntry

/*
 * Inbound HTTP adapters: parse request → spawn a Shard child; encode its result → response.
 * No peer dials or ownership policy here.
 * Peer routes claim / moveBatch / keyCount spawn the same children that PerfectNet
 * delivers to in verification (specs/net.jul).
 */
export static proc ServerStarter {
    constructor initially(args : List<String>) {
        after:
            serveHttp(portFromUrl(parseCfg(args[1], parseInt(args[2])).me.url), HandleRpc.req ~> HandleRpc.resp)
        error:
            (length(args) ~= 2) -> "usage: ShardNode <config_file> <node_id>"
    }
}

fun encodeOwnersBody(entries : List<OwnerEntry>) : String =
    "owners=" + entries.fold("", (acc, e) ->
        if (acc = "") {
            e.k + "->" + e.owner
        } else {
            acc + "|" + e.k + "->" + e.owner
        })

fun bodyField(body : String, idx : Int) : String =
    fieldValue(split(body, "|")[idx])

export proc HandleRpc {
    const path : String
    const body : String
    var step : String
    var respBody : String
    var respCode : Int

    constructor req(r : HttpServerRequest) {
        transit:
            path := r.path
            body := r.body
            step := "route"
            respBody := ""
            respCode := 0
    }

    /* body: k=<k>|v=<v> */
    transition put(putK : String, putV : String) {
        guard:
            & step = "route"
            & path = "kv/put"
            & putK = bodyField(body, 1)
            & putV = bodyField(body, 2)
        transit: step := "wait"
    }

    /* body: k=<k> */
    transition get(getK : String) {
        guard: step = "route" & path = "kv/get" & getK = bodyField(body, 1)
        transit: step := "wait"
    }

    transition owners() {
        guard: step = "route" & path = "kv/owners"
        transit: step := "wait"
    }

    /* body: from=<url> */
    transition keyCount(fromUrl : String) {
        guard: step = "route" & path = "rpc/keyCount" & fromUrl = bodyField(body, 1)
        transit: step := "wait"
    }

    /* body: k=<k>|owner=<url>; fire-and-forget */
    transition claim(claimKey : String, claimOwner : String) {
        guard:
            & step = "route"
            & path = "rpc/claim"
            & claimKey = bodyField(body, 1)
            & claimOwner = bodyField(body, 2)
        transit:
            step := "done"
            respBody := "ok"
            respCode := 200
    }

    /* body: <ownerUrl>|<k>=<v>; fire-and-forget */
    transition moveBatch(moveOwner : String, moveKey : String, moveVal : String) {
        guard:
            & step = "route"
            & path = "rpc/moveBatch"
            & length(split(body, "|")) >= 2
            & moveOwner = split(body, "|")[1]
            & moveKey = split(split(body, "|")[2], "=")[1]
            & moveVal = split(split(body, "|")[2], "=")[2]
        transit:
            step := "done"
            respBody := "ok"
            respCode := 200
    }

    internal transition notFound() {
        guard:
            & step = "route"
            & path ~= "kv/put"
            & path ~= "kv/get"
            & path ~= "kv/owners"
            & path ~= "rpc/keyCount"
            & path ~= "rpc/claim"
            & path ~= "rpc/moveBatch"
        transit:
            step := "done"
            respBody := "NOT_FOUND"
            respCode := 404
    }

    transition putDone(result : PutResult) {
        guard: step = "wait"
        transit:
            step := "done"
            respBody := if (result.kind = "ok") { "ok" } else { "OWNER " + result.ownerUrl }
            respCode := if (result.kind = "ok") { 200 } else { 303 }
    }

    transition getDone(result : GetResult) {
        guard: step = "wait"
        transit:
            step := "done"
            respBody := when (result.kind) {
                "ok" -> "v=" + result.value
                "redirect" -> "OWNER " + result.ownerUrl
                else -> "MISSING"
            }
            respCode := when (result.kind) {
                "ok" -> 200
                "redirect" -> 303
                else -> 404
            }
    }

    transition ownersDone(rows : List<OwnerEntry>) {
        guard: step = "wait"
        transit:
            step := "done"
            respBody := encodeOwnersBody(rows)
            respCode := 200
    }

    transition keyCountDone(toUrl : String, replyCount : Int) {
        guard: step = "wait"
        transit:
            step := "done"
            respBody := "n=" + replyCount
            respCode := 200
    }

    return resp(r : HttpServerResponse) {
        guard:
            step = "done" & r = HttpServerResponse {
                body := respBody,
                code := respCode
            }
    }
}
