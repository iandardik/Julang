import julay.funlib.mapOf
import node.lib.NodeInfo
import node.lib.OwnerEntry
import node.lib.emptyNodeInfo
import specs.net.Key
import specs.net.Value

export static proc Store {
    var store : Map<Key, Value>
    var owners : Map<Key, NodeInfo>

    constructor initially(args : List<String>) {
        transit:
            store := mapOf()
            owners := mapOf()
    }

    service transition ownerOf(key : Key, owner : NodeInfo) {
        guard:
            owner = if (key in owners) {
                owners[key]
            } else {
                emptyNodeInfo()
            }
    }

    service transition getValue(getKey : Key, getVal : Value) {
        guard:
            getVal = store[getKey]
    }

    service transition putKV(key : Key, val : Value, owner : NodeInfo) {
        transit:
            store[key] := val
            owners[key] := owner
    }

    service transition getAllOwners(allOwners : List<OwnerEntry>) {
        guard:
            allOwners = owners.keys.toList().map(k -> OwnerEntry {
                key := k,
                owner := owners[k]
            })
    }
}

