import julay.funlib.length
import julay.funlib.parseInt
import node.lib.Node
import node.lib.CfgPair
import node.lib.parseCfg

export proc ClusterInfo := ClusterConf || MeInfo

export static proc ClusterConf {
    const cluster : List<Node>

    constructor initially(args : List<String>) {
        transit:
            let id : Int := parseInt(args[2])
            let cfg : CfgPair := parseCfg(args[1], id)
            cluster := cfg.cluster
        error:
            (length(args) ~= 2) -> "usage: ShardNode <config_file> <node_id>"
    }

    service transition getClusterSize(size : Int) {
        guard: size = cluster.length
    }

    service transition peerAt(idx : Int, peer : Node) {
        guard:
            peer = cluster[idx]
    }
}

export static proc MeInfo {
    const me : Node

    constructor initially(args : List<String>) {
        transit:
            let id : Int := parseInt(args[2])
            let cfg : CfgPair := parseCfg(args[1], id)
            me := cfg.me
        error:
            (length(args) ~= 2) -> "usage: ShardNode <config_file> <node_id>"
    }

    service transition getMyInfo(myInfo : Node) {
        guard: myInfo = me
    }
}
