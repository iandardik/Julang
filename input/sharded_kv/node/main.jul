import node.store.Store
import node.rpc_in.ServerStarter
import node.rpc_in.HandleRpc
import node.rpc_out.SendClaim
import node.rpc_out.SendMoveBatch
import node.rpc_out.SendKeyCount
import node.shard.Put
import node.shard.Get
import node.shard.Owners
import node.shard.KeyCount
import node.shard.ApplyClaim
import node.shard.ApplyMoveBatch
import node.shard.FindLightestPeer
import node.shard.BroadcastClaim
import node.shard.ReshardToPeer

/*
 * Parent↔child edges are inferred from nested || (ctor/return orientation).
 * Outer SendClaim meets every still-external BroadcastClaim.goClaim.
 * Subtrees parallel specs/protocol.jul (VerifPutPath / VerifApplyMovePath).
 */

proc FindLightestPath := FindLightestPeer || SendKeyCount
proc ReshardPath := ReshardToPeer || SendMoveBatch

proc PutPath := Put
    || FindLightestPath
    || BroadcastClaim
    || ReshardPath

proc ApplyMovePath := ApplyMoveBatch || BroadcastClaim

/* HandleRpc + shard workers (puts, gets, owners, inbound RPCs). */
proc HttpWorkers := HandleRpc
    || PutPath
    || Get
    || Owners
    || KeyCount
    || ApplyClaim
    || ApplyMovePath

export proc ShardNode := Store || ServerStarter || HttpWorkers || SendClaim
