import julay.funlib.doHttpRequest
import julay.funlib.parseInt
import node.lib.fieldValue
import specs.net.Key
import specs.net.Value

export proc RpcOut := SendOwnershipBroadcast

proc SendOwnershipBroadcast {
    const dest : String
    const body : String
    var sent : Boolean
    var knownOwner : NodeInfo

    constructor broadcastOwnershipToPeer(peer : NodeInfo, key : Key, myInfo : NodeInfo) {
        transit:
            dest := peer.url
            body := "k=" + key + "|owner=" + myInfo
            sent := false
            knownOwner := myInfo
    }

    internal transition send() {
        guard:
            ~sent
        transit:
            let resp := doHttpRequest(HttpClientRequest {
                url := dest + "/rpc/ownership",
                method := "POST",
                body := body
            }
            sent = resp.code >= 0
            knownOwner := getBody(resp.body,1)
    }

    return doneBroadcastOwnershipToPeer(owner : NodeInfo) {
        guard:
            & sent
            & owner = knownOwner
    }
}

