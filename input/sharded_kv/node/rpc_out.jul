import julay.funlib.doHttpRequest
import julay.funlib.parseInt
import node.lib.fieldValue

/*
 * Outbound peer RPCs for ShardNode: one child per message. Ctor names match the
 * PerfectNet send actions (specs/net.jul), so Shard syncs the same actions in the
 * JAR (spawning these children) and in TLA (enqueueing on the network).
 *
 *   goClaim / goMoveBatch: fire-and-forget; the child sends, then returns internally.
 *   goKeyCount: the child returns the peer's count to its parent via keyCountReply.
 */

export proc SendClaim {
    const dest : String
    const body : String
    var sent : Boolean

    constructor goClaim(peerUrl : String, key : String, owner : String) {
        transit:
            dest := peerUrl
            body := "k=" + key + "|owner=" + owner
            sent := false
    }

    internal transition send() {
        guard: ~sent
        transit:
            sent := doHttpRequest(HttpClientRequest {
                url := dest + "/rpc/claim",
                method := "POST",
                body := body
            }).code >= 0
    }

    internal return claimSent() {
        guard: sent
    }
}

export proc SendMoveBatch {
    const dest : String
    const body : String
    var sent : Boolean

    /* One KV per message: <ownerUrl>|<k>=<v> */
    constructor goMoveBatch(peerUrl : String, ownerUrl : String, key : String, val : String) {
        transit:
            dest := peerUrl
            body := ownerUrl + "|" + key + "=" + val
            sent := false
    }

    internal transition send() {
        guard: ~sent
        transit:
            sent := doHttpRequest(HttpClientRequest {
                url := dest + "/rpc/moveBatch",
                method := "POST",
                body := body
            }).code >= 0
    }

    internal return moveSent() {
        guard: sent
    }
}

export proc SendKeyCount {
    const dest : String
    const from : String
    var reply : Int
    var sent : Boolean

    constructor goKeyCount(peerUrl : String, fromUrl : String) {
        transit:
            dest := peerUrl
            from := fromUrl
            reply := 0
            sent := false
    }

    internal transition send() {
        guard: ~sent
        transit:
            reply := parseInt(fieldValue(doHttpRequest(HttpClientRequest {
                url := dest + "/rpc/keyCount",
                method := "POST",
                body := "from=" + from
            }).body))
            sent := true
    }

    return keyCountReply(replyFrom : String, count : Int) {
        guard: sent & replyFrom = dest & count = reply
    }
}
