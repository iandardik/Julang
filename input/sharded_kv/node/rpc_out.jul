import julay.funlib.doHttpRequest
import julay.funlib.parseInt
import julay.funlib.split
import node.lib.Node
import node.lib.fieldValue
import node.lib.Key

/*
 * Outbound ownership broadcast: POST k|id|url to a peer; reply body is id|url
 * for the resolved owner (this node or a higher-id winner).
 */
export proc RpcOut := SendOwnershipBroadcast

fun ownershipBodyField(body : String, idx : Int) : String =
    fieldValue(split(body, "|")[idx])

proc SendOwnershipBroadcast {
    const dest : String
    const body : String
    var sent : Boolean
    var knownOwner : Node

    constructor broadcastOwnershipToPeer(peer : Node, key : Key, myInfo : Node) {
        transit:
            dest := peer.url
            body := "k=" + key + "|id=" + (myInfo.id + "") + "|url=" + myInfo.url
            sent := false
            knownOwner := myInfo
    }

    internal transition send() {
        guard:
            ~sent
        transit:
            let resp : HttpClientResponse := doHttpRequest(HttpClientRequest {
                url := dest + "/rpc/ownership",
                method := "POST",
                body := body
            })
            sent := resp.code >= 0
            knownOwner := if (sent) {
                Node {
                    id := parseInt(ownershipBodyField(resp.body, 1)),
                    url := ownershipBodyField(resp.body, 2)
                }
            } else {
                knownOwner
            }
    }

    return doneBroadcastOwnershipToPeer(owner : Node) {
        guard:
            & sent
            & owner = knownOwner
    }
}
