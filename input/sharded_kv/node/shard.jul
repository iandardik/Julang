import julay.funlib.length
import julay.funlib.listOf
import julay.funlib.setOf
import node.lib.Node
import node.lib.emptyNode
import node.lib.PutResult
import node.lib.GetResult
import node.lib.OwnerEntry
import node.lib.Key
import node.lib.Value

export proc ShardLogic := (Put || BroadcastOwnership || RecvBroadcastOwnership)
    || Get || Owners


proc Put {
    const putKey : Key
    const putVal : Value
    var step : String
    var me : Node
    var keyOwner : Node

    constructor put(key : Key, val : Value) {
        transit:
            putKey := key
            putVal := val
            step := "getMyInfo"
            me := emptyNode()
            keyOwner := emptyNode()
    }

    client transition getMyInfo(myInfo : Node) {
        guard:
            step = "getMyInfo"
        transit:
            me := myInfo
            step := "ownerOf"
    }

    client transition ownerOf(key : Key, owner : Node) {
        guard:
            & step = "ownerOf"
            & key = putKey
        transit:
            let meIsOwner : Boolean := (owner = emptyNode() | owner = me)
            keyOwner := if (meIsOwner) { me } else { owner }
            step := if (meIsOwner) { "putKV" } else { "redirect" }
    }

    client transition putKV(key : Key, val : Value, owner : Node) {
        guard:
            & step = "putKV"
            & key = putKey
            & val = putVal
            & owner = keyOwner
        transit:
            step := "broadcast"
    }

    transition broadcastOwnership(key : Key, myInfo : Node) {
        guard:
            & step = "broadcast"
            & key = putKey
            & myInfo = me
        transit:
            step := "midBroadcast"
    }

    transition broadcastDone(resolvedOwner : Node) {
        guard:
            step = "midBroadcast"
        transit:
            keyOwner := resolvedOwner
            step := if (resolvedOwner = me) {
                "done"
            } else {
                // lost ownership during broadcast; redirect to the known owner
                "redirect"
            }
    }

    return putDone(result : PutResult) {
        guard:
            & (step = "done" | step = "redirect")
            & result = if (step = "done") {
                PutResult { kind := "ok", ownerUrl := "" }
            } else {
                PutResult { kind := "redirect", ownerUrl := keyOwner.url }
            }
    }
}

proc Get {
    const getKey : Key
    var step : String
    var me : Node
    var keyOwner : Node
    var value : Value

    constructor get(key : Key) {
        transit:
            getKey := key
            step := "getMyInfo"
            me := emptyNode()
            keyOwner := emptyNode()
            value := ""
    }

    client transition getMyInfo(myInfo : Node) {
        guard:
            step = "getMyInfo"
        transit:
            me := myInfo
            step := "ownerOf"
    }

    client transition ownerOf(key : Key, owner : Node) {
        guard:
            & step = "ownerOf"
            & key = getKey
        transit:
            keyOwner := owner
            step := if (owner = emptyNode()) {
                "missing"
            } else if (owner = me) {
                "keyCommitted"
            } else {
                "redirect"
            }
    }

    client transition keyCommitted(key : Key, isCommitted : Boolean) {
        guard:
            & step = "keyCommitted"
            & key = getKey
        transit:
            step := if (isCommitted) {
                "getValue"
            } else {
                // do not return an uncommitted value to the client
                "missing"
            }
    }

    // look up the value of the key if this node owns it.
    client transition getValue(getKey : Key, getVal : Value) {
        guard:
            & step = "getValue"
            & getKey = this.getKey
        transit:
            value := getVal
            step := "ok"
    }

    return getDone(result : GetResult) {
        guard:
            & step in setOf("ok", "redirect", "missing")
            & result = when (step) {
                "ok" -> GetResult {
                    kind := "ok",
                    value := value,
                    ownerUrl := ""
                }
                "redirect" -> GetResult {
                    kind := "redirect",
                    value := "",
                    ownerUrl := keyOwner.url
                }
                else -> GetResult {
                    kind := "missing",
                    value := "",
                    ownerUrl := ""
                }
            }
    }
}

proc Owners {
    var step : String
    var owners : List<OwnerEntry>

    constructor owners() {
        transit:
            step := "getAllOwners"
            owners := listOf<OwnerEntry>()
    }

    client transition getAllOwners(allOwners : List<OwnerEntry>) {
        guard:
            step = "getAllOwners"
        transit:
            step := "done"
            owners := allOwners
    }

    return ownersDone(allOwners : List<OwnerEntry>) {
        guard:
            & step = "done"
            & allOwners = owners
    }
}

/* Broadcast to the other nodes that we own the key. It may be the
 * case that another node is also trying to add the same key to their
 * store, in which case the node with the higher id wins.
 */
proc BroadcastOwnership {
    const bcKey : Key
    const me : Node
    var step : String
    var clusterSize : Int
    var peerIdx : Int
    var peerInfo : Node
    var knownOwner : Node

    constructor broadcastOwnership(key : Key, myInfo : Node) {
        transit:
            bcKey := key
            me := myInfo
            step := "getClusterSize"
            clusterSize := 2
            peerIdx := 1
            peerInfo := emptyNode()
            knownOwner := myInfo
    }

    client transition getClusterSize(size : Int) {
        guard:
            step = "getClusterSize"
        transit:
            clusterSize := size
            step := "peerAt"
    }

    client transition peerAt(idx : Int, peer : Node) {
        guard:
            & step = "peerAt"
            & knownOwner = me
            & peerIdx <= clusterSize
            & idx = peerIdx
        transit:
            peerInfo := peer
            step := if (peer = me | peer = emptyNode()) {
                "nextPeer"
            } else {
                "keyInStore"
            }
    }

    // in between each peer broadcast, check to make sure that the key is
    // still in the store (uncommitted); if it isn't, it means that another
    // node claimed ownership over the key. if we lose ownership, then we
    // redirect the client to the new owner.
    client transition keyInStore(key : Key, present : Boolean) {
        guard:
            & step = "keyInStore"
            & key = bcKey
        transit:
            step := if (present) {
                "broadcast"
            } else {
                "ownerOf"
            }
    }

    client transition ownerOf(key : Key, owner : Node) {
        guard:
            & step = "ownerOf"
            & key = bcKey
        transit:
            knownOwner := owner
            step := "done"
    }

    transition broadcastOwnershipToPeer(peer : Node, key : Key, myInfo : Node) {
        guard:
            & step = "broadcast"
            & peer = peerInfo
            & key = bcKey
            & myInfo = me
        transit:
            step := "midBroadcast"
    }

    transition doneBroadcastOwnershipToPeer(owner : Node, src : Node, k : Key) {
        guard:
            & step = "midBroadcast"
            & src = peerInfo
            & k = bcKey
        transit:
            knownOwner := owner
            step := "nextPeer"
    }

    internal transition nextPeer() {
        guard:
            & step = "nextPeer"
            & knownOwner = me
        transit:
            peerIdx := peerIdx + 1
            step := "peerAt"
    }

    client transition commitKey(key : Key) {
        guard:
            // the first two guards mean that all peers agree that the broadcast
            // is complete and we're the owner of the key
            & step = "peerAt"
            & peerIdx > clusterSize
            & knownOwner = me
            & key = bcKey
        transit:
            step := "done"
    }

    // if at any point we realize that the knownOwner is not "me" then drop
    // the key and finish broadcasting.
    client transition dropKey(key : Key) {
        guard:
            & step ~= "done"
            & knownOwner ~= me
            & key = bcKey
        transit:
            step := "done"
    }

    return broadcastDone(resolvedOwner : Node) {
        guard:
            & step = "done"
            & resolvedOwner = knownOwner
    }
}

proc RecvBroadcastOwnership {
    const bcKey : Key
    const bcOwner : Node
    var state : String
    var localOwner : Node
    var replyOwner : Node

    constructor recvBroadcastOwnership(key : Key, sender : Node) {
        transit:
            bcKey := key
            bcOwner := sender
            localOwner := emptyNode()
            replyOwner := sender
            state := "keyInStore"
    }

    client transition keyInStore(key : Key, present : Boolean) {
        guard:
            & state = "keyInStore"
            & key = bcKey
        transit:
            state := if (present) {
                "ownerOf"
            } else {
                "addOwnedKey"
            }
    }

    client transition ownerOf(key : Key, owner : Node) {
        guard:
            & state = "ownerOf"
            & key = bcKey
        transit:
            localOwner := owner
            state := "keyCommitted"
    }

    client transition keyCommitted(key : Key, isCommitted : Boolean) {
        guard:
            & state = "keyCommitted"
            & key = bcKey
        transit:
            // committed keys always keep the local owner; else higher id wins
            let localWins : Boolean := isCommitted | (localOwner.id >= bcOwner.id)
            replyOwner := if (localWins) { localOwner } else { bcOwner }
            state := if (localWins) { "done" } else { "dropKey" }
    }

    client transition addOwnedKey(key : Key, owner : Node) {
        guard:
            & state = "addOwnedKey"
            & key = bcKey
            & owner = bcOwner
        transit:
            replyOwner := bcOwner
            state := "done"
    }

    client transition dropKey(key : Key) {
        guard:
            & state = "dropKey"
            & key = bcKey
        transit:
            state := "done"
    }

    return doneRecvBroadcastOwnership(owner : Node, dest : Node, k : Key) {
        guard:
            & state = "done"
            & owner = replyOwner
            & dest = bcOwner
            & k = bcKey
    }
}
