import julay.funlib.length
import julay.funlib.listOf
import julay.funlib.setOf
import node.cluster_info.ClusterInfo
import node.lib.NodeInfo
import node.lib.emptyNodeInfo
import node.lib.PutResult
import node.lib.GetResult
import node.lib.OwnerEntry
import specs.net.Key
import specs.net.Value

export proc ShardLogic := PathLogic || ClusterInfo

proc PathLogic := (Put || BroadcastOwnership || RecvBroadcastOwnership)
    || Get || Owners


proc Put {
    const putKey : Key
    const putVal : Value
    var step : String
    var me : NodeInfo
    var keyOwner : NodeInfo

    constructor put(key : Key, val : Value) {
        transit:
            putKey := key
            putVal := val
            step := "getMyInfo"
            me := emptyNodeInfo()
            keyOwner := emptyNodeInfo()
    }

    client transition getMyInfo(myInfo : NodeInfo) {
        guard:
            step = "getMyInfo"
        transit:
            me := myInfo
            step := "ownerOf"
    }

    client transition ownerOf(key : Key, owner : NodeInfo) {
        guard:
            & step = "ownerOf"
            & key = putKey
        transit:
            let meIsOwner : Boolean := (owner = emptyNodeInfo() | owner = me)
            keyOwner := if (meIsOwner) { me } else { owner }
            step := if (meIsOwner) { "broadcast" } else { "redirect" }
    }

    transition broadcastOwnership(key : Key, myInfo : NodeInfo) {
        guard:
            & step = "broadcast"
            & key = putKey
            & myInfo = me
        transit:
            step := "midBroadcast"
    }

    transition broadcastDone(resolvedOwner : NodeInfo) {
        guard:
            step = "midBroadcast"
        transit:
            keyOwner := resolvedOwner 
            step := if (keyOwner = me) {
                "put"
            } else {
                // if another node ended up owning the key then don't add it
                // to the store; instead, redirect to that node and wait for
                // their broadcast for adding the ownership info to the store.
                "redirect"
            }
    }

    client transition putKV(key : Key, val : Value, owner : NodeInfo) {
        guard:
            & step = "put"
            & key = putKey
            & val = putVal
            & owner = keyOwner
        transit:
            step := "done"
    }

    return putDone(result : PutResult) {
        guard:
            & (step = "done" | step = "redirect")
            & result = if (step = "done") {
                PutResult { kind := "ok", ownerUrl := "" }
            } else {
                PutResult { kind := "redirect", ownerUrl := keyOwner.url }
            }
    }
}

proc Get {
    const getKey : Key
    var step : String
    var me : NodeInfo
    var keyOwner : NodeInfo
    var value : Value

    constructor get(key : Key) {
        transit:
            getKey := key
            step := "getMyInfo"
            me := emptyNodeInfo()
            keyOwner := emptyNodeInfo()
            value := ""
    }

    client transition getMyInfo(myInfo : NodeInfo) {
        guard:
            step = "getMyInfo"
        transit:
            me := myInfo
            step := "ownerOf"
    }

    client transition ownerOf(key : Key, owner : NodeInfo) {
        guard:
            & step = "ownerOf"
            & key = getKey
        transit:
            keyOwner := owner
            step := if (owner = emptyNodeInfo()) {
                "missing"
            } else if (owner = me) {
                "getvalue"
            } else {
                "redirect"
            }
    }

    // look up the value of the key if this node owns it.
    client transition getValue(getKey : Key, getVal : Value) {
        guard:
            & step = "getvalue"
            & getKey = this.getKey
        transit:
            value := getVal
            step := "ok"
    }

    return getDone(result : GetResult) {
        guard:
            & step in setOf("ok", "redirect", "missing")
            & result = when (step) {
                "ok" -> GetResult {
                    kind := "ok",
                    value := value,
                    ownerUrl := ""
                }
                "redirect" -> GetResult {
                    kind := "redirect",
                    value := "",
                    ownerUrl := keyOwner.url
                }
                else -> GetResult {
                    kind := "missing",
                    value := "",
                    ownerUrl := ""
                }
            }
    }
}

proc Owners {
    var step : String
    var owners : List<OwnerEntry>

    constructor owners() {
        transit:
            step := "getAllOwners"
            owners := listOf<OwnerEntry>()
    }

    client transition getAllOwners(allOwners : List<OwnerEntry>) {
        guard:
            step = "getAllOwners"
        transit:
            step := "done"
            owners := allOwners
    }

    return ownersDone(allOwners : List<OwnerEntry>) {
        guard:
            & step = "done"
            & allOwners = owners
    }
}

/* Broadcast to the other nodes that we own the key. It may be the
 * case that another node is also trying to add the same key to their
 * store, in which case the node with the higher id wins.
 */
proc BroadcastOwnership {
    const bcKey : Key
    const me : NodeInfo
    var step : String
    var clusterSize : Int
    var peerIdx : Int
    var peerInfo : NodeInfo
    var knownOwner : NodeInfo

    constructor broadcastOwnership(key : Key, myInfo : NodeInfo) {
        transit:
            bcKey := key
            me := myInfo
            step := "getClusterSize"
            clusterSize := 0
            peerIdx := 1
            peerInfo := emptyNodeInfo()
            knownOwner := myInfo
    }

    client transition getClusterSize(size : Int) {
        guard:
            step = "getClusterSize"
        transit:
            clusterSize := size
            step := "peerAt"
    }

    client transition peerAt(idx : Int, peer : NodeInfo) {
        guard:
            & step = "peerAt"
            & peerIdx <= clusterSize
            & idx = peerIdx
        transit:
            peerInfo := peer
            step := if (peer = me | peer = emptyNodeInfo()) {
                "nextPeer"
            } else {
                "broadcast"
            }
    }

    transition broadcastOwnershipToPeer(peer : NodeInfo, key : Key, myInfo : NodeInfo) {
        guard:
            & step = "broadcast"
            & peer = peerInfo
            & key = bcKey
            & myInfo = me
        transit:
            step := "midBroadcast"
    }

    transition doneBroadcastOwnershipToPeer(owner : NodeInfo) {
        guard:
            & step = "midBroadcast"
        transit:
            knownOwner := owner
            step := "nextPeer"
    }

    internal transition nextPeer() {
        guard:
            step = "nextPeer"
        transit:
            peerIdx := if (knownOwner = me) {
                peerIdx + 1
            } else {
                // if we find a different owner of the same key then abort the broadcast
                clusterSize + 1
            }
            step := "peerAt"
    }

    return broadcastDone(resolvedOwner : NodeInfo) {
        guard:
            & resolvedOwner = knownOwner
            & peerIdx > clusterSize
    }
}

// TODO implement
// 1. Add the ownership info to the store
// 2. Add committed to store for keys and return whether the key exists
proc RecvBroadcastOwnership {
    constructor recvBroadcastOwnership(key : Key) {
    }

    return doneRecvBroadcastOwnership(owner : NodeInfo) {
        guard:
            owner = emptyNodeInfo()
    }
}
