import julay.funlib.setOf
import node.lib.Key
import node.lib.Value
import node.lib.Node

type OwnershipReq {
    src : Node
    dest : Node
    k : Key
    from : Node
}

type OwnershipReply {
    src : Node
    dest : Node
    owner : Node
}

// assume a perfect network for intra-cluster messages
export spec PerfectNet := OwnershipReqs || OwnershipReplies

static spec OwnershipReqs {
    var ownershipReqs : Set<OwnershipReq> := setOf()

    constructor initially(args : List<String>) {}

    transition broadcastOwnershipToPeer(peer : Node, key : Key, myInfo : Node) also (n : Node) {
        guard: myInfo = n
        transit:
            ownershipReqs := ownershipReqs + setOf(OwnershipReq {
                src := n,
                dest := peer,
                k := key,
                from := myInfo
            })
    }

    transition recvBroadcastOwnership(key : Key, sender : Node) also (n : Node) {
        guard:
            OwnershipReq {
                src := sender,
                dest := n,
                k := key,
                from := sender
            } in ownershipReqs
        transit:
            ownershipReqs := ownershipReqs - setOf(OwnershipReq {
                src := sender,
                dest := n,
                k := key,
                from := sender
            })
    }
}

static spec OwnershipReplies {
    var ownershipReplies : Set<OwnershipReply> := setOf()

    constructor initially(args : List<String>) {}

    transition doneRecvBroadcastOwnership(owner : Node) also (n : Node, dest : Node) {
        transit:
            ownershipReplies := ownershipReplies + setOf(OwnershipReply {
                src := n,
                dest := dest,
                owner := owner
            })
    }

    transition doneBroadcastOwnershipToPeer(owner : Node) also (n : Node, src : Node) {
        guard:
            OwnershipReply {
                src := src,
                dest := n,
                owner := owner
            } in ownershipReplies
        transit:
            ownershipReplies := ownershipReplies - setOf(OwnershipReply {
                src := src,
                dest := n,
                owner := owner
            })
    }
}
