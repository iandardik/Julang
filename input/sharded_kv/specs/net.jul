import julay.funlib.setOf
import node.lib.Key
import node.lib.Value
import node.lib.NodeInfo

export type NodeSet := String

type OwnershipReq {
    src : NodeSet
    dest : NodeSet
    k : Key
    from : NodeInfo
}

type OwnershipReply {
    src : NodeSet
    dest : NodeSet
    owner : NodeInfo
}

// assume a perfect network for intra-cluster messages
export spec PerfectNet := OwnershipReqs || OwnershipReplies

static spec OwnershipReqs {
    var ownershipReqs : Set<OwnershipReq> := setOf()

    constructor initially(args : List<String>) {}

    transition broadcastOwnershipToPeer(peer : NodeInfo, key : Key, myInfo : NodeInfo) also (n : NodeSet) {
        guard: myInfo.url = n
        transit:
            ownershipReqs := ownershipReqs + setOf(OwnershipReq {
                src := n,
                dest := peer.url,
                k := key,
                from := myInfo
            })
    }

    transition recvBroadcastOwnership(key : Key, sender : NodeInfo) also (n : NodeSet) {
        guard:
            OwnershipReq {
                src := sender.url,
                dest := n,
                k := key,
                from := sender
            } in ownershipReqs
        transit:
            ownershipReqs := ownershipReqs - setOf(OwnershipReq {
                src := sender.url,
                dest := n,
                k := key,
                from := sender
            })
    }
}

static spec OwnershipReplies {
    var ownershipReplies : Set<OwnershipReply> := setOf()

    constructor initially(args : List<String>) {}

    transition doneRecvBroadcastOwnership(owner : NodeInfo) also (n : NodeSet, dest : NodeSet) {
        transit:
            ownershipReplies := ownershipReplies + setOf(OwnershipReply {
                src := n,
                dest := dest,
                owner := owner
            })
    }

    transition doneBroadcastOwnershipToPeer(owner : NodeInfo) also (n : NodeSet, src : NodeSet) {
        guard:
            OwnershipReply {
                src := src,
                dest := n,
                owner := owner
            } in ownershipReplies
        transit:
            ownershipReplies := ownershipReplies - setOf(OwnershipReply {
                src := src,
                dest := n,
                owner := owner
            })
    }
}
