import node.store.Store
import node.shard.ShardLogic
import node.cluster_info.ClusterConf
import node.cluster_info.MeInfo
import specs.net.PerfectNet
import node.lib.emptyNode
import node.lib.Node
import node.lib.Key
import node.lib.Value

type DynProc

spec Cluster := (Store || ShardLogic || MeInfo)[n : Node] || ClusterConf {
    Node := { "n1", "n2", "n3" }
    Key := { "k1", "k2"}
    Value := { "v1", "v2" }
    DynProc := { "dp1", "dp2" }
    init: ClusterConf.cluster.length = Node.length
    init: forall i : Int, (i >= 1 & i <= ClusterConf.cluster.length) => ClusterConf.cluster[i].id = i
    init: forall n : Node, n.url = n
}

// system invariants

invariant KeysUnique := forall n1,n2 : Node, forall k : Key, forall v1,v2 : Value,
    (k in Store[n1].committed & k in Store[n1].store & Store[n1].store[k] = v1 &
     k in Store[n2].committed & k in Store[n2].store & Store[n2].store[k] = v2) => (n1 = n2 & v1 = v2)

invariant CommittedImpliesOwn := forall n : Node, forall k : Key,
    (k in Store[n].committed) =>
        (k in Store[n].store & k in Store[n].owners & Store[n].owners[k] = n)

invariant KeyUniquelyOwned := forall n1,n2,owner1,owner2 : Node, forall k : Key,
    (k in Store[n1].committed & k in Store[n1].owners & Store[n1].owners[k] = owner1 &
     k in Store[n2].committed & k in Store[n2].owners & Store[n2].owners[k] = owner2) => owner1 = owner2

invariant OwnerHasValue := forall n : Node, forall k : Key,
    (k in Store[n].owners & Store[n].owners[k] = n) => (k in Store[n].store)

invariant NoEmptyOwner := forall n : Node, forall k : Key,
    ~(k in Store[n].owners & Store[n].owners[k] = emptyNode())

invariant NoStaleKeys := forall n : Node, forall k : Key, forall d : DynProc,
    (Put[n][d].step = "done" & Put[n][d].putKey = k &
     k in Store[n].owners & Store[n].owners[k] = n) => (k in Store[n].committed)

invariant ProtocolInvs := KeysUnique
    & CommittedImpliesOwn
    & KeyUniquelyOwned
    & OwnerHasValue
    & NoEmptyOwner
    & NoStaleKeys


export spec SysSpec := Cluster || PerfectNet |= ProtocolInvs {
    unsynced put, putDone, get, getDone, owners, ownersDone
}
