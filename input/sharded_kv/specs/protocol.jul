import node.store.Store
import node.shard.Put
import node.shard.KeyCount
import node.shard.ApplyClaim
import node.shard.ApplyMoveBatch
import node.shard.FindLightestPeer
import node.shard.BroadcastClaim
import node.shard.ReshardToPeer
import specs.net.PerfectNet
import specs.net.NodeSet
import specs.net.Key
import specs.net.Value

/*
 * TLA assembly: same Shard children as ShardNode, re-parented. Put's constructor
 * / return stay unsynced (environment clients). PerfectNet stands in for
 * RpcIn/RpcOut — unindexed (shared bags); node state is create-indexed once.
 *
 * Nesting mirrors node/main.jul (PutPath / ApplyMovePath) under Verif* names so
 * sys.jul can compile JAR + TLA together without decl clashes. Each BroadcastClaim
 * seals with its own parent (Put vs ApplyMoveBatch).
 */

/* Client put path: Put + helpers (FindLightestPeer / BroadcastClaim / ReshardToPeer). */
spec VerifPutPath := Put
    || FindLightestPeer
    || BroadcastClaim
    || ReshardToPeer

/* Inbound move-batch worker and its claim fan-out. */
spec VerifApplyMovePath := ApplyMoveBatch || BroadcastClaim

/* Peer RPC workers (PerfectNet is composed beside the indexed node, not under it). */
spec PeerInbound := KeyCount || ApplyClaim || VerifApplyMovePath

spec Node := Store || VerifPutPath || PeerInbound

spec Cluster := Node[n : NodeSet] {
    NodeSet := { "n1", "n2", "n3" }
    Key := { "a", "b", "c", "d", "e", "f", "g", "h" }
    Value := { "v1", "v2", "v3" }
}

invariant AtMostOneStore := forall k : Key, forall n1 : NodeSet, forall n2 : NodeSet,
    (k in Store[n1].store & k in Store[n2].store) => n1 = n2

invariant OwnerHasValue := forall n : NodeSet, forall k : Key,
    (k in Store[n].owners & Store[n].owners[k] = n) => k in Store[n].store

invariant OwnersAgree := forall n1 : NodeSet, forall n2 : NodeSet, forall k : Key,
    (k in Store[n1].owners & k in Store[n2].owners) =>
        Store[n1].owners[k] = Store[n2].owners[k]

/* PerfectNet is unindexed; also (n : NodeSet) merges with Cluster's create-index n. */
export spec ShardSpec := Cluster || PerfectNet
    |= (AtMostOneStore & OwnerHasValue & OwnersAgree)
