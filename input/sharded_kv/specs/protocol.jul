import node.store.Store
import node.shard.Put
import node.shard.KeyCount
import node.shard.ApplyClaim
import node.shard.ApplyMoveBatch
import node.shard.FindLightestPeer
import node.shard.BroadcastClaim
import node.shard.ReshardToPeer
import specs.net.PerfectNet
import specs.net.NodeSet
import specs.net.Key
import specs.net.Value

/*
 * Compositional TLA: Store is verified under assumption StoreAsm; ShardEnv (workers
 * + PerfectNet) is checked to establish StoreAsm.
 *
 *   ShardEnvSpec := ShardEnv |= StoreAsm
 *   StoreSpec    := <StoreAsm> IndexedStore <StoreInvs>
 *
 * StoreAsm: putFromMove only after a matching applyClaim (proxy for "donated toward
 * owner"). Put's put / putDone stay unsynced (environment clients). PerfectNet is
 * unindexed beside the create-indexed workers. Verif* names avoid decl clashes with
 * node/main.jul.
 */

/* Client put path: Put + helpers (FindLightestPeer / BroadcastClaim / ReshardToPeer). */
spec VerifPutPath := Put
    || FindLightestPeer
    || BroadcastClaim
    || ReshardToPeer

/* Inbound move-batch worker and its claim fan-out. */
spec VerifApplyMovePath := ApplyMoveBatch || BroadcastClaim

/* Peer RPC workers (PerfectNet is composed beside the indexed workers, not under them). */
spec PeerInbound := KeyCount || ApplyClaim || VerifApplyMovePath

/* Everything that syncs with Store — the store's environment. */
spec ShardEnvCore := VerifPutPath || PeerInbound

spec ShardEnv := ShardEnvCore[n : NodeSet] {
    NodeSet := { "n1", "n2", "n3" }
    Key := { "a", "b", "c", "d", "e", "f", "g", "h" }
    Value := { "v1", "v2", "v3" }
} || PerfectNet

spec IndexedStore := Store[n : NodeSet] {
    NodeSet := { "n1", "n2", "n3" }
    Key := { "a", "b", "c", "d", "e", "f", "g", "h" }
    Value := { "v1", "v2", "v3" }
}

/* History: (key, owner) was claimed at some indexed Store/Shard sync. */
fluent Claimed(k : Key, owner : String) {
    initially false
    on applyClaim[n](claimKey, claimOwner) := true
}

/* Nullary violation: putFromMove without a prior matching claim. */
fluent BadMove {
    initially false
    on putFromMove[n](moveKey, _, moveOwner) := ~Claimed(moveKey, moveOwner)
}

invariant StoreAsm := ~BadMove

invariant AtMostOneStore := forall k : Key, forall n1 : NodeSet, forall n2 : NodeSet,
    (k in Store[n1].store & k in Store[n2].store) => n1 = n2

invariant OwnerHasValue := forall n : NodeSet, forall k : Key,
    (k in Store[n].owners & Store[n].owners[k] = n) => k in Store[n].store

invariant OwnersAgree := forall n1 : NodeSet, forall n2 : NodeSet, forall k : Key,
    (k in Store[n1].owners & k in Store[n2].owners) =>
        Store[n1].owners[k] = Store[n2].owners[k]

invariant StoreInvs := AtMostOneStore & OwnerHasValue & OwnersAgree

export spec ShardEnvSpec := ShardEnv |= StoreAsm

export spec StoreSpec := <StoreAsm> IndexedStore <StoreInvs>
