import node.store.Store
import node.shard.ShardLogic
import node.cluster_info.ClusterInfo
import specs.net.PerfectNet
import specs.net.NodeSet
import node.lib.Key
import node.lib.Value

spec ClusterStore := Store[n : NodeSet] {
    NodeSet := { "n1", "n2" }
    Key := { "k1", "k2"}
    Value := { "v1", "v2" }
}

spec Cluster := (Store || ShardLogic)[n : NodeSet] {
    const global ClusterInfo.cluster
    NodeSet := { "n1", "n2" }
    Key := { "k1", "k2"}
    Value := { "v1", "v2" }
    init: cluster.length = NodeSet.length
    init: forall i : Int, (i >= 1 & i <= cluster.length) => cluster[i].id = i
    init: forall n1 : NodeSet, forall n2 : NodeSet,
        (ClusterInfo[n1].me = ClusterInfo[n2].me) => (n1 = n2)
}


// system invariants

invariant KeysUnique := forall n1,n2 : NodeSet, forall k : Key, forall v1,v2 : Value,
    (Store[n1].store[k] = v1 & Store[n2].store[k] = v2) => (n1 = n2 & v1 = v2)

invariant KeyUniquelyOwned := forall n1,n2,owner1,owner2 : NodeSet, forall k : Key,
    (Store[n1].owner[k] = owner1 & Store[n2].owner[k] = owner2) => owner1 = owner2

invariant OwnerHasValue := forall n : NodeSet, forall k : Key,
    Store[n].owners[k] = n <=> k in Store[n].store

// just KeysUnique for now
invariant ProtocolInvs := KeysUnique


export spec StoreSpec := <true> ClusterStore <ProtocolInvs>

export spec SysSpec := <true> Cluster || PerfectNet <ProtocolInvs> {
    unsynced put, putDone, get, getDone, owners, ownersDone
}
