p-class PeriodicPrint {
    var step : String

    constructor initially(args : List<String>) {
        transit:
            step := "A"
    }

    transition println() {
        guard:   step = "A"
        transit: step := "B"
        effect:  println("hi")
    }

    transition wait() {
        guard:   step = "B"
        transit: step := "A"
        effect:  delaySeconds(2)
    }
}

program MemTest := PeriodicPrint
