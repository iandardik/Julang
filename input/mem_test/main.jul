proc PeriodicPrint {
    var step : String

    constructor initially(args : List<String>) {
        transit:
            step := "A"
    }

    internal transition println() {
        guard:   step = "A"
        transit: step := "B"
        after:  println("hi")
    }

    internal transition wait() {
        guard:   step = "B"
        transit: step := "A"
        after:  delaySeconds(2)
    }
}

proc MemTest := PeriodicPrint

compile MemTest
