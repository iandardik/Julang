import julay.funlib.serveHttp

static proc ServerStarter {
    constructor initially(args : List<String>) {
        after:
            serveHttp(8000, IncHandler.req ~> IncHandler.respond)
    }
}

export proc IncHandler {
    var localCounter : Int
    var step : String

    constructor req(r : HttpServerRequest) {
        transit:
            localCounter := -1
            step := "A"
    }

    client transition increment() {
        guard: step = "A"
        transit: step := "B"
    }

    client transition getCounter(counterVal : Int) {
        guard: step = "B"
        transit:
            localCounter := counterVal
            step := "C"
    }

    return respond(resp : HttpServerResponse) {
        guard:
            step = "C" & resp = HttpServerResponse {
                body := localCounter + "",
                code := 200
            }
    }
}

export proc ServerLogic := ServerStarter || IncHandler
