import julaylib.pclass.Timer

/* prints the current value of the counter every 5 seconds
*/
p-class PeriodicPrint {
    var localCounter : Int
    var step : String

    constructor initially(args : List<String>) {
        transit:
            localCounter := -1
            step := "A"
    }

    constructor timeout() {
        transit:
            localCounter := -1
            step := "A"
    }

    transition getCounter(counterVal : Int) {
        guard:
            step = "A"
        transit:
            localCounter := counterVal
            step := "B"
    }

    internal transition println() {
        guard:   step = "B"
        transit: step := "C"
        effect:  println(localCounter + "")
    }

    transition timer(time : Int) {
        guard:   step = "C" & time = 5 // seconds
        transit: step := "D"
    }
}

proc Printer := PeriodicPrint || Timer
