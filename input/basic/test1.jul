p-class S {
    var x : Int
    var print : Bool

    constructor initially() {
        transit:
            x := 0
            print := true
    }
    
    transition increment(inc : Int) {
        guard:
            (x <= 10) & (inc > 0) & (print = false)
        transit:
            x := x + inc
            print := true
    }

    transition printlnInt(msg : Int) {
        guard:
            (print = true) & (msg = x)
        transit:
            print := false
    }
}

p-class T {
    var x : Int

    constructor initially() {
        transit:
            x := 0
    }

    transition increment(inc : Int) {
        guard:
            inc > 3 & x <= 10
        transit:
            x := x + inc
    }
}

program main := S || T || PrintlnInt
