p-class KVServer {
	var state : String
	var key : String
	var val : String

	constructor receiveHttpReq(req : HttpExchangeInfo) {
		transit:
			state := "DB-req"
			key := req
			val := ""
	}

	transition reqFromDB(k : String) {
		guard:
			k = key & state = "DB-req"
		transit:
			state := "DB-read"
	}

	transition respFromDB(v : String) {
		guard:
			state = "DB-read"
		transit:
			state := "respond"
			val := v
	}

	transition respondToHttpReq(resp : String, code : Int) {
		guard:
			resp = val & code = 200 & state = "respond"
		transit:
			state := "done"
	}
}

p-class DBReader {
	var addr : String
	var state : String
	var key : String
	var val : String

	constructor initially(args : ListString) {
		error:
			args != 1
		transit:
			addr := args
			state := "readyForReq"
	}

	transition reqFromDB(k : String) {
		guard:
			state = "readyForReq"
		transit:
			key := k
			state := "DB-read"
	}

	transition readFromDB(a : String, k : String, v : String) {
		guard:
			a = addr & k = key & state = "DB-read"
		transit:
			val := v
			state := "DB-resp"
	}

	transition respFromDB(v : String) {
		guard:
			v = val & state = "DB-resp"
		transit:
			state := "readyForReq"
	}

	transition close() {
		guard:
			state = "readyForReq"
		transit:
			state := "close"
	}

	transition closeDB() {
		guard:
			state = "close"
		transit:
			state := "done"
	}
}

proc dbReader := DBReader || RedisDB // need to import RedisDB in the future
proc server := dbReader || KVServer

program serverProg := server

