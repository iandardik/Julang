/*
 * Core "protocol" state machine: a counter exposed via hub RPCs.
 * Handlers parse HTTP and sync into these actions — they never touch counter
 * memory directly.
 */
export static proc Protocol {
    var counter : Int

    constructor initially(args : List<String>) {
        transit: counter := 0
    }

    service transition increment(newVal : Int) {
        guard: newVal = counter + 1
        transit: counter := counter + 1
    }

    service transition add(delta : Int, newVal : Int) {
        guard: newVal = counter + delta
        transit: counter := counter + delta
    }

    service transition getCounter(counterVal : Int) {
        guard: counterVal = counter
    }
}
