import julay.funlib.serveHttp
import julay.funlib.parseInt
import julay.funlib.split
import lib.fieldValue

/*
 * Inbound HTTP → RPC router (same shape as Raft RpcIn / handleRpc).
 * HandleRpc routes by path and spawns one child per RPC; the child syncs with
 * Protocol and returns its result to HandleRpc, which then returns the response.
 */
export proc RpcIn := ServerInitializer || HandleRpc || IncrementRpc<HandleRpc> || GetRpc<HandleRpc> || AddRpc<HandleRpc>

static proc ServerInitializer {
    constructor initially(args : List<String>) {
        after:
            serveHttp(8000, HandleRpc.req ~> HandleRpc.resp)
    }
}

proc HandleRpc {
    const path : String
    const body : String
    var step : String
    var respBody : String
    var respCode : Int

    constructor req(r : HttpServerRequest) {
        transit:
            path := r.path
            body := r.body
            step := "route"
            respBody := ""
            respCode := 0
    }

    transition goIncrement() {
        guard: step = "route" & path = "rpc/increment"
        transit: step := "wait"
    }

    transition goGet() {
        guard: step = "route" & path = "rpc/get"
        transit: step := "wait"
    }

    // Body: delta=<int>  (pipe-delimited like Raft; single field for now)
    transition goAdd(delta : Int) {
        guard:
            & step = "route"
            & path = "rpc/add"
            & delta = parseInt(fieldValue(split(body, "|")[1]))
        transit: step := "wait"
    }

    internal transition notFound() {
        guard:
            & step = "route"
            & path ~= "rpc/increment"
            & path ~= "rpc/get"
            & path ~= "rpc/add"
        transit:
            step := "done"
            respBody := "NOT_FOUND"
            respCode := 404
    }

    transition incremented(v : Int) {
        guard: step = "wait"
        transit:
            step := "done"
            respBody := "v=" + v
            respCode := 200
    }

    transition got(v : Int) {
        guard: step = "wait"
        transit:
            step := "done"
            respBody := "v=" + v
            respCode := 200
    }

    transition added(v : Int) {
        guard: step = "wait"
        transit:
            step := "done"
            respBody := "v=" + v
            respCode := 200
    }

    return resp(r : HttpServerResponse) {
        guard:
            step = "done" & r = HttpServerResponse {
                body := respBody,
                code := respCode
            }
    }
}

proc IncrementRpc {
    var step : String
    var result : Int

    constructor goIncrement() {
        transit:
            step := "call"
            result := -1
    }

    client transition increment(newVal : Int) {
        guard: step = "call"
        transit:
            step := "respond"
            result := newVal
    }

    return incremented(v : Int) {
        guard: step = "respond" & v = result
    }
}

proc GetRpc {
    var step : String
    var result : Int

    constructor goGet() {
        transit:
            step := "call"
            result := -1
    }

    client transition getCounter(counterVal : Int) {
        guard: step = "call"
        transit:
            step := "respond"
            result := counterVal
    }

    return got(v : Int) {
        guard: step = "respond" & v = result
    }
}

proc AddRpc {
    const deltaVal : Int
    var step : String
    var result : Int

    constructor goAdd(delta : Int) {
        transit:
            deltaVal := delta
            step := "call"
            result := -1
    }

    client transition add(delta : Int, newVal : Int) {
        guard:
            & step = "call"
            & delta = deltaVal
        transit:
            step := "respond"
            result := newVal
    }

    return added(v : Int) {
        guard: step = "respond" & v = result
    }
}
