p-class FrontEnd {
    var state : String
    var keyReq : String
    var valReq : String

    constructor initially() {
        transit:
            state := "A"
            keyReq := ""
            valReq := ""
    }

    transition prompt() {
        guard:
            state = "A"
        transit:
            state := "B"
    }
    
    transition readln(msg : String) {
        guard:
            state = "B"
        transit:
            keyReq := msg
            state := "C"
    }

    transition readDB(key : String, val : String) {
        guard:
            (state = "C") & (key = keyReq)
        transit:
            state := "D"
            valReq := "val: " + val // just to test string concatenation
    }

    transition println(msg : String) {
        guard:
            (state = "D") & (msg = valReq)
        transit:
            state := "A"
    }
}

p-class DB {
    constructor initially() {}

    transition readDB(key : String, val : String) {
        guard:
              (key = "A" & val = "apple")
            | (key = "B" & val = "banana")
            | (key = "C" & val = "cherry")
            | (~(key = "A" | key = "B" | key = "C") & val = "N/A")
    }
}

program main := FrontEnd || DB || Println || Readln
program na := FrontEnd || Println || Readln
